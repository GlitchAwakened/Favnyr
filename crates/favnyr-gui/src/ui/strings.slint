    in-out property <string> settings-shellext-list-label; // sub-tab: detected Windows entries
    in-out property <string> settings-shellext-list-hint;
    in-out property <string> settings-shellext-empty;      // no entry detected
    in-out property <string> ow-move-up;         // tooltips for the Open-with list buttons
    in-out property <string> ow-move-down;
    in-out property <string> ow-duplicate-tip;
    in-out property <string> ow-edit-tip;
    in-out property <string> ow-delete-tip;
    in-out property <string> settings-openers-section;
    in-out property <string> ow-add;
    in-out property <string> ow-empty;
    in-out property <string> ow-search-placeholder;
    in-out property <string> ow-no-results;
    in-out property <string> ow-promote;
    in-out property <string> ow-promote-add;
}
