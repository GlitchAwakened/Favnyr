// Favnyr's main window and multi-view management.
//
// Layout:
//   ┌──────────────────────────────────────────────────────────────────────┐
//   │ [Panel1●][Panel2 ][+]                      [lang ▾] [theme ▾]       │
//   ├──────────────────────────────────────────────────────────────────────┤
//   │ ┌─ Panel 1 (active) ───────┐ ┌─ Panel 2 ─────────────────────┐       │
//   │ │ [tabs+]   [nav][path]    │ │ [tabs+]   [nav][path]        │       │
//   │ │ [sortable columns]       │ │ [columns]                    │       │
//   │ │ [file list]              │ │ [file list]                  │       │
//   │ │ [footer: N items]        │ │ [footer: N items]            │       │
//   │ └──────────────────────────┘ └──────────────────────────────┘       │
//   └──────────────────────────────────────────────────────────────────────┘
//
// Translated labels are independent properties of the `Strings` global.
// Application controls use Theme; Palette exposes the system color scheme.
//
// Reusable components live in the sibling `.slint` files; this file holds the
// window itself.

import { HorizontalBox, Palette, VerticalBox } from "std-widgets.slint";
import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox } from "widgets.slint";
import {
    CascadeAnchor, ColumnInfo, Crumb, FavNode, FileRow, ItemGrid, ItemRect,
    MenuShortcuts, OpenerItem, OpProgress, OrphanRow, OwRecipe, PanelBox, PanelView, PropRow,
    ShellCtxEntry, ShellExtRow, ShortcutCap, ShortcutGroup, ShortcutRow, SidebarPlace,
    SplitterView, TabInfo, WorkspaceEntry
} from "types.slint";
import { Strings } from "strings.slint";
import { CtxNav, Dismiss, Flyout, KeyAdapter, Note, TextMetrics, Tip, WindowFocus } from "globals.slint";
import { Theme, Tokens } from "theme.slint";
import {
    DeferredLineEditFocus, EditLineEdit, EditTextInput, FieldLink, HintEdit, MarkBox,
    ModalBackdrop, ProgressToast, SearchField, WsButton, WsIconBtn
} from "controls.slint";
import {
    CommandIcon, FlyoutCloseTimer, FolderSwatchRow, IconMenuRow, MenuItem, ShellMenuRow,
    SplitMenuItem, SubmenuRow, TabBarMenuItem
} from "menus.slint";
import {
    OptionalToolRow, OwRecipeButton, PathRow, PropAccessRow, PropDigest, PropTab, PropValue,
    PropValueBox, SettingsRowButton, SettingsToggleRow
} from "forms.slint";
import { PanelComponent, PanelSplitterAbs } from "panel.slint";
import { ActivityRail, Sidebar, SidebarHeaderAction } from "sidebar.slint";
import { FavPanel } from "favorites.slint";
import { WorkspaceRow } from "workspaces.slint";

// Only what this file exports reaches the generated Rust API: the structs the
// bridge exchanges with the window and the globals it drives directly.
export {
    TabInfo, Crumb, WorkspaceEntry, SidebarPlace, OpenerItem, ShellCtxEntry, OrphanRow,
    ShellExtRow, FavNode, ColumnInfo, MenuShortcuts, ShortcutCap, ShortcutRow, ShortcutGroup,
    FileRow, PanelBox, ItemGrid, ItemRect, PanelView, SplitterView, OwRecipe,
    OpProgress, PropRow, CascadeAnchor,
    Strings, TextMetrics, CtxNav, KeyAdapter, Theme
}

export component MainWindow inherits Window {
    // OS title (taskbar / Alt-Tab). Default "Favnyr"; the bridge
    // replaces it with "{workspace} — Favnyr" based on the current workspace.
    in property <string> window-title: Strings.app-title;
    in property <string> interface-font-family;
    default-font-family: root.interface-font-family;
    title: root.window-title;
    // Application icon (title bar / taskbar / Alt-Tab).
    icon: @image-url("../../assets/favnyr.svg");
    // Window background = theme's channel color (otherwise the Fluent default would reappear).
    background: Theme.background;

    preferred-width: 1300px;
    preferred-height: 750px;
    min-width: 720px;
    min-height: 420px;

    // ----- Strings + selectors -----
    in property <[string]> language-labels;
    in property <[string]> theme-labels;
    // Identifiers in the same order as `theme-labels`. A selector that stores
    // its answer outside the configuration names a theme instead of pointing
    // at a row, whose position moves whenever the themes folder is scanned.
    in property <[string]> theme-ids;
    in property <[string]> theme-appearance-labels;
    in property <[string]> ui-scale-labels;      // "80%", "100%", …
    in-out property <int> language-index: 0;
    in-out property <int> theme-index: 0;
    in-out property <int> theme-appearance-index: 0;
    // True when the selection is a theme file, which is the only case where
    // there is anything to read again.
    in property <bool> theme-user-file: false;
    in property <int> theme-scheme: 0;
    in property <bool> theme-loading: false;
    in property <string> theme-status;
    // Name of the loaded workspace while it imposes a theme of its own, and
    // the name of that theme, both empty otherwise. The theme settings read
    // them to say why the choice they show is not what is on screen.
    in property <string> theme-imposed-by;
    in property <string> theme-imposed-label;
    // Theme a freshly loaded workspace imposes, empty for none. Invoked by
    // the bridge, never from the interface.
    callback apply-workspace-theme(string);
    out property <bool> system-dark: Palette.background.to-hsv().value < 0.5;
    callback system-theme-changed();
    callback refresh-themes();
    callback reload-theme();
    in property <[string]> terminal-labels;
    in-out property <int> terminal-index: 0;
    callback refresh-terminals();
    callback terminal-changed(int);
    callback refresh-theme-labels();
    callback theme-results-ready();
    callback open-themes-folder();
    in-out property <int> ui-scale-index: 0;      // index into ui-scale-labels
    callback language-changed(int);
    callback theme-changed(int);
    callback theme-appearance-changed(int);
    callback ui-scale-changed(int);               // → applies + persists the zoom
    // Optional command-line tools (Linux), checked only after expansion.
    in-out property <bool> optional-tools-expanded: false;
    in-out property <bool> optional-tools-checked: false;
    in property <bool> ffmpeg-found: false;
    in property <string> ffmpeg-version;
    in property <bool> poppler-found: false;
    in property <string> poppler-version;
    in property <bool> seven-zip-found: false;
    in property <string> seven-zip-version;
    in property <bool> optional-tools-flatpak: false;
    callback optional-tools-recheck();
    changed optional-tools-expanded => {
        if (root.optional-tools-expanded) { root.optional-tools-recheck(); }
    }
    // DEFAULT tab bar position for new views "from
    // scratch" (new workspace / reset) — global setting.
    in property <[string]> tabbar-default-labels;
    in-out property <int> tabbar-default-pref: 0;
    callback tabbar-default-changed(int);
    // Display mode used by newly created tabs and views.
    in-out property <int> default-view-mode-index: 1;
    callback default-view-mode-changed(int);
    in-out property <int> default-item-arrangement-index: 0;
    callback default-item-arrangement-changed(int);
    in-out property <bool> default-show-hidden: false;
    callback default-show-hidden-changed(bool);
    // Timezone for the "Modified" column: 0 = local time (default), 1 = UTC.
    in-out property <int> clock-utc-pref: 0;
    callback clock-mode-changed(int);
    // Full path tooltip on tab hover, enabled by default.
    in-out property <bool> tab-tooltip-enabled: true;
    callback tab-tooltip-changed(bool);
    in-out property <bool> grid-name-tooltip-enabled: true;
    callback grid-name-tooltip-changed(bool);
    in-out property <bool> search-path-tooltip-enabled: true;
    callback search-path-tooltip-changed(bool);
    in-out property <int> ws-panel-save-index: 0;
    callback ws-panel-save-changed(int);
    in property <string> ws-panel-settings-title;
    in property <string> ws-shortcut-settings-title;
    in-out property <int> ws-shortcut-save-index: 0;
    callback ws-shortcut-save-changed(int);
    // Preview mode: compact single-icon rows, enabled by default.
    in-out property <bool> compact-preview-rows-enabled: true;
    in-out property <int> default-thumbnail-zoom: 2;
    callback default-thumbnail-zoom-changed(int);
    callback zoom-label(int) -> string;
    property <string> zoom-feedback-text;
    property <length> zoom-feedback-x;
    property <length> zoom-feedback-y;
    property <bool> zoom-feedback-visible: false;
    zoom-feedback-timer := Timer {
        interval: 450ms;
        running: root.zoom-feedback-visible;
        triggered => { root.zoom-feedback-visible = false; }
    }
    callback compact-preview-rows-changed(bool);

    // Panels: flattened rendering of the layout tree.
    in property <[PanelView]> panels;
    // Per-panel footers, indexed like `panels`. PARALLEL model,
    // deliberately kept separate from `panels`: the bridge can write the selection
    // count to it on every rubber-band step without rewriting the `PanelView`s
    // (see `PanelComponent.footer-text`).
    in property <[string]> panel-footers;
    // Where each view sits, parallel to `panels` — see `PanelBox`.
    in property <[PanelBox]> panel-boxes;
    in property <[SplitterView]> splitters;
    in property <int> active-panel-idx: 0;
    // Counter bumped by Ctrl+L (`focus-address`) → each PanelComponent observes it;
    // the ACTIVE panel enters address bar edit mode.
    property <int> address-focus-gen: 0;
    in property <bool> can-add-panel: true;
    callback panel-clicked(int);
    callback panel-closed(int);
    /// Reposition a whole view: source, target, zone (center or split edge).
    callback view-dropped(int, int, int);
    /// A view released outside the window leaves for a window of its own.
    callback view-torn-off(int, length, length);
    /// The cursor has left the window while carrying a view, so releasing now
    /// would detach it into a window of its own. Both systems: detaching only
    /// needs a new instance to be started, never the cross-instance messaging
    /// that is still missing outside Windows.
    property <bool> view-drag-outside: root.view-drag-active
        && (root.view-drag-abs-x < -24px
            || root.view-drag-abs-y < -24px
            || root.view-drag-abs-x > root.width + 24px
            || root.view-drag-abs-y > root.height + 24px);
    /// A view is being carried by its grip.
    in-out property <bool> view-drag-active: false;
    in-out property <length> view-drag-abs-x;
    in-out property <length> view-drag-abs-y;
    /// The view being carried, and the one under the cursor. `-1` for none.
    in-out property <int> view-drag-source: -1;
    in-out property <int> view-drag-target: -1;
    property <int> view-drag-target-zone: 0;
    /// Escape during the drag: the pointer stays captured until release, but
    /// nothing will be swapped and every preview goes out at once.
    property <bool> view-drag-cancelled: false;
    /// The two views crossing right now, and the flag that arms their travel.
    ///
    /// The animation is armed by the EVENT, never by the property: the tiles'
    /// positions also change on every frame of a separator drag, on a split and
    /// on a close, and an unguarded `animate` would make all of those trail
    /// behind the pointer.
    property <int> swap-flight-a: -1;
    property <int> swap-flight-b: -1;
    property <bool> view-swap-flying: false;
    Timer {
        // Just past the travel, so the mark goes out once the tiles are down.
        interval: 200ms;
        running: root.view-swap-flying;
        triggered => {
            root.view-swap-flying = false;
            root.swap-flight-a = -1;
            root.swap-flight-b = -1;
        }
    }

    /// Evens out the views a separator governs: `idx` designates it, `-1`
    /// means the whole layout (the menu, which aims at no separator).
    /// Double-clicking the same separator again puts the sizes back.
    callback equalize-views(int);
    /// More than one view, so there is something to even out.
    in property <bool> equalize-available: false;
    /// A way back is being held: the menu row offers it instead.
    in property <bool> equalize-undone: false;
    /// Separator under the pointer, `-1` for none — drives the outline that
    /// shows which views a double-click would move.
    property <int> hover-splitter: -1;

    /// Guard before opening a whole selection of files at once. The body
    /// carries the count and is written by the bridge.
    in-out property <bool> open-many-open: false;
    in-out property <string> open-many-body;
    callback open-many-confirmed();

    /// Splits the active panel. `dir`: 0 = side by side (Row), 1 = stacked (Column).
    callback panel-split(int);
    /// Resize of a splitter: `idx` of the Split node, `frac` = pointer
    /// position as a fraction [0,1] of the container along the split axis.
    callback splitter-resized(int, float);
    /// Toggles content thumbnails for panel `idx`'s active tab.
    callback toggle-preview-mode(int);
    callback set-item-arrangement(int, bool);
    /// Zoom of panel `idx`'s active tab entries: `delta` = +1 / -1.
    /// The viewport and pointer position let the bridge preserve
    /// a semantic anchor despite variable row heights.
    callback zoom-view(int /*idx*/, int /*delta*/, length /*top*/, length /*width*/, length /*height*/,
        length /*pointer-x*/, length /*pointer-y*/) -> length;
    /// Current state of the Ctrl key (tracked by the root FocusScope) — used
    /// to distinguish wheel (scroll) from Ctrl+wheel (zoom).
    in-out property <bool> ctrl-down: false;
    /// Current state of the Shift key (tracked like `ctrl-down`) — rubber-band mode:
    /// Shift = add to selection, Ctrl = subtract.
    in-out property <bool> shift-down: false;
    property <int> keyboard-interaction-gen: 0;
    /// Shows / hides hidden files for panel `idx`'s active tab.
    callback toggle-show-hidden(int);
    /// Keyboard navigation of the active view's cursor. `kind`: 0=up,
    /// 1=down, 2=start, 3=end, 4=left, 5=right. `extend` extends the selection.
    callback move-cursor(int, bool);
    /// Resolves a key combination → action id (or "" if none) using the
    /// effective shortcut map (defaults + overrides). `keyname` is already
    /// normalized by `chord-key-name`.
    callback match-action(string, bool, bool, bool, bool) -> string;
    /// Emitted by the bridge when a thumbnail is ready (full path, generation, image).
    callback thumb-ready(string, int, image);
    /// Exact viewport of a panel: drives virtualization and prioritization.
    callback panel-viewport-changed(int, length, length, ItemGrid) -> length;
    callback panel-item-at-content-point(int, length, length, ItemGrid) -> int;
    pure callback grid-layout(length, int, length, length, length) -> ItemGrid;
    pure callback grid-item-rect(ItemGrid, int) -> ItemRect;
    pure callback grid-insertion-gap(ItemGrid, int, length, length, bool) -> int;
    /// Wakes the UI thread from the INITIAL FILL thread: drains
    /// the channel of delivered listings (the Rust handler captured the AppState).
    callback initial-listing-drain();
    /// Ordinary background listings delivered off-UI, with an anti-race generation.
    callback async-listing-drain();
    // Wakes the bridge to drain typed recursive folder statistics.
    callback folder-stats-drain();
    // the worker read an image's metadata (path, resolution, bits).
    callback imgmeta-ready(
        int /* panel */, int /* row */, string /* path */,
        string /* resolution */, string /* depth */, string /* mtime (unix, text) */
    );
    // "Split" menu: opened via a panel's token (which activates
    // beforehand), so it acts on the active panel via `panel-split`.
    in-out property <bool> split-menu-open: false;
    in-out property <length> split-menu-x;
    in-out property <length> split-menu-y;

    // "Tab bar position" menu: 3 radio options (top /
    // left / right), per view. `set-tab-bar-mode(panel, mode)` → bridge.
    in-out property <bool> tabbar-menu-open: false;
    property <bool> display-menu-open: false;
    property <length> display-menu-x;
    property <length> display-menu-y;
    property <int> display-menu-panel: -1;
    property <bool> sort-menu-open: false;
    property <length> sort-menu-x;
    property <length> sort-menu-y;
    property <int> sort-menu-panel: -1;
    property <int> sort-menu-page: 0; // 0: overview, 1: primary columns, 2: secondary columns
    function show-sort-options(panel: int, x: length, y: length) {
        if (panel < 0 || panel >= root.panels.length || root.panels[panel].manual-order) { return; }
        root.close-ctx-menus();
        root.panel-clicked(panel);
        root.secondary-sort-action("enable");
        root.sort-menu-panel = panel;
        root.sort-menu-x = x;
        root.sort-menu-y = y;
        root.sort-menu-page = 0;
        root.sort-menu-open = true;
    }
    function sort-column-label(code: string) -> string {
        return code == "path" ? Strings.col-path
            : code == "size" ? Strings.col-size
            : code == "modified" ? Strings.col-modified
            : code == "created" ? Strings.col-created
            : code == "age" ? Strings.col-age
            : code == "ext" ? Strings.col-ext
            : Strings.col-name;
    }
    in-out property <length> tabbar-menu-x;
    in-out property <length> tabbar-menu-y;
    in-out property <int> tabbar-menu-panel: -1;
    in-out property <int> tabbar-menu-mode: 0;     // CURRENT mode (checked option)
    callback set-tab-bar-mode(int /*panel*/, int /*mode*/);
    /// Vertical bar width resized via the grip —
    /// persisted per view on the bridge side.
    callback panel-vbar-resized(int /*panel*/, length /*width*/);

    // URL bar menu (right-click): Paste / Copy path.
    in-out property <bool> url-menu-open: false;
    /// Bumped by the menu's "Copy"; the URL field watches it and copies its
    /// own selection. A callback could not do this: the field is inside a
    /// panel, and only it knows what is highlighted.
    in-out property <int> url-copy-serial: 0;
    in-out property <int> url-paste-serial: 0;
    in-out property <length> url-menu-x;
    in-out property <length> url-menu-y;
    // EDITABLE text of the URL bar (shared: only one panel in edit mode at
    // a time). Lets the bridge paste the clipboard into it without submitting.
    in-out property <string> url-edit-text;

    // ----- Column widths: PER PANEL (carried by each PanelView).
    //       A header resize reports here with the panel's index. -----
    callback panel-column-resized(int /*panel*/, string /*id*/, length /*width*/);
    // Tab bar scroll target — geometric computation on the bridge side
    // (panel, tab_idx[-1=chevron], forward, content-x, view-w) → content-x.
    callback panel-scroll-target(int, int, bool, length, length) -> length;
    // check/uncheck a column (panel_idx, col_id, visible) + menu.
    callback column-toggle(int, string, bool);
    // Reordering: panel, column identifier, and target visible index.
    callback column-moved(int, string, int);
    // extension filter. `ext-filter-toggle(panel)` shows/hides the bar
    // (from the columns menu OR the close button). Input is shared with the
    // type-ahead (filter-type/backspace/clear routed bridge-side).
    callback ext-filter-toggle(int);
    callback manual-order-toggle(int);
    in-out property <bool> columns-menu-open: false;
    in-out property <length> columns-menu-x;
    in-out property <length> columns-menu-y;
    in-out property <int> columns-menu-panel: 0;
    // changes the grouping mode (panel_idx, code "folders"/"colored"/"files"/"mixed").
    callback set-group-mode(int, string);
    // Active view's "type-ahead" filter -----
    // Typed text (maintained by the bridge). The bar shows in the active view
    // as soon as it's non-empty. Reset on navigation / panel change / Escape.
    in property <string> active-filter: "";
    // Active panel's "extension filter" mode: when true, keyboard
    // input (filter-type/backspace/clear) feeds the extension filter instead of
    // the by-name type-ahead → shared routing on the bridge side.
    in property <bool> active-ext-filter-on: false;
    /// Is a filter bar, and therefore its field, on screen?
    property <bool> filter-bar-on: root.active-filter != "" || root.active-ext-filter-on;
    /// The bar and its field go away together, by Escape, by the cross, by an
    /// emptied field or by any navigation that resets the filter. Whichever
    /// route took it, the keyboard comes back to the list instead of staying
    /// on an element that no longer exists.
    changed filter-bar-on => {
        if (!root.filter-bar-on) { key-scope.focus(); }
    }
    /// The next bar to appear takes the keyboard. Set where the user asks for
    /// one, cleared as soon as a field has it, so a bar that merely follows a
    /// panel becoming active leaves the keyboard alone.
    in-out property <bool> filter-take-keyboard: false;
    /// Gives the keyboard back to the list. Pointing at the list is asking to
    /// act on it, and Delete or Ctrl+C must not go on meaning a filter field's
    /// text. Unconditional on purpose: it is also the way out of a keyboard
    /// left on nothing, whatever took it there. A path being edited in the
    /// address bar is dropped by the same click, which is what leaving a field
    /// by clicking elsewhere means everywhere else.
    function reclaim-list-keyboard() {
        root.filter-take-keyboard = false;
        key-scope.focus();
    }
    callback filter-type(string);       // a printable character typed
    callback filter-backspace();        // removes the last character
    callback filter-set(string);        // the whole filter, edited in its bar
    callback filter-clear();            // clears it (Escape)
    callback search-scope-toggle();
    callback action-reveal-result(bool /* new tab */);
    callback search-root-action-allowed() -> bool;
    in-out property <bool> rows-pointer-busy: false;
    out property <bool> rows-interaction-busy: root.rows-pointer-busy
        || root.popup-overlay-open || root.file-drag-active || root.drag-active
        || root.native-drag-armed || root.view-drag-active || root.op-busy;
    property <bool> active-search-recursive: root.active-panel-idx >= 0
        && root.active-panel-idx < root.panels.length && root.panels[root.active-panel-idx].search-recursive;
    // Is an overlay/popup open? (gates the filter's keyboard capture)
    // Everything that can appear ON TOP of a gesture and take the pointer with
    // it. A drag is deliberately absent from this list: it IS the gesture, not
    // something stealing it — a list that included it could never tell the two
    // apart.
    out property <bool> popup-overlay-open:
        root.prop-open || root.exit-warning-open || root.settings-open || root.workspaces-open || root.ws-dirty-warn-open || root.rename-popup-open
        || root.create-popup-open || root.ctx-menu-open
        || root.paste-conflict-open || root.columns-menu-open || root.trash-menu-open
        || root.drive-menu-open
        || root.url-menu-open || root.split-menu-open || root.tabbar-menu-open || root.display-menu-open || root.sort-menu-open
        || root.file-drop-menu-open
        || root.fav-menu-open || root.fav-name-open || root.fav-save-open
        || root.fav-newc-open || root.tab-menu-open || root.tab-empty-menu-open
        || root.ow-menu-open || root.new-menu-open || root.mark-menu-open
        || root.ow-popup-open || root.ow-picker-open || root.archive-open
        || root.delete-warning-open || root.open-many-open;
    property <bool> any-overlay-open: root.popup-overlay-open || root.file-drag-active;
    // One of those appearing in the middle of a gesture ends it, rather than
    // leaving it drawn on screen with no way to finish it.
    changed popup-overlay-open => {
        if (root.popup-overlay-open) { root.cancel-mouse-gestures(); }
    }

    /// Ends every mouse gesture in progress.
    ///
    /// A menu or a popup appearing mid-gesture takes the pointer with it: the
    /// release that would have ended the gesture never comes back, and what it
    /// was drawing — a drag pill, an insertion bar, a carried view — stays on
    /// screen following nothing. The usual way in is a right-click slipped in
    /// while the left button is still down. Only one gesture can run at a
    /// time, so ending all of them is exact, and each area holding local state
    /// follows its own flag going down.
    function cancel-mouse-gestures() {
        // A carried view is CANCELLED, not dropped: should the release still
        // arrive, it must not tear the view off.
        if (root.view-drag-active) { root.view-drag-cancelled = true; }
        root.view-drag-active = false;
        root.view-drag-source = -1;
        root.view-drag-target = -1;
        root.view-drag-target-zone = 0;
        root.drag-active = false;
        root.cancel-sidebar-item-drag();
        root.drag-target-panel = -1;
        root.drag-target-zone = 0;
        root.drag-target-gap = -1;
        root.drag-target-gap-panel = -1;
        root.drag-source-panel = -1;
        root.end-file-drag();
        root.folder-drag-cancelled();
        root.fav-drag-active = false;
        root.fav-drag-target-index = -1;
        root.fav-drag-hover-container = "";
        root.cancel-sidebar-section-drag();
    }
    // Settings: default columns (1st launch / Reset) — all of them, with their
    // default visibility. `default-column-toggle(id, visible)` updates the config.
    in property <[ColumnInfo]> settings-columns;
    callback default-column-toggle(string, bool);
    // recursive folder modification-date depth
    // (0 = disabled). Drives `Config.recursive_mtime_depth`.
    in-out property <int> rmtime-depth: 0;
    callback rmtime-depth-changed(int);
    // recursive folder SIZE depth (0 = disabled).
    // Drives `Config.recursive_size_depth`.
    in-out property <int> size-depth: 0;
    callback size-depth-changed(int);
    // Optional font-size override for every value displayed in file views.
    in-out property <bool> view-text-font-size-override: false;
    in-out property <int> view-text-font-size: 13;
    callback view-text-font-size-override-changed(bool);
    callback view-text-font-size-changed(int);
    callback view-text-font-size-reset();
    in-out property <int> view-item-spacing: 0;
    callback view-item-spacing-changed(int);
    callback view-item-spacing-reset();

    // Configurable shortcuts -----
    // Action groups (pushed by the bridge when settings open and
    // after each modification / search).
    in property <[ShortcutGroup]> shortcut-groups;
    /// Selected entry of the letter-shortcut layout list.
    in-out property <int> letter-layout-index: 0;
    callback letter-layout-changed(int);
    // EFFECTIVE shortcuts displayed in context menus, pushed by
    // the bridge (dynamic: follow user rebinds).
    in property <MenuShortcuts> menu-shortcuts;
    // True if at least one override exists (enables "Reset all").
    in property <bool> shortcut-has-overrides: false;
    // Action currently being reassigned (keyboard capture); "" = none.
    in-out property <string> shortcut-capturing: "";
    // Pending conflict: targeted action + localized message ready to display.
    // (in-out: set by the bridge, reset by the UI on close.)
    in-out property <string> shortcut-conflict-action: "";
    in-out property <string> shortcut-conflict-message: "";
    // Current search/filter text.
    in-out property <string> shortcut-search-text: "";
    callback shortcut-rebind(string /*action_id*/, string /*raw chord*/);
    callback shortcut-reset(string /*action_id*/);
    callback shortcut-unassign(string /*action_id*/);
    callback shortcut-reset-all();
    callback shortcut-resolve-conflict(bool /*reassign*/);
    callback shortcut-search(string);

    /// Index where the drop preview line appears during a tab drag.

    // ----- Per-panel callbacks (routed from the active panel) -----
    callback go-back();
    callback go-forward();
    callback go-parent();
    callback go-home();
    callback refresh();
    callback sort-clicked(string);
    callback secondary-sort-action(string);
    callback row-activated(int);
    callback row-clicked(int) -> bool;
    callback row-ctrl-clicked(int);
    callback row-shift-clicked(int);
    callback select-all();
    callback deselect-all();
    callback rubber-band-begin(int);
    callback rubber-band-update(length, length, length, length);
    callback row-right-clicked(int, length, length);
    callback tab-new();
    callback tab-clicked(int);
    callback tab-closed(int);
    // (src_panel, src_tab, target_intra, abs_x, abs_y) — src_panel passed
    // explicitly to handle a drag from a NON-active panel.
    callback tab-drag-completed(int, int, int, length, length);
    callback tab-drag-progress(int, length, length);
    /// Drop of a tab on a FAVORITES folder: (src_panel, src_tab,
    /// container id). Saves the tab's path into this folder.
    callback tab-to-favorite(int, int, string);
    /// Drop of a view's SELECTION (files/folders) on a FAVORITES
    /// folder: (src_panel, container id).
    callback file-to-favorite(int, string);
    /// Favorites container currently hovered by a drag (tab OR file),
    /// "" if none. Read PULL-BASED on release (the binding is re-evaluated on read
    /// → reflects the current position of the `*-drag-abs-*`), making it robust
    /// even when cross-instance hover lags behind. Exposed from the
    /// unconditional FavPanel.
    out property <string> fav-hover-container: fav-panel.hover-container;
    out property <bool> fav-hover-panel: fav-panel.hover-panel;   // root fallback

    /// Global tab drag state — propagated to ALL PanelComponents
    /// so each computes its own preview line.
    in-out property <bool> drag-active: false;
    in-out property <length> drag-abs-x: 0px;
    in-out property <length> drag-abs-y: 0px;
    /// Last insertion gap claimed during the drag + claiming panel
    /// . Read by the BRIDGE on cross-view drop: if `drag-target-gap-panel`
    /// == target panel, the drop in its header uses this EXACT gap; otherwise
    /// (drop in the body) the tab goes to the end of the bar. Reset at drag start.
    in-out property <int> drag-target-gap: -1;
    in-out property <int> drag-target-gap-panel: -1;
    // Index of the tab drag's SOURCE panel (for the danger preview "will
    // close" on the source whose last tab is being dragged). -1 = none.
    in-out property <int> drag-source-panel: -1;
    // Drop target — set by the panel under the cursor.
    // `panel` = index (-1 if none); `zone` = 0 none·1 center·2 W·3 E·4 N·5 S.
    in-out property <int> drag-target-panel: -1;
    in-out property <int> drag-target-zone: 0;
    // Tabs and sidebar directories share panel feedback. Exact insertion gaps
    // keep their own preview, and a tab's own center performs no move.
    property <bool> panel-layout-drop: (root.drag-active || root.sidebar-item-drag-active)
        && root.drag-target-panel >= 0
        && root.drag-target-zone >= 1 && root.drag-target-zone <= 5
        && (root.drag-target-zone != 1 || !root.drag-active
            || root.drag-target-panel != root.drag-source-panel)
        && (!root.sidebar-item-drag-active || root.directory-panel-drop-valid)
        && !(root.drag-target-gap-panel >= 0 && root.drag-target-gap >= 0)
        && !root.fav-hover-panel;

    // File drag'n'drop between views -----
    in-out property <bool> file-drag-active: false;
    in-out property <length> file-drag-abs-x: 0px;
    in-out property <length> file-drag-abs-y: 0px;
    in-out property <int> file-drag-source-panel: -1;
    in-out property <int> file-drag-target-panel: -1;   // panel under the cursor
    in-out property <int> file-drag-target-row: -1;     // hovered row (folder/executable/other)
    in-out property <bool> file-drag-target-folder: false;
    in-out property <bool> file-drag-target-exec: false;
    in-out property <bool> file-drag-target-invalid: false; // target = source/descendant
    // Valid insertion gap in a manual-order view. The companion panel index
    // tells same-view reordering apart from an inter-view file operation.
    in-out property <int> file-drag-manual-gap: -1;
    in-out property <int> file-drag-manual-panel: -1;
    // True when the dragged selection contains at least one directory that may
    // be newly added to Favorites. Regular files remain valid for file drops.
    in-out property <bool> file-drag-selection-can-favorite: false;
    in-out property <bool> file-drag-can-open: false;
    // Space switches a single-directory drag to navigation, and releasing it
    // switches back, like the Ctrl and Shift modifiers of the same gesture.
    in-out property <bool> folder-open-drag-active: false;
    // Sticky for the whole gesture: set the first time Space is pressed and
    // never cleared until the drag ends. It keeps the outgoing native drag
    // disarmed, so releasing Space over the desktop cannot turn an "open this
    // folder" gesture into a drop into another application. Private: its only
    // reader is the arming guard, which an incoming external drag never runs.
    property <bool> folder-open-drag-used: false;
    callback folder-drag-dropped(int /*panel*/, int /*gap*/, int /*zone*/);
    callback folder-drag-cancelled();
    callback file-drag-action-for-modifiers(bool /*control*/, bool /*shift*/) -> int;
    // -1 opens the action menu, 0 moves immediately, 1 copies immediately.
    in-out property <int> file-drag-action: -1;
    function update-file-drag-action() {
        if (root.file-drag-active && root.file-drag-source-panel >= 0) {
            root.file-drag-action = root.file-drag-action-for-modifiers(root.ctrl-down, root.shift-down);
        }
    }
    function end-file-drag() {
        root.folder-open-drag-active = false;
        root.folder-open-drag-used = false;
        root.file-drag-active = false;
        root.file-drag-can-open = false;
        root.file-drag-action = -1;
        root.file-drag-target-panel = -1;
        root.file-drag-target-row = -1;
        root.file-drag-target-folder = false;
        root.file-drag-target-exec = false;
        root.file-drag-target-invalid = false;
        root.file-drag-manual-gap = -1;
        root.file-drag-manual-panel = -1;
    }
    callback file-drop-target-invalid(int /*src panel*/, int /*target panel*/, int /*row*/) -> bool;
    callback manual-order-gap-noop(int /*panel*/, int /*gap*/) -> bool;
    callback manual-order-drop(int /*source panel*/, int /*target panel*/, int /*gap*/);
    function claim-file-drag-target(panel: int, row: int, folder: bool, executable: bool) {
        root.file-drag-target-panel = panel;
        root.file-drag-target-row = row;
        root.file-drag-target-folder = folder;
        root.file-drag-target-exec = executable;
        root.file-drag-target-invalid = root.file-drag-active && panel >= 0
            && root.file-drop-target-invalid(root.file-drag-source-panel, panel, row);
    }
    function refresh-file-drag-target-invalid() {
        root.file-drag-target-invalid = root.file-drag-active
            && root.file-drag-target-panel >= 0
            && root.file-drop-target-invalid(root.file-drag-source-panel,
                root.file-drag-target-panel, root.file-drag-target-row);
    }
    function clear-file-drag-target(panel: int) {
        if (root.file-drag-target-panel == panel) {
            root.file-drag-target-panel = -1;
            root.file-drag-target-row = -1;
            root.file-drag-target-folder = false;
            root.file-drag-target-exec = false;
            root.file-drag-target-invalid = false;
        }
    }
    // During a file drag: would releasing at the CURRENT position do
    // NOTHING? EXACT mirror of `file-drag-dropped`'s drop condition
    // (favorites OR folder/executable OR another panel): true
    // = unsuitable zone (scrollbars, headers, tab bar, footer, dead zone,
    // or the SOURCE folder itself). Drives the "cancel" pill that follows
    // the cursor → the indicator can never lie about what the drop will do.
    property <bool> file-drop-will-cancel:
        root.file-drag-active
        && !root.folder-open-drag-active
        && root.fav-hover-container == ""
        && !root.fav-hover-panel
        && ((root.file-drag-target-invalid && root.file-drag-manual-gap < 0)
            || !(root.file-drag-target-panel >= 0
                && (root.file-drag-target-folder
                    || root.file-drag-target-exec
                    || root.file-drag-manual-gap >= 0
                    || root.file-drag-target-panel != root.file-drag-source-panel)));
    // A watcher event that arrived during the gesture is replayed cleanly after
    // the drag/menu/operation instead of rebuilding the model under the mouse.
    in-out property <bool> file-drag-refresh-pending: false;
    // Native (OLE) drag triggered once when the cursor leaves the
    // window during a drag → external apps. Re-armed on every new drag.
    in-out property <bool> native-drag-armed: false;
    callback start-native-drag(int /*src_panel*/);
    callback file-drag-begin(int /*src_panel*/, int /*row_idx*/) -> bool; // ensures selection, returns whether it contains a directory
    // Drop menu (Move / Copy / Link here) + panels captured on drop.
    in-out property <bool> file-drop-menu-open: false;
    callback prepare-external-file-menu();
    prepare-external-file-menu => {
        root.close-ctx-menus();
        key-scope.focus();
    }
    in-out property <length> file-drop-menu-x;
    in-out property <length> file-drop-menu-y;
    in-out property <int> file-drop-src-panel: -1;
    in-out property <int> file-drop-target-panel: -1;
    in-out property <int> file-drop-target-row: -1;     // target folder row captured on drop (1 = current folder)
    callback file-drop-action(int /*0 move · 1 copy · 2 link*/);
    // Drop onto an executable → launches it with the files as arguments.
    // Returns true if launched (the bridge reads the already-set file-drop-src/target/row).
    callback file-drop-onto-exec() -> bool;
    callback refresh-all();   // re-lists ALL panels (after a multi-view op)

    callback rename-confirmed(string);
    callback rename-force-replace(string) -> bool;
    callback navigate-to(string);
    /// Emitted on right-click in a panel's empty area (useful for Paste).
    callback empty-right-clicked(length, length);
    // Bumped by the Menu key; see `PanelComponent.menu-key-serial`.
    in-out property <int> menu-key-serial: 0;
    // Row the keyboard context menu targets in the ACTIVE view, -1 for the
    // background menu.
    callback keyboard-context-row() -> int;

    // ----- Settings: open an XDG path in the OS file manager -----
    callback open-config-dir();
    callback open-data-dir();
    callback open-cache-dir();

    // True on Windows only (pushed by the bridge): gates the
    // "Open with…" entry (native picker), absent on other OSes.
    in property <bool> platform-windows: false;
    // True only on Linux: gates Linux-specific application discovery controls.
    in property <bool> platform-linux: false;

    // Open with -----
    in property <[OpenerItem]> openers-suggested;   // "Open with" submenu
    in property <[OpenerItem]> openers-all;         // Settings list
    in-out property <string> opener-search-text: "";
    callback opener-search(string);
    in property <bool> selection-is-executable;     // drives "Use as application"
    callback run-opener(string /*id*/);             // runs an opener on the selection
    callback ow-use-as-app();                       // creates an opener from the selected exe
    callback ow-add();                              // blank creation popup (Settings)
    // Ready-made archiving commands, empty when no archiver is installed.
    // Recipes are pre-split into two balanced rows on the bridge side (Slint's
    // `for` cannot carry an inline `if`), so the block wraps without sideways
    // scroll. Row 1 holds the first half (the extra chip when the count is odd).
    // Two balanced columns of full-width rows. Splitting in Rust rather than
    // in Slint, whose `for` cannot carry an inline slice.
    in property <[OwRecipe]> ow-recipes-col1: [];
    in property <[OwRecipe]> ow-recipes-col2: [];
    // Tools none of whose recipes could be resolved, already worded by the
    // bridge — empty when everything supported is installed.
    in property <string> ow-recipes-missing: "";
    // Collapsed by default: expanded, the block would push the saved commands
    // — the tab's actual content — below the fold for everyone.
    in-out property <bool> ow-recipes-open: false;
    callback ow-recipe-add(int);                    // opens the editor prefilled
    callback ow-edit(string /*id*/);                // edit popup
    callback ow-duplicate(string /*id*/);           // clones an entry
    callback ow-delete(string /*id*/);
    callback ow-move(string /*id*/, int /*dir -1/+1*/);
    callback ow-popup-changed();                    // recomputes the preview (bridge)
    callback ow-popup-commit();                     // saves OR launches (depending on the case)
    callback ow-browse();                           // opens an exe picker (native)
    // Home-grown application picker: list enumerated by the OS.
    callback ow-open-picker();                      // "Choose an application…"
    callback ow-pick(string /*key handler*/);       // choice → launches + captures
    callback ow-pick-browse();                      // browse the OS → saves + launches
    in property <[OpenerItem]> ow-picker-handlers;
    in-out property <string> ow-picker-search-text: "";
    callback ow-picker-search(string);
    in-out property <bool> ow-picker-open: false;
    callback ow-picker-show-other-apps-changed(bool);
    // Linux-only discovery of .desktop launchers without a MimeType declaration.
    in-out property <bool> ow-picker-show-other-apps: false;
    // "Set as default": the chosen app becomes Favnyr's default for the
    // file's extension (overrides the OS). Unchecked on every opening.
    in-out property <bool> ow-picker-set-default: false;
    // "Open with" submenu: flyout on hover of the entry (the parent menu
    // stays visible). Hover tracked via two properties (the entry + the flyout) for
    // a clean deferred close, without referencing conditional elements.
    // "Colour & note" flyout — same mechanism as "Open with" below, so the
    // strip is reached by hovering rather than by an extra click.
    in-out property <bool> mark-menu-open: false;
    property <CascadeAnchor> mark-menu-at;
    in-out property <bool> mark-parent-hover: false;
    in-out property <bool> mark-flyout-hover: false;
    // 0 = selection in a view, 1 = tab, 2 = favorite. The flyout and its
    // swatches are shared; only the path resolved by the bridge changes.
    in-out property <int> mark-target-kind: 0;
    function close-mark-parent() {
        root.mark-menu-open = false;
        if (root.mark-target-kind == 0) {
            root.ctx-close();
        } else if (root.mark-target-kind == 1) {
            root.tab-menu-open = false;
        } else {
            root.fav-menu-open = false;
        }
    }
    // Slot already applied to the target, so the strip can point at it.
    in-out property <int> mark-current-color: 0;
    // Does the selection contain at least ONE folder? Distinct from
    // `ctx-selection-is-dir`, which describes only the primary item: a mixed
    // selection starting with a file still has folders to colour.
    in-out property <bool> ctx-selection-has-dir: false;
    // Unlike the context-menu folder classification, this excludes shortcut
    // files: only actual directory paths can become new Favorites entries.
    in-out property <bool> ctx-selection-has-favorite-target: false;
    callback folder-color-picked(int);
    // Note editor. Single item at a time, so the entry that opens it is gated
    // on `ctx-selection-single` exactly as "Create a shortcut" is.
    in-out property <bool> comment-popup-open: false;
    in-out property <string> comment-target-name;   // shown as the caption
    in-out property <string> comment-text;          // note the editor opens on
    property <bool> comment-focus-armed: false;
    callback comment-confirmed(string);
    // Asks the bridge to fill the three properties above from the selection,
    // then open the editor — the row itself knows neither the name nor the
    // note already stored.
    callback open-comment-editor();
    changed comment-popup-open => {
        if (root.comment-popup-open) { root.comment-focus-armed = true; }
        else { key-scope.focus(); }
    }
    in-out property <bool> ow-menu-open: false;
    property <CascadeAnchor> ow-menu-at;
    in-out property <bool> ow-parent-hover: false;
    in-out property <bool> ow-flyout-hover: false;
    // "New" submenu (empty area) — SAME mechanism as "Open with"
    // above: flyout on hover, deferred close via two hover flags.
    in-out property <bool> new-menu-open: false;
    property <CascadeAnchor> new-menu-at;
    in-out property <bool> new-parent-hover: false;
    in-out property <bool> new-flyout-hover: false;
    in-out property <bool> folder-menu-open: false;
    in-out property <bool> folder-menu-reveal: false;
    property <CascadeAnchor> folder-menu-at;
    in-out property <bool> folder-pane-parent-hover: false;
    in-out property <bool> folder-reveal-parent-hover: false;
    in-out property <bool> folder-flyout-hover: false;
    // "Custom command" popup (create/edit/one-shot launch).
    in-out property <bool> ow-popup-open: false;
    in-out property <bool> ow-popup-archive-dialog: false;
    in-out property <bool> archive-open: false;
    in-out property <bool> archive-password-only: false;
    in-out property <bool> archive-use-password: false;
    in-out property <bool> archive-work-pending: false;
    property <bool> archive-focus-armed: false;
    in-out property <string> archive-subject;
    in-out property <string> archive-name;
    in-out property <int> archive-format: 0;
    in-out property <int> archive-tar-compression: 0;
    in-out property <int> archive-level: 3;
    in-out property <string> archive-password;
    in-out property <string> archive-confirm-password;
    in-out property <string> archive-error;
    callback archive-submit();
    callback archive-cancel();
    callback archive-poll();
    changed archive-use-password => {
        root.archive-error = "";
        if (!root.archive-use-password) {
            root.archive-password = "";
            root.archive-confirm-password = "";
        }
    }
    changed archive-format => {
        root.archive-error = "";
        if (root.archive-format == 2) { root.archive-use-password = false; }
        else { root.archive-tar-compression = 0; }
    }
    changed archive-open => {
        if (root.archive-open) { root.archive-focus-armed = true; }
        else { key-scope.focus(); }
    }
    Timer {
        interval: 120ms;
        running: root.archive-work-pending;
        triggered => { root.archive-poll(); }
    }
    in-out property <bool> ow-popup-focus-armed: false;
    in-out property <string> ow-popup-id: "";       // "" = creation
    in-out property <string> ow-popup-name: "";
    in-out property <string> ow-popup-program: "";
    // Persisted visual family inherited from a ready-made recipe.
    in-out property <int> ow-popup-icon-kind: 0;
    // Opener based on an OS association (Windows Store/UWP app, Linux .desktop):
    // no executable → the Program field is frozen + explicit label.
    in-out property <bool> ow-popup-is-store: false;
    in-out property <string> ow-popup-args: "";
    // Run as administrator (UAC elevation) — Windows only, unchecked by
    // default. The checkbox is only shown if `platform-windows`.
    in-out property <bool> ow-popup-elevated: false;
    // Pinning to the context menu: 3 checkboxes → file/folder/background bits.
    in-out property <bool> ow-popup-ctx-file: false;
    // Extensions the FILE entry is limited to; "*" means every file. Only
    // meaningful with the Files box — folders and the background have none.
    in-out property <string> ow-popup-ctx-ext: "";
    in-out property <bool> ow-popup-ctx-dir: false;
    in-out property <bool> ow-popup-ctx-bg: false;
    in-out property <string> ow-popup-default-ext: "";
    in-out property <string> ow-popup-used-ext: "";   // extensions listed in "Open with"
    in-out property <bool> ow-popup-add: true;       // "Add to applications"
    in property <string> ow-popup-preview: "";       // resolved preview (set by the bridge)
    // How many processes the command will start, already worded by the bridge.
    in property <string> ow-popup-runs: "";
    in property <bool> ow-popup-valid: false;        // valid program (set by the bridge)
    // Promotion toast after the native dialog (Windows).
    in-out property <bool> ow-promote-visible: false;
    callback ow-promote-accept();

    // ----- Global operations (target the active panel) -----
    callback action-open();
    callback action-open-new-tab();
    callback action-open-new-pane(int /*0 side by side, 1 stacked*/);
    callback action-open-admin();   // "Open as administrator" (file, Windows)
    // Context menu target = a SINGLE file (not a folder) → on Windows,
    // "Open as administrator" replaces "Open in a new tab".
    in-out property <bool> ctx-selection-is-file: false;
    // A single item is selected (file OR folder) — gates "Create a shortcut".
    in-out property <bool> ctx-selection-single: false;
    // The primary selected item is a folder — hides "Open with" (files only).
    in-out property <bool> ctx-selection-is-dir: false;
    // The selection holds an item already in a trash: deleting it is permanent,
    // and the delete entry says so.
    in-out property <bool> ctx-selection-in-trash: false;
    callback action-open-with();
    callback action-open-parent();
    callback action-open-terminal();
    callback action-copy();
    callback action-cut();
    callback action-paste();
    callback action-duplicate();
    callback action-copy-path();
    callback action-copy-name();
    callback action-rename();
    callback action-delete();
    callback action-delete-permanent();
    callback action-restore-last-trashed();
    // Internal deliveries from the trash workers, drained on the UI thread.
    callback process-op-events();
    callback action-properties();
    callback ctx-close();

    // ----- Menu/properties state (global) -----
    in-out property <bool> ctx-menu-open: false;
    in-out property <length> ctx-menu-x;
    in-out property <length> ctx-menu-y;
    /// Closes the open submenu and puts the keyboard back on the row that
    /// opened it. Which one is open does not matter: closing all of them is
    /// exact, since only one can be.
    function leave-submenu() {
        root.ow-menu-open = false;
        root.folder-menu-open = false;
        root.mark-menu-open = false;
        root.new-menu-open = false;
        root.ctx-shell-sub-open = false;
        CtxNav.leave-submenu();
    }

    // Closes ALL context menus at once. A SINGLE shared mechanism:
    // no more per-menu backdrop. DIRECT function (not via a
    // `changed`) → deterministic order when a trigger closes-then-reopens (=
    // teleporting the menu under the cursor on a right-click in a valid zone).
    function close-ctx-menus() {
        CtxNav.disarm();
        root.ctx-menu-open = false;      // the "Open with" flyout follows via `changed`
        root.url-menu-open = false;
        root.drive-menu-open = false;
        root.trash-menu-open = false;
        root.columns-menu-open = false;
        root.tab-menu-open = false;
        root.tab-empty-menu-open = false;
        root.fav-menu-open = false;
        root.split-menu-open = false;
        root.tabbar-menu-open = false;
        root.display-menu-open = false;
        root.sort-menu-open = false;
        root.file-drop-menu-open = false;
        root.shortcut-menu-open = false;
    }
    // Single route for the sidebar's right-clicks. The four reorderable
    // components and the Trash call it without duplicating menu
    // initialization or risking different behavior based on their rank.
    function open-sidebar-place-context(path: string, kind: int, removable: bool,
            hotplug: bool, device: string, x: length, y: length) {
        root.close-ctx-menus();
        if (kind == 3) {
            root.trash-menu-x = x;
            root.trash-menu-y = y;
            root.trash-menu-confirm = false;
            root.trash-menu-open = true;
        } else if (kind == 2 || kind == 4) {
            root.drive-menu-x = x;
            root.drive-menu-y = y;
            root.drive-menu-path = path;
            root.drive-menu-kind = kind;
            root.drive-menu-removable = removable;
            root.drive-menu-hotplug = hotplug;
            root.drive-menu-device = device;
            root.drive-menu-open = true;
        }
    }
    // Observes the "chrome" interaction counter (global Dismiss, bumped on a
    // LEFT click on rail/sidebar/headers/tabs/margins…) → closes menus (which
    // no longer have a backdrop). A RIGHT click on a valid zone does not bump and
    // reaches the trigger → reopens/teleports the menu.
    property <int> dismiss-watch: Dismiss.serial;
    changed dismiss-watch => { root.close-ctx-menus(); }
    // true = right-click on a blank area (no targeted entry) → menu
    // reduced to only the actions that make sense without a selection (Paste…).
    in-out property <bool> ctx-on-empty: false;
    in property <bool> ctx-can-reveal-result: false;
    // Eager conditional instantiation keeps hidden menu rows alive. Only the
    // currently visible branch and submenu may answer keyboard navigation.
    property <int> ctx-full-nav-level:
        root.ctx-menu-open && !root.ctx-on-empty ? 1 : 0;
    property <int> ctx-empty-nav-level:
        root.ctx-menu-open && root.ctx-on-empty ? 1 : 0;
    property <int> ctx-mark-nav-level:
        root.ctx-menu-open && root.mark-menu-open ? 2 : 0;
    property <int> ctx-ow-nav-level:
        root.ctx-menu-open && root.ow-menu-open ? 2 : 0;
    property <int> ctx-folder-nav-level:
        root.ctx-menu-open && root.folder-menu-open ? 2 : 0;
    property <int> ctx-new-nav-level:
        root.ctx-menu-open && root.new-menu-open ? 2 : 0;
    property <int> ctx-shell-nav-level:
        root.ctx-menu-open && root.ctx-shell-sub-open ? 2 : 0;
    // User commands PINNED to the context menu — pushed by the
    // bridge on EVERY opening (filtered by file/folder/background context).
    in property <[OpenerItem]> ctx-custom-entries;
    in-out property <bool> ctx-custom-bg: false;  // true = background menu (target = current folder)
    callback ctx-custom-run(string /*id*/);
    // Entries of the WINDOWS CONTEXT MENU (hosted shell extensions) —
    // pushed by the bridge on every opening (live IContextMenu session).
    in property <[ShellCtxEntry]> ctx-shell-entries;
    callback ctx-shell-run(int /*command offset*/);
    // Shell CASCADE flyout (e.g. an archiver's submenu), same mechanism as the "Open
    // with" flyout: hover of the parent → the bridge pushes the children
    // (`ctx-shell-sub-hover`), deferred close Timer on both hovers.
    in property <[ShellCtxEntry]> ctx-shell-sub-entries;
    in-out property <bool> ctx-shell-sub-open: false;
    property <CascadeAnchor> ctx-shell-sub-at;
    in-out property <int> ctx-shell-sub-for: -1;   // `sub` index of the open parent
    in-out property <bool> ctx-shell-sub-parent-hover: false;
    in-out property <bool> ctx-shell-sub-flyout-hover: false;
    callback ctx-shell-sub-hover(int /*sub*/);
    // Setting: integrate the Windows menu (kill-switch if the extension is slow/broken).
    in-out property <bool> shell-menu-enabled: true;
    callback shell-menu-changed(bool);
    // "Detected Windows entries" settings panel: list built at
    // launch (completed as used), checkboxes → hide/show the entry.
    in property <[ShellExtRow]> shell-ext-rows;
    callback shell-ext-toggle(string /*label*/, bool /*enabled*/);


    // ----- Rename modal popup -----
    in-out property <bool> rename-popup-open: false;
    in property <string> rename-current-name;
    // Folders keep the caret at the end; for a file, the bridge places
    // the caret right before the extension via `fs::ops::split_name`.
    in property <bool> rename-current-is-dir: false;
    in-out property <string> rename-new-name;
    // Name conflict (same logic as paste): `rename-check` is called on
    // every keystroke; the bridge sets `rename-conflict` if the name is already
    // taken at the same level (or invalid). Blocks confirmation.
    in-out property <bool> rename-conflict: false;
    // Already-translated reason the name is refused ("" when it is fine).
    // Filled by the bridge, which alone knows whether the name is taken or
    // simply unusable on this filesystem.
    in-out property <string> rename-name-error: "";
    // Replaceable conflict, file↔file only. Distinguishes a real duplicate
    // from an invalid name or a conflict involving a folder.
    in-out property <bool> rename-replace-available: false;
    callback rename-check(string);
    // Deferred focus of the field (armed on opening, consumed by a Timer in the
    // popup block — a direct focus() can freeze / loop depending on the context).
    property <bool> rename-focus-armed: false;
    changed rename-popup-open => {
        if (root.rename-popup-open) { root.rename-focus-armed = true; }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }

    // ----- New folder / file / shortcut popup (empty area) -----
    in-out property <bool> create-popup-open: false;
    // Type of entry to create: 0 = folder, 1 = file, 2 = shortcut.
    in-out property <int> create-kind: 0;
    in-out property <string> create-name;
    // New folder/file: live validation shared with Rename.
    // Shortcuts/links keep their own specific rules.
    in-out property <bool> create-name-valid: false;
    in-out property <bool> create-conflict: false;
    // Already-translated reason the name is refused ("" when it is fine), see
    // `rename-name-error`.
    in-out property <string> create-name-error: "";
    // Target of a shortcut (mode 2): pointed-to path, typed or chosen via Browse.
    in-out property <string> create-target;
    // Shortcut popup tab: true = target a FOLDER, false = a
    // FILE. Only drives the "Browse…" picker's type (creating
    // the .lnk is identical). Default: folder.
    in-out property <bool> create-shortcut-folder: true;
    // "Create a shortcut" popup tab (kind 3): true = symlink,
    // false = .lnk shortcut (Windows). Target = selected file (create-target).
    in-out property <bool> create-link-symlink: false;
    property <bool> create-focus-armed: false;
    property <bool> create-can-confirm:
        (root.create-kind == 0 || root.create-kind == 1)
            ? (root.create-name-valid && !root.create-conflict)
            : ((root.create-kind == 2 && root.create-target != "")
                || (root.create-kind == 3 && root.create-name != ""));
    callback create-check(int /*kind*/, string /*name*/);
    callback create-confirmed(int /*kind*/, string /*name*/, string /*target*/) -> bool;
    callback create-browse-target();           // native picker → fills create-target
    callback action-create-link();             // file context menu → kind 3 popup
    changed create-name => { root.create-check(root.create-kind, root.create-name); }
    changed create-kind => { root.create-check(root.create-kind, root.create-name); }
    changed create-popup-open => {
        if (root.create-popup-open) {
            root.create-check(root.create-kind, root.create-name);
            root.create-focus-armed = true;
        }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }

    // Permanent-deletion warning, shared between a network volume
    // without a trash and the explicit Shift+Delete shortcut.
    in-out property <bool> delete-warning-open: false;
    in-out property <bool> exit-warning-open: false;
    in-out property <bool> exit-confirm: false;
    in-out property <bool> exit-stopping: false;
    property <int> exit-choice: 0;
    callback request-close();
    callback exit-stay();
    callback exit-cancel-operations();
    changed exit-warning-open => {
        root.exit-choice = 0;
        Tip.text = "";
        key-scope.focus();
        if (!root.exit-warning-open) {
            if (root.paste-conflict-open) { root.paste-conflict-focus-armed = true; }
            else if (root.archive-open) { root.archive-focus-armed = true; }
            else if (root.rename-popup-open) { root.rename-focus-armed = true; }
            else if (root.create-popup-open) { root.create-focus-armed = true; }
        }
    }
    changed exit-confirm => { root.exit-choice = 0; }
    // true = explicit permanent deletion; false = standard network
    // deletion (the `trash` primitive will itself fall back to permanent).
    in-out property <bool> delete-warning-permanent: false;
    // Every item to delete already sits in a trash: the body says they leave it.
    in-out property <bool> delete-warning-from-trash: false;
    callback delete-warning-confirmed();

    // Paste conflict popup -----
    in-out property <bool> paste-conflict-open: false;
    // Bumped by the bridge for EACH conflict, including when the popup stays
    // open between two items. This makes focus reliable across the whole series.
    in-out property <int> paste-conflict-focus-gen: 0;
    property <bool> paste-conflict-focus-armed: false;
    changed paste-conflict-open => {
        if (root.paste-conflict-open) { root.paste-conflict-focus-armed = true; }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }
    changed paste-conflict-focus-gen => {
        if (root.paste-conflict-open) { root.paste-conflict-focus-armed = true; }
    }
    // Original name in conflict (shown in the message).
    in property <string> paste-conflict-original;
    // Type of the source, to never interpret a folder name's dot
    // as an extension when positioning the caret.
    in property <bool> paste-conflict-is-dir: false;
    // Name proposed / edited by the user.
    in-out property <string> paste-conflict-name;
    // True if the entered name is already taken (or invalid) — disables "Paste".
    in property <bool> paste-conflict-name-taken: false;
    // True when the conflict is a COPY WITHIN THE SAME FOLDER: overwriting
    // would amount to destroying the source, skipping amounts to canceling → we show
    // ONLY "Cancel" / "Paste" (with the renamed name). Set by the bridge.
    in property <bool> paste-conflict-rename-only: false;
    /// Live validation on every keystroke (the bridge updates name-taken).
    callback paste-conflict-check(string);
    /// Pastes with the entered name (resolves this conflict, moves to the next).
    callback paste-conflict-confirm(string);
    /// Skips this item — the others continue.
    callback paste-conflict-skip();
    /// Overwrites the existing target for THIS item, then moves to the next.
    callback paste-conflict-replace();
    /// Overwrites THIS item and all remaining conflicts, then runs.
    callback paste-conflict-replace-all();
    /// Skips THIS item and all remaining conflicts, then runs.
    callback paste-conflict-skip-all();
    /// Cancels the whole paste operation.
    callback paste-conflict-cancel();

    // Long operations in progress, one row per operation and one
    // non-blocking floating toast each. Driven by the bridge (background threads).
    // A row only appears once its operation passes the deferred-appearance
    // threshold, so a quick copy never flashes a toast.
    in property <[OpProgress]> ops: [];
    // "+N others" summary shown when more operations run than the stack displays.
    in property <string> ops-more-text;
    /// `true` while at least one operation is in flight — including those with no
    /// toast yet. Gates the deferred refreshes, which must not re-list mid-operation.
    in property <bool> op-busy: false;
    /// Emitted by the bridge (from a worker thread) to create or refresh one
    /// operation's row.
    callback op-progress(OpProgress);
    callback op-cancel(int);
    /// Emitted by the bridge at the end of an operation (releases it on the Rust side).
    callback op-finished(int);
    /// Closes one operation's toast, by hand or after its auto-dismiss delay.
    callback op-dismiss(int);

    // ----- Settings -----
    in-out property <bool> settings-open: false;

    // ----- Properties panel -----
    /// Open state of the internal properties panel.
    in-out property <bool> prop-open: false;
    /// Selected tab: 0 general, 1 permissions, 2 checksums.
    in-out property <int> prop-tab: 0;
    /// Full path of the item being described, so a change knows its target.
    in-out property <string> prop-path;
    /// Name of the item being described, shown beside its icon.
    in-out property <string> prop-name;
    /// Icon of the item, already resolved by the bridge.
    in-out property <image> prop-icon;
    /// Rows of the general tab, in display order.
    in-out property <[PropRow]> prop-general-rows;
    /// Whether the permissions tab applies at all. False on a platform with
    /// no such notion, which hides the tab rather than showing an empty one.
    in-out property <bool> prop-has-permissions: false;
    callback prop-closed();
    /// Permission of each class, as an index into the matching label list.
    in-out property <int> prop-access-owner;
    in-out property <int> prop-access-group;
    in-out property <int> prop-access-others;
    /// One label list per class. A class whose bits express something the
    /// three usual choices cannot say carries a fourth entry describing it,
    /// so an unusual mode is shown rather than rounded to a neighbour.
    in-out property <[string]> prop-access-labels-owner;
    in-out property <[string]> prop-access-labels-group;
    in-out property <[string]> prop-access-labels-others;
    in-out property <bool> prop-executable: false;
    /// Owner and group, resolved only when this tab is built.
    in-out property <string> prop-owner;
    in-out property <string> prop-group;
    /// The permission bits in octal, for anyone who reads them that way.
    in-out property <string> prop-mode;
    /// (class, chosen index), the class being 0 owner, 1 group, 2 others.
    callback prop-access-changed(int, int);
    callback prop-executable-changed(bool);
    /// Computed digests, one row per algorithm, empty until asked for.
    in-out property <[PropRow]> prop-digest-rows;
    /// True while a file is being read, which is also when Cancel replaces
    /// Compute.
    in-out property <bool> prop-hashing: false;
    /// How far the read has got, 0 to 1.
    in-out property <float> prop-hash-progress: 0;
    /// Whether digests can be asked for at all: a directory has none.
    in-out property <bool> prop-can-hash: false;
    /// What the reader typed to compare, and the verdict on it.
    in-out property <string> prop-expected;
    /// -1 nothing typed, 0 no match, 1 matched.
    in-out property <int> prop-expected-verdict: -1;
    /// Which algorithm matched, when one did.
    in-out property <string> prop-expected-match;
    callback prop-hash-start();
    callback prop-hash-cancel();
    callback prop-expected-changed(string);
    // Annotations pointing at an item that is gone. Counted when the panel
    // opens, never swept on its own — see the hint beside the button.
    in-out property <int> annotation-orphans: 0;
    callback count-annotation-orphans();
    /// Opens the cleanup list. The sweeping itself waits for an answer.
    callback clean-annotations();
    /// The cleanup list, and what is ticked in it.
    ///
    /// Ticks are NOT held here: the bridge owns the set of keys, and this model
    /// only mirrors it. That is what lets "Select all" cover every orphan
    /// rather than only the rows currently built.
    in-out property <bool> orphans-open: false;
    in property <[OrphanRow]> orphan-rows;
    /// Label of the confirming button, count already interpolated by the
    /// bridge — where the number sits in the sentence differs by language.
    in property <string> orphans-confirm-label;
    in property <int> orphans-checked: 0;
    callback orphan-toggled(string, bool);
    callback orphans-select-all(bool);
    callback orphans-confirmed();
    // App version (CARGO_PKG_VERSION), set by the bridge.
    in property <string> app-version: "0.0.0";
    // Active tab of the Settings panel: 0 = General, 1 = Shortcuts (key
    // management has its own page so it no longer weighs down "General").
    in-out property <int> settings-tab: 0;
    // Sub-tab of the "Open with" tab: 0 = Favnyr commands,
    // 1 = detected Windows entries (shell extensions).
    in-out property <int> ow-subtab: 0;
    // LAZY probe of the shell menu: triggered when the
    // sub-tab opens — nothing at startup (see `scan_shell_ext`).
    callback shell-ext-scan();
    changed ow-subtab => {
        if (self.ow-subtab == 1) { root.shell-ext-scan(); }
    }
    in property <string> config-dir-path;
    in property <string> data-dir-path;
    in property <string> cache-dir-path;
    // True when the config folder == the data folder (Windows case:
    // `config.toml` lives in the Data dir) → the "Configuration file" row
    // would be redundant and is hidden. On Linux the two differ.
    in property <bool> config-path-redundant: false;

    // Named workspaces (overlay) -----
    in-out property <bool> workspaces-open: false;
    // On menu OPENING, recomputes the list and flags from the
    // live state (including "unsaved changes") — regardless of how the menu was
    // opened (button, shortcut…).
    changed workspaces-open => {
        // The pickers belong to a row of this panel and cannot outlive it.
        root.ws-slot-picker-open = false;
        root.ws-theme-picker-open = false;
        if (self.workspaces-open) { root.ws-refresh(); }
        // The "save as workspace" sub-input grabs focus; on close return it to
        // the keyboard scope so Escape / shortcuts keep working (grouped note below).
        else { key-scope.focus(); }
    }
    in property <[WorkspaceEntry]> workspaces;
    /// Per keyboard slot, 1 to 9 at indices 0 to 8. `ws-slot-taken` names the
    /// workspace holding it, as a finished sentence, and is empty when the slot
    /// is free; `ws-slot-tips` names the combination that fires it.
    in property <[string]> ws-slot-taken;
    in property <[string]> ws-slot-tips;
    /// Slot picker, anchored under the badge of the row that opened it.
    in-out property <bool> ws-slot-picker-open: false;
    in-out property <string> ws-slot-picker-id;
    in-out property <int> ws-slot-picker-current: 0;
    in-out property <length> ws-slot-picker-x;
    in-out property <length> ws-slot-picker-y;
    /// Hands `slot` to the workspace `id`, or takes its slot away with zero.
    callback ws-set-slot(string, int);
    /// Theme picker, anchored under the swatch of the row that opened it.
    /// `current` is the stored identifier of the theme that row imposes, so
    /// the applied entry is ticked whatever the order of the list.
    in-out property <bool> ws-theme-picker-open: false;
    in-out property <string> ws-theme-picker-id;
    in-out property <string> ws-theme-picker-current;
    in-out property <length> ws-theme-picker-x;
    in-out property <length> ws-theme-picker-y;
    /// Imposes the theme `theme-id` on the workspace `id`, or hands it back to
    /// the global theme with an empty identifier.
    callback ws-set-theme(string, string);
    in-out property <string> ws-toast: "";   // feedback message (cleared by a Timer)
    // GLOBAL "notice" toast (e.g. "Access denied" on an unreadable folder) — set
    // by the bridge, auto-cleared by a Timer. Independent of overlays.
    in-out property <string> notice-text: "";
    // Toast tone: 0 = danger (red), 1 = success (green),
    // 2 = info (accent). Drives background + border + icon tint. Set by the bridge.
    in-out property <int> notice-tone: 0;
    // Toast icon: 0 = closed lock (access/error), 1 = open
    // lock (eject OK), 2 = checkmark (generic success), 3 = bookmark (favorites).
    in-out property <int> notice-icon: 0;
    // Toast display duration, set by the bridge based on message LENGTH
    // (adaptive reading time) — a long message (e.g. "service X is using the
    // device") stays displayed longer.
    in-out property <duration> notice-duration: 2800ms;
    // List sort direction: true = most recent first (default).
    in-out property <bool> ws-sort-newest-first: true;
    callback ws-save-new(string);       // saves the current state under this name
    callback ws-save-current();         // quick save of the current named workspace
    // Loads the workspace holding the slot named by a `load-workspace-N`
    // action id. Saves the current one on the way, without asking.
    callback ws-load-slot-action(string);
    in-out property <bool> ws-name-taken: false;
    callback ws-name-check(string);     // live validation: name already used?
    // Deferred focus of the "workspace name" field — armed ONLY when the
    // panel opens because the user asked to SAVE a
    // still-unnamed workspace (Ctrl+S on an ad hoc state): the cursor is then in the
    // field, indicating a name must be entered. Normal opening (rail
    // button, Ctrl+Q) → not armed: the list is browsed, nothing gets named.
    in-out property <bool> ws-name-focus-armed: false;
    callback ws-overwrite(string);      // replaces workspace `id` with the current state
    callback ws-delete(string);         // deletes workspace `id`
    callback ws-rename(string, string); // (id, new-name)
    callback ws-reset-guarded();        // "Start a new workspace" WITH the guard
    // "Unsaved changes" guard. The Load button goes
    // through `ws-load-guarded`: the bridge loads directly if the current state is clean,
    // otherwise it FILLS the dialog below (interpolated texts + target id) and
    // opens it. `ws-save-and-load` saves the current state THEN loads the target.
    callback ws-load-guarded(string /*target_id*/);
    callback ws-save-and-load();        // saves the current state THEN runs the pending action
    callback ws-discard-and-load();
    // Recomputes the list + the is-current/is-dirty flags from the LIVE state.
    // Called on EVERY menu opening (see `changed workspaces-open`): the
    // "unsaved changes" check happens when the menu opens, not
    // only after a save.
    callback ws-refresh();
    in-out property <bool> ws-dirty-warn-open: false;
    in-out property <bool> ws-dirty-shortcut: false;
    in-out property <bool> ws-dirty-remember: false;
    in-out property <string> ws-dirty-title-text;   // interpolated by the bridge
    in-out property <string> ws-dirty-body-text;    // interpolated by the bridge
    in-out property <string> ws-dirty-target-id;    // workspace to load after the decision
    // Nature of the pending action behind the dialog: false = load
    // `ws-dirty-target-id`, true = start over blank ("Start a new workspace").
    in-out property <bool> ws-dirty-reset: false;
    callback ws-toggle-sort();          // reverses the list's sort direction

    // "Places" sidebar -----
    // Stable semantic models. The order of the four movable sections
    // is a small model of codes: 0 Drives · 1 Shortcuts · 2 Favorites ·
    // 3 Network. Trash stays fixed below them.
    in property <[SidebarPlace]> sidebar-places-drives;
    in property <[SidebarPlace]> sidebar-places-shortcuts;
    in property <[SidebarPlace]> sidebar-places-network;
    in property <[SidebarPlace]> sidebar-places-trash;
    in property <[int]> sidebar-section-order;
    in-out property <bool> sidebar-section-drag-active: false;
    in-out property <int> sidebar-section-drag-source: -1;
    in-out property <int> sidebar-section-drag-target: -1;
    in-out property <length> sidebar-section-drag-preview-y: 0px;
    in-out property <length> sidebar-section-drag-last-x: 0px;
    in-out property <length> sidebar-section-drag-last-y: 0px;
    callback sidebar-section-reordered(int /*section*/, int /*final index*/);
    changed sidebar-section-order => { root.cancel-sidebar-section-drag(); }
    // Open left panel: 0 collapsed · 1 Places · 2 Favorites.
    in-out property <int> left-panel: 1;
    in-out property <length> sidebar-width: 210px;
    callback sidebar-place-clicked(string, int);   // (path, kind)
    callback place-open-new-tab(string, int);      // (path, kind) → new tab (active view)
    // A navigable location dropped on a tab gap or onto a panel. Favorite ids
    // use kind -1; the bridge resolves their stored path before acting.
    callback sidebar-item-dropped(string, int, int, int, int);
    in-out property <bool> sidebar-item-drag-active: false;
    property <bool> directory-panel-drop-valid:
        (root.folder-open-drag-active || root.sidebar-item-drag-active)
        && root.drag-target-panel >= 0
        && root.drag-target-zone > 0
        && (root.drag-target-zone == 1 || root.can-add-panel);
    // Mirrors every successful release: exact tab gap, panel center/edge, or
    // an internal favorite reorder. The no-drop pill therefore cannot conflict
    // with an insertion line or split preview.
    property <bool> sidebar-item-drop-will-cancel:
        root.sidebar-item-drag-active
        && !(root.drag-target-gap-panel >= 0 && root.drag-target-gap >= 0)
        && !root.directory-panel-drop-valid
        && !(root.fav-drag-active && fav-panel.reorder-hover-panel);
    // Containers and unavailable favorite locations only support tree
    // reordering. Once outside that tree, releasing cannot perform an action.
    property <bool> favorite-reorder-drop-will-cancel:
        root.fav-drag-active
        && !root.sidebar-item-drag-active
        && !fav-panel.reorder-hover-panel;
    /// Starts dragging a navigable sidebar location. Every source reaching
    /// this designates a directory, so a view destination is always eligible.
    function begin-sidebar-item-drag(abs-x: length, abs-y: length) {
        root.drag-abs-x = abs-x;
        root.drag-abs-y = abs-y;
        root.drag-source-panel = -1;
        root.drag-target-panel = -1;
        root.drag-target-zone = 0;
        root.drag-target-gap = -1;
        root.drag-target-gap-panel = -1;
        root.sidebar-item-drag-active = true;
    }
    function update-sidebar-item-drag(abs-x: length, abs-y: length) {
        if (!root.sidebar-item-drag-active) { return; }
        root.drag-abs-x = abs-x;
        root.drag-abs-y = abs-y;
    }
    function cancel-sidebar-item-drag() {
        root.sidebar-item-drag-active = false;
        root.drag-target-panel = -1;
        root.drag-target-zone = 0;
        root.drag-target-gap = -1;
        root.drag-target-gap-panel = -1;
        root.drag-source-panel = -1;
    }
    function finish-sidebar-item-drag(
        source: string, kind: int, abs-x: length, abs-y: length
    ) -> bool {
        if (!root.sidebar-item-drag-active) { return false; }
        root.update-sidebar-item-drag(abs-x, abs-y);
        let gap-panel: int = root.drag-target-gap-panel;
        let gap: int = root.drag-target-gap;
        let gap-accepted: bool = gap-panel >= 0 && gap >= 0;
        let panel-accepted: bool = !gap-accepted && root.directory-panel-drop-valid;
        let panel: int = gap-accepted ? gap-panel : root.drag-target-panel;
        let drop-gap: int = gap-accepted ? gap : -1;
        let drop-zone: int = panel-accepted ? root.drag-target-zone : 0;
        let accepted: bool = gap-accepted || panel-accepted;
        root.cancel-sidebar-item-drag();
        if (accepted) {
            root.sidebar-item-dropped(source, kind, panel, drop-gap, drop-zone);
        }
        return accepted;
    }
    callback sidebar-refresh();                     // re-scans places
    callback recovery-activated();
    callback recovery-drain();
    callback poll-drives();                          // lightweight drive check: rebuilds only if changed
    callback poll-annotations();                     // shared colours and notes, independent of sidebar visibility
    // Cross-instance IPC init: `true` = initialized (the Timer stops),
    // `false` = window not ready yet → the Timer retries.
    callback init-ipc() -> bool;
    // Scroll of a panel's tab bar (content-x ≤ 0, plain) —
    // reported to the bridge for cross-instance insertion hit-testing.
    callback panel-tabs-scrolled(int, length);
    // PLAIN geometry of the panels container: read LAZILY by
    // the bridge (Rust getter, at the time of a cross-instance drop) → hit-test
    // of the target panel/gap. absolute-position read at the container level —
    // same family as `tabs-row-x` (proven pattern, no layout cycle).
    out property <length> panels-cont-x: panels-container.absolute-position.x;
    out property <length> panels-cont-y: panels-container.absolute-position.y;
    out property <length> panels-cont-w: panels-container.width;
    out property <length> panels-cont-h: panels-container.height;
    // "Unavailable" tabs (network/missing folder): `any-unavailable`
    // (set by the bridge) → a Timer calls `recheck-unavailable` to retry
    // as soon as a drive/mount changes.
    in-out property <bool> any-unavailable: false;
    callback recheck-unavailable();
    callback empty-trash();                         // empties the trash (permanent)
    // Trash context menu (right-click on the Trash entry).
    in-out property <bool> trash-menu-open: false;
    in-out property <length> trash-menu-x;
    in-out property <length> trash-menu-y;
    in-out property <bool> trash-menu-confirm: false;   // 2nd click = confirmation
    // Context menu of a drive / network location (right-click).
    in-out property <bool> drive-menu-open: false;
    in-out property <length> drive-menu-x;
    in-out property <length> drive-menu-y;
    in-out property <string> drive-menu-path;
    in-out property <int> drive-menu-kind;
    in-out property <bool> drive-menu-removable;   // → offers to release the drive
    // Unpluggable hardware → the entry and the toast say so; otherwise both
    // speak of releasing, which is all that actually happens.
    in-out property <bool> drive-menu-hotplug;
    in-out property <string> drive-menu-device;    // eject/disconnect target (empty → actions hidden)
    callback drive-eject(string, bool);  // release (device, unpluggable)
    callback drive-disconnect(string);   // disconnects a mapped network drive (device)
    callback place-copy-path(string);    // copies the path to the clipboard
    // Re-scans places when the Places panel is (re)opened.
    changed left-panel => {
        if (root.left-panel == 1) {
            root.sidebar-refresh();
        } else {
            root.cancel-sidebar-section-drag();
            root.cancel-sidebar-item-drag();
        }
    }
    // Auto-expand on drag: restarts the countdown when the
    // hovered collapsed container changes (declared at the component level to see the
    // property; the `fav-autoexp-timer` Timer lives in the window's body).
    changed fav-drag-hover-container => { fav-autoexp-timer.restart(); }
    // Auto-expand during a TAB/FILE drag: mirrors
    // `fav-panel.hover-collapsed-container` (hovered collapsed container) declared at the
    // ROOT to be visible to the Timer + its `changed` that restarts the countdown.
    property <string> fav-ext-collapsed: fav-panel.hover-collapsed-container;
    changed fav-ext-collapsed => { fav-autoexp-ext-timer.restart(); }
    // Auto-expanding the collapsed favorites SECTION on drag-hover is driven
    // purely by the Timer's `running` binding below (single target → no need to
    // re-arm on change, unlike the multi-container case above). Mixing an
    // imperative `restart()` with `running` here caused stray fires.
    // The "Open with" flyout closes along with its parent menu.
    changed ctx-menu-open => {
        if (!root.ctx-menu-open) {
            root.ow-menu-open = false;
            root.folder-menu-open = false;
            root.new-menu-open = false;
            root.ctx-shell-sub-open = false;
            root.mark-menu-open = false;
            CtxNav.disarm();
        }
    }
    changed tab-menu-open => {
        if (!root.tab-menu-open && root.mark-target-kind == 1) {
            root.mark-menu-open = false;
        }
    }
    changed fav-menu-open => {
        if (!root.fav-menu-open && root.mark-target-kind == 2) {
            root.mark-menu-open = false;
        }
    }
    // A keyboard-opened submenu selects its first visible entry after the open
    // binding is applied. When a submenu closes on pointer leave, navigation
    // returns to the row that opened it.
    property <bool> ctx-sub-open: root.ow-menu-open || root.mark-menu-open || root.folder-menu-open
        || root.new-menu-open || root.ctx-shell-sub-open;
    function select-first-submenu-item() {
        if (root.ctx-sub-open && CtxNav.want-first && CtxNav.level == 2) {
            CtxNav.want-first = false;
            CtxNav.step(1);
        }
    }
    changed ctx-sub-open => {
        root.select-first-submenu-item();
        if (!root.ctx-sub-open && CtxNav.level == 2) {
            CtxNav.leave-submenu();
        }
    }
    // Reusing the folder flyout can change its owner without closing it.
    // Keyboard opening must still select its first row in that case.
    property <bool> folder-reveal-open: root.folder-menu-open && root.folder-menu-reveal;
    changed folder-reveal-open => { root.select-first-submenu-item(); }

    // Tree-structured favorites -----
    in property <[FavNode]> fav-nodes;          // flattened tree (visible nodes)
    in-out property <string> fav-selected-id: "";
    callback fav-row-activate(string);          // click: container→toggle / favorite→open
    callback fav-row-middle(string);            // middle-click favorite → new tab
    callback fav-collapse-all();
    callback fav-open(string);                  // open favorite (new tab)
    callback fav-open-all(string);              // container: open all children
    callback fav-delete(string);
    callback fav-copy-path(string);
    // Drag reordering: delegated to the bridge (target/zone computed in f32).
    callback fav-drag-move(int, length, length);   // (row-index, cur-y, row-top)
    callback fav-drag-drop(int, length, length, bool); // final bool: commit tree move
    // Context menu of a favorite node.
    in-out property <bool> fav-menu-open: false;
    in-out property <length> fav-menu-x;
    in-out property <length> fav-menu-y;
    in-out property <string> fav-menu-id: "";
    in-out property <string> fav-menu-name: "";             // label (pre-fills the rename)
    in-out property <bool> fav-menu-container: false;
    in-out property <bool> fav-menu-is-dir: false;
    /// The menu's target is a file whose target still exists, so acting on it
    /// launches it rather than navigating anywhere.
    in-out property <bool> fav-menu-is-file: false;
    in-out property <int> fav-menu-folder-slot: 0;
    in-out property <bool> fav-menu-confirm-delete: false;  // 2nd click, non-empty container
    // Modal popup for creating or renaming a favorites container.
    // `rename` distinguishes create/rename; `target` = id to rename (rename) or
    // parent id (create; "" = root). `invalid` is set by the bridge.
    in-out property <bool> fav-name-open: false;
    in-out property <bool> fav-name-rename: false;
    in-out property <string> fav-name-target: "";
    in-out property <string> fav-name-value: "";
    in-out property <bool> fav-name-invalid: true;
    in-out property <bool> fav-name-focus-armed: false;
    callback fav-name-check(string);
    callback fav-name-confirm();
    // Drag indicators (set by the bridge during the move).
    in-out property <bool> fav-drag-active: false;
    in-out property <int> fav-drag-target-index: -1;
    in-out property <int> fav-drag-zone: 0;
    // Collapsed container currently hovered during a drag (auto-expand after a delay).
    in-out property <string> fav-drag-hover-container: "";
    callback fav-expand(string);   // expands a container (IN-PLACE insertion → drag preserved)
    // Toggle "Collapse all" / "Expand all" (containers).
    in-out property <bool> fav-can-collapse: false;
    callback fav-expand-all();
    // Collapse of the Favorites SECTION — hides the tree in the unified column.
    in-out property <bool> fav-section-collapsed: false;
    // The three other collapsible sections of the left column. These four
    // properties are restored from the workspace by the bridge.
    in-out property <bool> sidebar-shortcuts-collapsed: false;
    in-out property <bool> sidebar-drives-collapsed: false;
    in-out property <bool> sidebar-network-collapsed: false;
    callback sidebar-section-state-changed(int /*0 drives · 1 shortcuts · 2 favorites · 3 network*/,
        bool /*collapsed*/);
    function toggle-sidebar-section(section: int) {
        if (section == 0) {
            root.sidebar-drives-collapsed = !root.sidebar-drives-collapsed;
            root.sidebar-section-state-changed(0, root.sidebar-drives-collapsed);
        } else if (section == 1) {
            root.sidebar-shortcuts-collapsed = !root.sidebar-shortcuts-collapsed;
            root.sidebar-section-state-changed(1, root.sidebar-shortcuts-collapsed);
        } else if (section == 2) {
            root.fav-section-collapsed = !root.fav-section-collapsed;
            root.sidebar-section-state-changed(2, root.fav-section-collapsed);
        } else if (section == 3) {
            root.sidebar-network-collapsed = !root.sidebar-network-collapsed;
            root.sidebar-section-state-changed(3, root.sidebar-network-collapsed);
        }
    }
    // Rank in the global preference. The fallback preserves the historical
    // order during the very first milliseconds, before the bridge's push.
    pure function sidebar-section-rank(section: int) -> int {
        if (root.sidebar-section-order.length == 4) {
            if (root.sidebar-section-order[0] == section) { return 0; }
            if (root.sidebar-section-order[1] == section) { return 1; }
            if (root.sidebar-section-order[2] == section) { return 2; }
            if (root.sidebar-section-order[3] == section) { return 3; }
        }
        return section;
    }
    pure function sidebar-section-top(section: int) -> length {
        if (section == 0) { return drives-section.y; }
        if (section == 1) { return shortcuts-section.y; }
        if (section == 2) { return fav-panel.y; }
        return network-section.y;
    }
    pure function sidebar-section-bottom(section: int) -> length {
        if (section == 0) { return drives-section.y + drives-section.height; }
        if (section == 1) { return shortcuts-section.y + shortcuts-section.height; }
        if (section == 2) { return fav-panel.y + fav-panel.height; }
        return network-section.y + network-section.height;
    }
    pure function sidebar-section-header-middle(section: int) -> length {
        // All headers are exactly 30px. An expanded section's content
        // must never enlarge its reordering toggle zone.
        return root.sidebar-section-top(section) + 15px;
    }
    // Final index after removal then insertion. Only the centers of the three
    // (remaining) HEADERS matter: identical behavior whether the section is collapsed or very tall.
    pure function sidebar-section-target-at(source: int, local-y: length) -> int {
        return (source != 0 && local-y > root.sidebar-section-header-middle(0) ? 1 : 0)
            + (source != 1 && local-y > root.sidebar-section-header-middle(1) ? 1 : 0)
            + (source != 2 && local-y > root.sidebar-section-header-middle(2) ? 1 : 0)
            + (source != 3 && local-y > root.sidebar-section-header-middle(3) ? 1 : 0);
    }
    pure function sidebar-section-remaining-rank(section: int, source: int) -> int {
        return root.sidebar-section-rank(section)
            - (root.sidebar-section-rank(section) > root.sidebar-section-rank(source) ? 1 : 0);
    }
    pure function sidebar-section-at-remaining-rank(rank: int, source: int) -> int {
        if (source != 0 && root.sidebar-section-remaining-rank(0, source) == rank) { return 0; }
        if (source != 1 && root.sidebar-section-remaining-rank(1, source) == rank) { return 1; }
        if (source != 2 && root.sidebar-section-remaining-rank(2, source) == rank) { return 2; }
        return 3;
    }
    function update-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        if (!root.sidebar-section-drag-active || section != root.sidebar-section-drag-source) { return; }
        root.sidebar-section-drag-last-x = abs-x;
        root.sidebar-section-drag-last-y = abs-y;
        let local-y: length = abs-y - sidebar-stack.absolute-position.y;
        if (abs-x < sidebar-stack.absolute-position.x
                || abs-x > sidebar-stack.absolute-position.x + sidebar-stack.width
                || local-y < 0px || local-y > sidebar-stack.height) {
            root.sidebar-section-drag-target = -1;
            return;
        }
        root.sidebar-section-drag-target = root.sidebar-section-target-at(section, local-y);
        if (root.sidebar-section-drag-target < 3) {
            root.sidebar-section-drag-preview-y = root.sidebar-section-top(
                root.sidebar-section-at-remaining-rank(root.sidebar-section-drag-target, section));
        } else {
            root.sidebar-section-drag-preview-y = root.sidebar-section-bottom(
                root.sidebar-section-at-remaining-rank(2, section));
        }
    }
    function refresh-sidebar-section-drag-geometry() {
        if (root.sidebar-section-drag-active) {
            root.update-sidebar-section-drag(root.sidebar-section-drag-source,
                root.sidebar-section-drag-last-x, root.sidebar-section-drag-last-y);
        }
    }
    function start-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        if (section < 0 || section > 3 || root.left-panel != 1) { return; }
        root.sidebar-section-drag-active = true;
        root.sidebar-section-drag-source = section;
        root.sidebar-section-drag-target = root.sidebar-section-rank(section);
        root.update-sidebar-section-drag(section, abs-x, abs-y);
    }
    function drop-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        root.update-sidebar-section-drag(section, abs-x, abs-y);
        let target: int = root.sidebar-section-drag-target;
        let source-rank: int = root.sidebar-section-rank(section);
        root.cancel-sidebar-section-drag();
        if (target >= 0 && target != source-rank) {
            root.sidebar-section-reordered(section, target);
        }
    }
    function cancel-sidebar-section-drag() {
        root.sidebar-section-drag-active = false;
        root.sidebar-section-drag-source = -1;
        root.sidebar-section-drag-target = -1;
    }
    // "Save as favorite" popup (from a tab / file).
    in-out property <bool> fav-save-open: false;
    in-out property <bool> fav-save-focus-armed: false;
    in-out property <string> fav-save-target: "";     // path (or "N items")
    in-out property <bool> fav-save-multi: false;
    in-out property <string> fav-save-alias: "";
    in property <[string]> fav-container-labels;       // indented labels (dropdown)
    in-out property <int> fav-container-index: 0;      // 0 = Root
    callback fav-save-commit(string, int);             // (alias, container index)
    callback fav-save-new-container(string, int);      // (name, parent container index) → creates + selects
    // "New container" sub-popup (from the save popup).
    in-out property <bool> fav-newc-open: false;
    in-out property <bool> fav-newc-focus-armed: false;
    in-out property <string> fav-newc-name: "";
    in-out property <int> fav-newc-parent-index: 0;    // 0 = Root
    // Save requests (triggered by the tab/file menus).
    callback fav-save-tab(int, int);                   // (panel, tab)
    callback fav-save-all-tabs(int);                   // (panel)
    callback duplicate-tab(int, int);                  // (panel, tab) → copy inserted after
    callback fav-add-selection();                      // selected files (active view)
    // Context menu of a tab (right-click).
    in-out property <bool> tab-menu-open: false;
    in-out property <length> tab-menu-x;
    in-out property <length> tab-menu-y;
    in-out property <int> tab-menu-panel: -1;
    in-out property <int> tab-menu-tab: -1;
    in-out property <int> tab-menu-folder-slot: 0;
    // Menu of a tab bar's dead zone. It reuses the existing favorites
    // callback and only exposes the specific restore action.
    in-out property <bool> tab-empty-menu-open: false;
    in-out property <length> tab-empty-menu-x;
    in-out property <length> tab-empty-menu-y;
    in-out property <int> tab-empty-menu-panel: -1;
    in-out property <bool> closed-tabs-available: false;
    callback reopen-last-closed-tab(int /*panel*/);

    // Context menu of a keyboard shortcut: same shared mechanism as
    // the other menus (close-ctx-menus / Dismiss). `action` = the targeted id.
    in-out property <bool> shortcut-menu-open: false;
    in-out property <length> shortcut-menu-x;
    in-out property <length> shortcut-menu-y;
    in-out property <string> shortcut-menu-action;
    function open-shortcut-menu(action: string, ax: length, ay: length) {
        root.close-ctx-menus();
        root.shortcut-menu-action = action;
        root.shortcut-menu-x = ax;
        root.shortcut-menu-y = ay;
        root.shortcut-menu-open = true;
    }

    // Opens the naming popup for a favorites container. `rename`: false =
    // create (target = parent id, "" = root), true = rename (target = id).
    function open-fav-name(rename: bool, target: string, value: string) {
        root.fav-name-rename = rename;
        root.fav-name-target = target;
        root.fav-name-value = value;
        root.fav-name-open = true;
        root.fav-name-focus-armed = true;
        root.fav-name-check(value);   // sets `fav-name-invalid` (empty → disabled)
    }

    // ----- Theme -----
    public function apply-theme() {
        if (root.theme-scheme == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (root.theme-scheme == 2) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    init => { apply-theme(); }
    changed theme-scheme => { apply-theme(); }
    changed system-dark => { root.system-theme-changed(); }
    // closing settings cancels any ongoing capture/conflict (otherwise the
    // `key-scope` would stay stuck in capture mode).
    changed settings-open => {
        if (!root.settings-open) {
            root.shortcut-capturing = "";
            root.shortcut-conflict-action = "";
            root.shortcut-conflict-message = "";
            root.optional-tools-expanded = false;
        } else {
            // Same reasoning: the count is a filesystem walk, so it is taken
            // when the panel opens rather than kept live.
            root.count-annotation-orphans();
            root.refresh-themes();
            // On OPENING, returns focus to the root keyboard scope → Escape closes
            // the dialog even when it was opened via a click (gear button):
            // otherwise no element has focus and `key-scope.key-pressed` (which handles
            // Escape) never gets called. Consistent with shortcut capture, which
            // already requires this focus.
            key-scope.focus();
        }
    }

    // Text-field popups grab focus into their edit field when they open. On
    // CLOSE that field is destroyed, so — unless we act — focus is left on
    // nothing and `key-scope` (which handles Escape and the shortcuts) stops
    // receiving keys. Most visible when the popup sat on top of ANOTHER overlay,
    // e.g. Custom Command over Settings: after closing the popup with Escape, a
    // second Escape could no longer close the settings. Hand focus back to
    // `key-scope` on every close (all paths: Escape, buttons, backdrop).
    // rename / create / paste-conflict / workspaces do the same above.
    changed ow-popup-open => { if (!root.ow-popup-open) { key-scope.focus(); } }
    changed fav-name-open => { if (!root.fav-name-open) { key-scope.focus(); } }
    changed fav-newc-open => { if (!root.fav-newc-open) { key-scope.focus(); } }

    // Configurable shortcuts -----
    // Normalizes `event.text` into a canonical key name (special keys
    // are `Key.*` constants). Letters/digits/punctuation pass through as-
    // is (the bridge uppercases letters). Aligned with `shortcuts.rs`.
    pure function chord-key-name(t: string) -> string {
        if (t == Key.UpArrow) { return "ArrowUp"; }
        if (t == Key.DownArrow) { return "ArrowDown"; }
        if (t == Key.LeftArrow) { return "ArrowLeft"; }
        if (t == Key.RightArrow) { return "ArrowRight"; }
        if (t == Key.Tab) { return "Tab"; }
        if (t == Key.Backtab) { return "Tab"; }
        if (t == Key.Return) { return "Enter"; }
        if (t == Key.Delete) { return "Delete"; }
        if (t == Key.Home) { return "Home"; }
        if (t == Key.End) { return "End"; }
        if (t == Key.PageUp) { return "PageUp"; }
        if (t == Key.PageDown) { return "PageDown"; }
        if (t == Key.Insert) { return "Insert"; }
        if (t == Key.Space) { return "Space"; }
        if (t == Key.F1) { return "F1"; }
        if (t == Key.F2) { return "F2"; }
        if (t == Key.F3) { return "F3"; }
        if (t == Key.F4) { return "F4"; }
        if (t == Key.F5) { return "F5"; }
        if (t == Key.F6) { return "F6"; }
        if (t == Key.F7) { return "F7"; }
        if (t == Key.F8) { return "F8"; }
        if (t == Key.F9) { return "F9"; }
        if (t == Key.F10) { return "F10"; }
        if (t == Key.F11) { return "F11"; }
        if (t == Key.F12) { return "F12"; }
        // Backslash / pipe (Shift+\) → stable name independent of the layout.
        if (t == "\\" || t == "|") { return "Backslash"; }
        if (t == ",") { return "Comma"; }
        return t;
    }

    // Executes action `id` (resolved by `match-action`). Centralizes each
    // shortcut's behavior; the combination→id mapping is
    // driven by the config (rebind).
    function perform-action(id: string) {
        // Cursor navigation (keyboard)
        if (id == "cursor-up") { root.move-cursor(0, false); return; }
        if (id == "cursor-left") { root.move-cursor(4, false); return; }
        if (id == "cursor-right") { root.move-cursor(5, false); return; }
        if (id == "cursor-down") { root.move-cursor(1, false); return; }
        if (id == "cursor-first") { root.move-cursor(2, false); return; }
        if (id == "cursor-last") { root.move-cursor(3, false); return; }
        if (id == "extend-up") { root.move-cursor(0, true); return; }
        if (id == "extend-left") { root.move-cursor(4, true); return; }
        if (id == "extend-right") { root.move-cursor(5, true); return; }
        if (id == "extend-down") { root.move-cursor(1, true); return; }
        // Folder navigation
        if (id == "nav-back") { root.go-back(); return; }
        if (id == "nav-forward") { root.go-forward(); return; }
        if (id == "nav-parent") { root.go-parent(); return; }
        if (id == "nav-home") { root.go-home(); return; }
        if (id == "refresh") { root.refresh(); return; }
        // Ctrl+L: focuses the ACTIVE panel's address bar. The counter
        // is observed by each PanelComponent; only the active one enters edit mode.
        if (id == "focus-address") { root.address-focus-gen += 1; return; }
        // Selection
        if (id == "select-all") { root.select-all(); return; }
        // Tabs & views
        if (id == "tab-new") { root.tab-new(); return; }
        if (id == "tab-close") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-closed(root.panels[root.active-panel-idx].active-tab-idx);
            }
            return;
        }
        if (id == "tab-reopen-closed") {
            root.reopen-last-closed-tab(root.active-panel-idx);
            return;
        }
        if (id == "tab-next") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-clicked(mod(
                    root.panels[root.active-panel-idx].active-tab-idx + 1,
                    root.panels[root.active-panel-idx].tabs.length));
            }
            return;
        }
        if (id == "tab-prev") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-clicked(root.panels[root.active-panel-idx].active-tab-idx <= 0
                    ? root.panels[root.active-panel-idx].tabs.length - 1
                    : root.panels[root.active-panel-idx].active-tab-idx - 1);
            }
            return;
        }
        if (id == "view-next" || id == "view-prev") {
            if (root.panels.length > 1) {
                root.panel-clicked(mod(root.active-panel-idx
                    + (id == "view-prev" ? root.panels.length - 1 : 1), root.panels.length));
            }
            return;
        }
        if (id == "split-side") { root.panel-split(0); return; }
        if (id == "split-stack") { root.panel-split(1); return; }
        if (id == "equalize-views") { root.equalize-views(-1); return; }
        // File operations
        if (id == "open") { root.action-open(); return; }
        if (id == "copy") { root.action-copy(); return; }
        if (id == "cut") { root.action-cut(); return; }
        if (id == "paste") { root.action-paste(); return; }
        if (id == "rename") { root.action-rename(); return; }
        if (id == "delete") { root.action-delete(); return; }
        if (id == "delete-permanent") { root.action-delete-permanent(); return; }
        if (id == "restore-trash") { root.action-restore-last-trashed(); return; }
        if (id == "new-folder") { root.create-kind = 0; root.create-name = ""; root.create-target = ""; root.create-popup-open = root.search-root-action-allowed(); return; }
        if (id == "new-file") { root.create-kind = 1; root.create-name = ""; root.create-target = ""; root.create-popup-open = root.search-root-action-allowed(); return; }
        if (id == "terminal") { root.action-open-terminal(); return; }
        if (id == "properties") { root.action-properties(); return; }
        // Display options
        if (id == "toggle-hidden") { root.toggle-show-hidden(root.active-panel-idx); return; }
        if (id == "cycle-group") {
            if (root.active-panel-idx < root.panels.length
                    && !root.panels[root.active-panel-idx].manual-order) {
                root.set-group-mode(root.active-panel-idx,
                    root.panels[root.active-panel-idx].group-mode == "folders" ? "colored"
                    : root.panels[root.active-panel-idx].group-mode == "colored" ? "files"
                    : root.panels[root.active-panel-idx].group-mode == "files" ? "mixed"
                    : "folders");
            }
            return;
        }
        if (id == "toggle-view-mode") { root.toggle-preview-mode(root.active-panel-idx); return; }
        // Application
        if (id == "save-workspace") { root.ws-save-current(); return; }
        if (id == "open-settings") { root.settings-open = true; return; }
        if (id == "open-workspaces") { root.workspaces-open = true; return; }
        // The nine workspace slots are ids that differ only by their digit,
        // which the bridge reads. Listing them here would be nine lines saying
        // the same thing, and an id matching nothing simply does nothing.
        root.ws-load-slot-action(id);
    }

    // ----- Root focus scope (global keyboard shortcuts) -----
    key-scope := FocusScope {
        // Coming back from another application. Only a WINDOW activation
        // counts: focus moving inside Favnyr is not the user returning from
        // somewhere else. Slint hands the activation to the element that had
        // focus, which is this scope in the ordinary case.
        focus-gained(reason) => {
            if (reason == FocusReason.window-activation) {
                WindowFocus.activations += 1;
                root.recovery-activated();
            }
        }
        // Focus ON STARTUP: without this, the active view doesn't have keyboard
        // focus until it's been clicked into → a shortcut like Ctrl+L
        // would have no effect on a cold start.
        init => { self.focus(); }
        // Focus returning to Favnyr (Alt-Tab, click from another window)
        // while a file drag is still "active": the user left then came
        // back → the gesture must have ended (mouse released
        // outside the window, `up` lost). We cancel this phantom drag, otherwise the pill
        // stays stuck to the cursor. The `file-drag-active` guard prevents any
        // effect during a normal focus change (a real drag never causes the
        // window to lose focus). The scope keeps focus on wake-up (Slint
        // forwards the activation event to the previously focused element).
        changed has-focus => {
            if (self.has-focus && root.sidebar-section-drag-active) {
                root.cancel-sidebar-section-drag();
            }
            // An external OLE drag can legitimately reactivate Favnyr while
            // its source prepares temporary files. OLE DragLeave/Drop owns
            // that lifecycle; this focus fallback only cancels an INTERNAL
            // gesture whose mouse-up was lost outside the window.
            if (self.has-focus && root.file-drag-active
                    && root.file-drag-source-panel >= 0) {
                root.end-file-drag();
                root.cancel-sidebar-item-drag();
                root.folder-drag-cancelled();
            }
        }
        // Ctrl key tracking: reflects the modifier on every key
        // → Ctrl+wheel = zoom entries (see PanelTile.scroll-event).
        key-released(event) => {
            if (event.text == Key.Control) { root.ctrl-down = false; }
            if (event.text == Key.Shift) { root.shift-down = false; }
            if (event.text == Key.Space) { root.folder-open-drag-active = false; }
            root.update-file-drag-action();
            return reject;
        }
        key-pressed(event) => {
            // The close guard owns all keys, including shortcuts from panels
            // underneath it. Confirmation returns keyboard selection to Stay.
            if (root.exit-warning-open) {
                if (event.text == Key.Escape) { root.exit-stay(); }
                else if (!root.exit-stopping && (event.text == Key.Tab || event.text == Key.Backtab)) {
                    root.exit-choice = 1 - root.exit-choice;
                } else if (event.text == Key.Return || event.text == Key.Space) {
                    if (root.exit-choice == 0 || root.exit-stopping) { root.exit-stay(); }
                    else { root.exit-cancel-operations(); }
                }
                return accept;
            }
            root.keyboard-interaction-gen += 1;
            // Backtab denotes Shift+Tab even if a backend omits the modifier.
            let chord-shift = event.modifiers.shift || event.text == Key.Backtab;
            root.ctrl-down = event.modifiers.control;
            root.shift-down = event.modifiers.shift;
            root.update-file-drag-action();
            if (event.text == Key.Space && root.file-drag-active
                    && root.file-drag-source-panel >= 0 && root.file-drag-can-open) {
                root.folder-open-drag-active = true;
                root.folder-open-drag-used = true;
                return accept;
            }
            // capturing an ongoing combination (rebind in settings).
            // Intercepts EVERYTHING as long as `shortcut-capturing` is set.
            if (root.shortcut-capturing != "") {
                if (event.text == Key.Escape) { root.shortcut-capturing = ""; return accept; }
                // Ignores lone modifiers: we're waiting for the actual key.
                if (event.text == Key.Control || event.text == Key.Shift
                        || event.text == Key.Alt || event.text == Key.Meta
                        || event.text == Key.AltGr) {
                    return accept;
                }
                root.shortcut-rebind(root.shortcut-capturing,
                    (event.modifiers.control ? "Ctrl+" : "")
                    + (event.modifiers.alt ? "Alt+" : "")
                    + (chord-shift ? "Shift+" : "")
                    + root.chord-key-name(event.text));
                return accept;
            }
            if (event.text == Key.Escape) {
                // A gesture in progress answers before anything else. Every
                // preview it draws keys on the state cleared here, so they all
                // go out at once and the release then finds nothing to do. The
                // pointer stays captured until the button comes up, which is
                // what every toolkit does.
                if (root.view-drag-active || root.drag-active || root.sidebar-item-drag-active
                        || root.file-drag-active || root.fav-drag-active
                        || root.sidebar-section-drag-active) {
                    root.cancel-mouse-gestures();
                    return accept;
                }
                if (root.file-drop-menu-open) { root.file-drop-menu-open = false; return accept; }
                if (root.split-menu-open) { root.split-menu-open = false; return accept; }
                if (root.tabbar-menu-open) { root.tabbar-menu-open = false; return accept; }
                if (root.display-menu-open) { root.display-menu-open = false; return accept; }
                if (root.sort-menu-open) {
                    if (root.sort-menu-page != 0) { root.sort-menu-page = 0; }
                    else { root.sort-menu-open = false; }
                    return accept;
                }
                if (root.url-menu-open) { root.url-menu-open = false; return accept; }
                if (root.trash-menu-open) { root.trash-menu-open = false; return accept; }
                if (root.drive-menu-open) { root.drive-menu-open = false; return accept; }
                if (root.columns-menu-open) { root.columns-menu-open = false; return accept; }
                // "Open with", favorites, and tab menus/popups that weren't
                // closed by Escape. Placed BEFORE settings: the "Custom
                // command" popup can be opened ON TOP OF the settings
                // → Escape closes the popup first, not the settings.
                if (root.ow-popup-open) { root.ow-popup-open = false; return accept; }
                if (root.archive-open) { root.archive-cancel(); return accept; }
                if (root.ow-picker-open) { root.ow-picker-open = false; return accept; }
                // A submenu is peeled off first: Escape closes what it
                // opened, not everything at once. Same route as the left
                // arrow, so the keyboard lands back on the parent row.
                if (root.ctx-sub-open) { root.leave-submenu(); return accept; }
                if (root.fav-save-open) { root.fav-save-open = false; return accept; }
                if (root.fav-newc-open) { root.fav-newc-open = false; return accept; }
                if (root.fav-menu-open) { root.fav-menu-open = false; return accept; }
                if (root.tab-menu-open) { root.tab-menu-open = false; return accept; }
                if (root.tab-empty-menu-open) { root.tab-empty-menu-open = false; return accept; }
                if (root.paste-conflict-open) { root.paste-conflict-cancel(); root.paste-conflict-open = false; return accept; }
                if (root.ctx-menu-open) { root.ctx-close(); return accept; }
                // BEFORE the settings: this list sits on top of the panel, so
                // Escape gives back the panel first and closes it only on the
                // next press. Same order as the "unsaved changes" guard over
                // the workspaces overlay.
                if (root.orphans-open) { root.orphans-open = false; return accept; }
                if (root.prop-open) { root.prop-open = false; root.prop-closed(); return accept; }
                if (root.settings-open) { root.settings-open = false; return accept; }
                // Escape first closes the guard (back to the list), not the
                // whole Workspaces overlay.
                // The slot picker is peeled off before the panel that holds
                // it: Escape gives back the panel, not the whole overlay.
                if (root.ws-slot-picker-open) { root.ws-slot-picker-open = false; return accept; }
                if (root.ws-theme-picker-open) { root.ws-theme-picker-open = false; return accept; }
                if (root.ws-dirty-warn-open) { root.ws-dirty-warn-open = false; return accept; }
                if (root.workspaces-open) { root.workspaces-open = false; return accept; }
                if (root.rename-popup-open) { root.rename-popup-open = false; return accept; }
                if (root.create-popup-open) { root.create-popup-open = false; return accept; }
                if (root.delete-warning-open) { root.delete-warning-open = false; return accept; }
                if (root.open-many-open) { root.open-many-open = false; return accept; }
                if (root.fav-name-open) { root.fav-name-open = false; return accept; }
                // Escape first closes the active filter (by-name OR by-extension
                // type-ahead — shared via filter-clear bridge-side), otherwise
                // deselects.
                if (root.filter-bar-on) { root.filter-clear(); return accept; }
                root.deselect-all();
                return accept;
            }
            // Backspace: edits the active filter when there is one (by-name
            // OR by-extension type-ahead). Outside a filter, Backspace no longer has a
            // "parent" navigation effect — that now only goes through its
            // configurable shortcut (e.g. Alt+Up arrow).
            if (event.text == Key.Backspace && root.filter-bar-on) {
                root.filter-backspace();
                return accept;
            }
            // Arrow navigation of the view's context menu: the keyboard has to
            // be able to finish what the Menu key started. Placed before the
            // dispatch below, which an open overlay suspends in any case.
            if (root.ctx-menu-open && CtxNav.level > 0) {
                if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                    // Wrapping both ways: going up from nothing lands on the
                    // last entry, which is what a menu does elsewhere.
                    CtxNav.step(event.text == Key.DownArrow ? 1 : -1);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    // Only a row that carries a submenu answers; the others
                    // hear the broadcast and do nothing.
                    if (CtxNav.level == 1) { CtxNav.expand += 1; }
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    if (CtxNav.level == 2) { root.leave-submenu(); }
                    return accept;
                }
                if (event.text == Key.Return) {
                    CtxNav.activate += 1;
                    return accept;
                }
            }
            // Menu key: opens the context menu of the active view, like a
            // right-click. Handled natively rather than through the rebindable
            // catalogue — the key carries this one meaning on every desktop and
            // has no combination to describe — and placed ahead of the dispatch
            // below so no binding can mask it.
            if (event.text == Key.Menu) {
                if (!root.any-overlay-open) {
                    root.close-ctx-menus();
                    root.menu-key-serial += 1;
                }
                return accept;
            }
            // Configurable shortcuts: the bridge resolves the combination into
            // an action id, which we execute via `perform-action`. Suspended
            // when an overlay is open, since it manages its own keys, rebind
            // capture included.
            //
            // Saving the current workspace is the one exception, and only from
            // the workspaces panel: that panel offers the very same action with
            // the mouse, so suspending it there took the hand off the keyboard
            // for the action the panel is about. Its guard dialog keeps its own
            // keys. Resolving a combination is a pure lookup, so running it
            // while the panel is open costs nothing and decides nothing on its
            // own.
            if (!root.any-overlay-open
                    || (root.workspaces-open && !root.ws-dirty-warn-open)) {
                let id: string = root.match-action(
                    root.chord-key-name(event.text),
                    event.modifiers.control, event.modifiers.alt, chord-shift, event.modifiers.meta);
                if (id != "" && (!root.any-overlay-open || id == "save-workspace")) {
                    root.perform-action(id);
                    return accept;
                }
            }
            // PRINTABLE character outside an overlay → active view's type-ahead
            // filter. Special keys (>= U+F700) and controls (< U+0020) excluded;
            // Ctrl/Alt/Meta left to the shortcuts.
            // Space extends an existing filter but never starts name filtering.
            if (!root.any-overlay-open
                    && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                    && (event.text != Key.Space || root.filter-bar-on)
                    && event.text != "" && event.text >= " " && event.text < "\u{F700}") {
                // Only the keystroke that brings the bar up asks for the
                // keyboard; the next ones are already going into the field.
                root.filter-take-keyboard = !root.filter-bar-on;
                root.filter-type(event.text);
                return accept;
            }
            return reject;
        }

        // Catch-all BELOW all content (declared first = bottom
        // of the z-order → steals no clicks from interactive elements above):
        // receives clicks that NOTHING consumes (window margins, rail /
        // sidebar backgrounds, empty strips) and closes the context menu.
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) { Dismiss.serial += 1; }
            }
        }

        VerticalBox {
            // Reduced top margin so the panel does not start too low. The
            // other sides keep 10px for breathing room.
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 10px;
            spacing: 6px;

            // ===== Activity rail, "Places" sidebar, and content =====
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Always-visible vertical activity rail. Side panel toggle
                // at the top; system actions (Workspaces, Settings) at the bottom.
                ActivityRail {
                    left-panel: root.left-panel;

                    shortcuts: root.menu-shortcuts;
                    toggle-places => { root.left-panel = root.left-panel == 1 ? 0 : 1; }
                    open-workspaces => { root.workspaces-open = true; }
                    open-settings => { root.settings-open = true; }
                }

                // ===== UNIFIED side column (Places + Favorites) =====
                // ALWAYS instantiated (width 0 when collapsed) to stay
                // referenceable: `fav-panel.fav-hover-container` is read on drop,
                // which would be impossible with a conditional element. The grid
                // keeps one instance per section and only varies their rank.
                // Favorites absorbs the available height up to its cap and scrolls.
                left-column := Rectangle {
                    width: root.left-panel == 1 ? root.sidebar-width : 0px;
                    visible: root.left-panel == 1;
                    background: Theme.toolbar;
                    // Full-height right thread (also covers the spacer's area
                    // when the Favorites section is collapsed).
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Tokens.hairline;
                    }
                    // SINGLE local reference frame for the grid and its drop line:
                    // no mixing of absolute coordinates between containers.
                    sidebar-stack := Rectangle {
                        width: 100%;
                        height: 100%;
                        // Four STABLE instances within a grid: their `row`
                        // is the global rank. `fav-panel` keeps its identity and
                        // the preview causes no reflow.
                        ordered-sidebar := GridLayout {
                            width: 100%;
                            height: 100%;
                        spacing: 0px;
                        drives-section := Sidebar {
                            row: root.sidebar-section-rank(0);
                            col: 0;
                            places: root.sidebar-places-drives;

                            // Only this section carries capacity gauges, so it
                            // is the only one that needs the panel's width.
                            panel-width: root.sidebar-width;
                            section-code: 0;
                            title: Strings.sidebar-drives;
                            collapsed: root.sidebar-drives-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            section-toggled => { root.toggle-sidebar-section(0); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            item-drag-active: root.sidebar-item-drag-active;
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-drag-started(x, y) => { root.begin-sidebar-item-drag(x, y); }
                            place-drag-moved(x, y) => { root.update-sidebar-item-drag(x, y); }
                            place-drag-dropped(path, kind, x, y) => {
                                root.finish-sidebar-item-drag(path, kind, x, y);
                            }
                            place-right-clicked(path, kind, removable, hotplug, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, hotplug, device, x, y);
                            }
                        }
                        shortcuts-section := Sidebar {
                            row: root.sidebar-section-rank(1);
                            col: 0;
                            places: root.sidebar-places-shortcuts;

                            section-code: 1;
                            title: Strings.sidebar-shortcuts;
                            collapsed: root.sidebar-shortcuts-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            section-toggled => { root.toggle-sidebar-section(1); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            item-drag-active: root.sidebar-item-drag-active;
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-drag-started(x, y) => { root.begin-sidebar-item-drag(x, y); }
                            place-drag-moved(x, y) => { root.update-sidebar-item-drag(x, y); }
                            place-drag-dropped(path, kind, x, y) => {
                                root.finish-sidebar-item-drag(path, kind, x, y);
                            }
                            place-right-clicked(path, kind, removable, hotplug, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, hotplug, device, x, y);
                            }
                        }
                        fav-panel := FavPanel {
                            row: root.sidebar-section-rank(2);
                            col: 0;
                            // The very condition that hides the column. A
                            // hidden tree must accept nothing, and its frame
                            // cannot say so on its own.
                            shown: root.left-panel == 1;
                            // Height = the CONTENT's (header + tree), CAPPED
                            // (`max-height`) so Drives and Network immediately
                            // follow the favorites. Beyond the available space,
                            // the stretch takes back over and the tree scrolls within
                            // `fav-scroll` without changing the hit-test area. Constants = Slint
                            // geometry: header (separator included) 30; row 30 +
                            // 1 gap = 31; list padding 11; empty state 132.
                            vertical-stretch: 1;
                            max-height: root.fav-section-collapsed
                                ? 30px
                                : (root.fav-nodes.length == 0
                                    ? 162px
                                    : (41px + root.fav-nodes.length * 31px));
                            nodes: root.fav-nodes;

                            selected-id: root.fav-selected-id;
                            drag-active: root.fav-drag-active;
                            location-drag-active: root.sidebar-item-drag-active;
                            drag-target-index: root.fav-drag-target-index;
                            drag-zone: root.fav-drag-zone;
                            // TAB or FILE drag over the favorites
                            // absolute cursor position propagated; the
                            // FavPanel computes the hovered folder (`hover-container`,
                            // read on drop, hit-test unchanged — scroll's own frame).
                            tab-drag-active: root.drag-active;
                            tab-drag-abs-x: root.drag-abs-x;
                            tab-drag-abs-y: root.drag-abs-y;
                            file-drag-active: root.file-drag-active && root.file-drag-selection-can-favorite;
                            file-drag-abs-x: root.file-drag-abs-x;
                            file-drag-abs-y: root.file-drag-abs-y;
                            section-collapsed: root.fav-section-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            toggle-section => { root.toggle-sidebar-section(2); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            row-activate(id) => { root.fav-row-activate(id); }
                            row-middle(id) => { root.fav-row-middle(id); }
                            row-context(id, is-cont, is-dir, is-file, slot, label, x, y) => {
                                root.close-ctx-menus();
                                root.fav-menu-id = id;
                                root.fav-menu-name = label;
                                root.fav-menu-container = is-cont;
                                root.fav-menu-is-dir = is-dir;
                                root.fav-menu-is-file = is-file;
                                root.fav-menu-folder-slot = slot;
                                root.fav-menu-x = x;
                                root.fav-menu-y = y;
                                root.fav-menu-confirm-delete = false;
                                // Right-click doesn't affect `fav-selected-id` and
                                // therefore leaves no persistent highlight.
                                root.fav-menu-open = true;
                            }
                            // Only a favorite DIRECTORY travels towards a
                            // view: a tab, a split and a view all show the
                            // contents of a folder, which a file has none of.
                            // A file favorite keeps the reorder channel, so
                            // dragging it stays the way its place in the tree
                            // is changed, and every other destination refuses
                            // the drop.
                            row-drag-move(ri, cx, cy, rt) => {
                                root.fav-drag-move(ri, cy, rt);
                                if (ri >= 0 && ri < root.fav-nodes.length
                                        && !root.fav-nodes[ri].is-container
                                        && root.fav-nodes[ri].available
                                        && root.fav-nodes[ri].is-dir) {
                                    if (!root.sidebar-item-drag-active) {
                                        root.begin-sidebar-item-drag(cx, cy);
                                    } else {
                                        root.update-sidebar-item-drag(cx, cy);
                                    }
                                }
                            }
                            row-drag-drop(ri, cx, cy, rt, in-favorites) => {
                                let tab-drop-accepted: bool =
                                    ri >= 0 && ri < root.fav-nodes.length
                                    && !root.fav-nodes[ri].is-container
                                    && root.fav-nodes[ri].available
                                    && root.fav-nodes[ri].is-dir
                                    && root.finish-sidebar-item-drag(
                                        root.fav-nodes[ri].id, -1, cx, cy);
                                if (!tab-drop-accepted && root.sidebar-item-drag-active) {
                                    root.cancel-sidebar-item-drag();
                                }
                                // Every release finalizes the reorder drag, but only
                                // the visible favorites frame may commit a tree move.
                                root.fav-drag-drop(
                                    ri, cy, rt, !tab-drop-accepted && in-favorites);
                            }
                            can-collapse: root.fav-can-collapse;
                            // Header "+" → root container creation popup.
                            new-container => { root.open-fav-name(false, "", ""); }
                            collapse-all => { root.fav-collapse-all(); }
                            expand-all => { root.fav-expand-all(); }
                        }
                        network-section := Sidebar {
                            row: root.sidebar-section-rank(3);
                            col: 0;
                            places: root.sidebar-places-network;

                            section-code: 3;
                            title: Strings.sidebar-network;
                            collapsed: root.sidebar-network-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            section-toggled => { root.toggle-sidebar-section(3); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            item-drag-active: root.sidebar-item-drag-active;
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-drag-started(x, y) => { root.begin-sidebar-item-drag(x, y); }
                            place-drag-moved(x, y) => { root.update-sidebar-item-drag(x, y); }
                            place-drag-dropped(path, kind, x, y) => {
                                root.finish-sidebar-item-drag(path, kind, x, y);
                            }
                            place-right-clicked(path, kind, removable, hotplug, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, hotplug, device, x, y);
                            }
                        }
                        // Fixed Trash: it has neither a chevron nor a grip and does
                        // not take part in the global order array.
                        trash-section := Sidebar {
                            row: 4;
                            col: 0;
                            places: root.sidebar-places-trash;

                            section-code: -1;
                            title: "";
                            header-visible: false;
                            item-drag-active: root.sidebar-item-drag-active;
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-drag-started(x, y) => { root.begin-sidebar-item-drag(x, y); }
                            place-drag-moved(x, y) => { root.update-sidebar-item-drag(x, y); }
                            place-drag-dropped(path, kind, x, y) => {
                                root.finish-sidebar-item-drag(path, kind, x, y);
                            }
                            place-right-clicked(path, kind, removable, hotplug, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, hotplug, device, x, y);
                            }
                        }
                        // Remainder below all sections. The tiny stretch
                        // gives priority to Favorites for the available height.
                        Rectangle { row: 5; col: 0; vertical-stretch: 0.0001; }
                        }
                        // Destination indicator in the SAME local frame as
                        // the sections. `-1px` centers its 2px on the separator.
                        if root.sidebar-section-drag-active
                                && root.sidebar-section-drag-target >= 0
                                && root.sidebar-section-drag-target
                                    != root.sidebar-section-rank(root.sidebar-section-drag-source) : Rectangle {
                            x: 6px;
                            y: root.sidebar-section-drag-preview-y - 1px;
                            width: parent.width - 12px;
                            height: 2px;
                            border-radius: 1px;
                            background: Theme.accent-background;
                        }
                    }
                }

                // Left panel resize grip (horizontal drag).
                // Absolute delta since the start of the drag → no drift.
                if root.left-panel != 0 : Rectangle {
                    width: 6px;
                    property <length> start-w;
                    property <length> start-x;
                    background: sb-resize.has-hover || sb-resize.pressed
                        ? Theme.accent-background.with-alpha(0.45)
                        : transparent;
                    sb-resize := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down
                                    && ev.button == PointerEventButton.left) {
                                Dismiss.serial += 1;
                                parent.start-w = root.sidebar-width;
                                parent.start-x = self.absolute-position.x + self.mouse-x;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.sidebar-width = clamp(
                                    parent.start-w
                                        + (self.absolute-position.x + self.mouse-x - parent.start-x),
                                    150px, 440px);
                            }
                        }
                    }
                }

            // ===== Panels container (flattened rendering of the tree) =====
            // Rectangle (NOT a layout): each panel is positioned in
            // **absolute** terms from its fractional geometry (fx/fy/fw/fh x container
            // size), splitters are overlays on the seams.
            // This bypasses Slint's layout engine (a source of
            // "Recursion detected" cycles on repeaters).
            panels-container := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                // Groove: slightly recessed background so the tiles
                // (panels) stand out in the gap that separates them.
                background: Tokens.trough;
                for panel[idx] in root.panels : PanelComponent {
                    // Rounded to a WHOLE pixel: without this, a
                    // fractional position (fraction x width) places the panel on a
                    // half-pixel → blurry text/icons (and inconsistent from one
                    // panel to another depending on whether the fraction lands exactly).
                    // + uniform `panel-gap` inset on all 4 sides → a gap of
                    // 2xpanel-gap between neighbors, 1x against the edges. The seam
                    // (hence the splitter) stays centered on the same position.
                    //
                    // Read from the PARALLEL model `panel-boxes` (never from
                    // `panel`) → moving a tile does not invalidate
                    // `view.rendered-rows`. Should the two models ever be out
                    // of step for a frame, a full-size tile is a kinder
                    // failure than an invisible one.
                    property <PanelBox> box: idx < root.panel-boxes.length
                        ? root.panel-boxes[idx]
                        : { fx: 0, fy: 0, fw: 1, fh: 1 };
                    x: round(panels-container.width * self.box.fx / 1px) * 1px + Tokens.panel-gap;
                    y: round(panels-container.height * self.box.fy / 1px) * 1px + Tokens.panel-gap;
                    width: round(panels-container.width * self.box.fw / 1px) * 1px - 2 * Tokens.panel-gap;
                    height: round(panels-container.height * self.box.fh / 1px) * 1px - 2 * Tokens.panel-gap;
                    // Only the POSITION travels. Animating the size would change
                    // this view's height on every frame, and a height change
                    // costs a round trip to the bridge — render window and
                    // thumbnail priority recomputed, per frame and per view.
                    // The tiles therefore take their new size at once and slide
                    // to their new place.
                    //
                    // 180ms sits between the 110ms of a state lighting up and
                    // the 200ms of a dissolve: long enough for the eye to
                    // follow a tile across the window, short enough never to
                    // delay a second gesture. `ease-in-out` because a tile
                    // LEAVES a place as much as it arrives at one — `ease-out`
                    // is the curve of an arrival alone.
                    animate x, y {
                        duration: root.view-swap-flying ? 180ms : 0ms;
                        easing: ease-in-out;
                    }
                    view-swap-flying: root.view-swap-flying
                        && (root.swap-flight-a == idx || root.swap-flight-b == idx);
                    view: panel;
                    // Dragging a VIEW. The claim on the target follows the
                    // idiom used for the separator outline: only the view that
                    // claimed it may drop it, since leaving one and entering
                    // the next fires both handlers in an order nothing
                    // guarantees.
                    view-drag-active: root.view-drag-active;
                    view-drag-abs-x: root.view-drag-abs-x;
                    view-drag-abs-y: root.view-drag-abs-y;
                    view-drag-is-source: root.view-drag-source == idx;
                    view-drag-is-target: root.view-drag-target == idx;
                    view-drag-armed: root.view-drag-target >= 0 && root.view-drag-target-zone == 1;
                    view-drag-leaving: root.view-drag-outside
                        && root.view-drag-source == idx;
                    changed view-drag-zone => {
                        if (self.view-drag-zone > 0) {
                            root.view-drag-target = idx;
                            root.view-drag-target-zone = self.view-drag-zone;
                        } else if (root.view-drag-target == idx) {
                            root.view-drag-target = -1;
                            root.view-drag-target-zone = 0;
                        }
                    }
                    view-drag-progress(ax, ay) => {
                        if (!root.view-drag-cancelled) {
                            root.view-drag-active = true;
                            root.view-drag-source = idx;
                            root.view-drag-abs-x = ax;
                            root.view-drag-abs-y = ay;
                        }
                    }
                    view-drag-completed(ax, ay) => {
                        // Freeze the drop before changing geometry: moving views
                        // can change which one is under the captured pointer.
                        let target: int = root.view-drag-target;
                        let zone: int = root.view-drag-target-zone;
                        let cancelled: bool = root.view-drag-cancelled;
                        root.view-drag-cancelled = false;
                        root.view-drag-active = false;
                        root.view-drag-source = -1;
                        root.view-drag-target = -1;
                        root.view-drag-target-zone = 0;
                        if (target >= 0 && !cancelled) {
                            root.view-swap-flying = zone == 1;
                            root.swap-flight-a = zone == 1 ? idx : -1;
                            root.swap-flight-b = zone == 1 ? target : -1;
                            root.view-dropped(idx, target, zone);
                        } else if (!cancelled) {
                            // No view under the cursor. The bridge checks
                            // whether the release truly landed outside the
                            // window before detaching anything.
                            root.view-torn-off(idx, ax, ay);
                        }
                    }
                    // Footer drawn from the PARALLEL model `panel-footers`
                    // (never from `panel`) → its update does not invalidate
                    // `view.rendered-rows`.
                    footer-text: idx < root.panel-footers.length ? root.panel-footers[idx] : "";
                    active: idx == root.active-panel-idx;
                    can-close: root.panels.length > 1;

                    view-text-font-size-override: root.view-text-font-size-override;
                    view-text-font-size: root.view-text-font-size;
                    view-item-spacing: root.view-item-spacing;
                    grid-name-tooltip-enabled: root.grid-name-tooltip-enabled;
                    search-path-tooltip-enabled: root.search-path-tooltip-enabled;
                    drag-active: root.drag-active || root.sidebar-item-drag-active
                        || root.folder-open-drag-active;
                    tab-drag-active: root.drag-active;
                    drag-panel-zones: root.drag-active
                        || root.folder-open-drag-active
                        || root.sidebar-item-drag-active;
                    drag-panel-split-edges: root.drag-active || root.can-add-panel;
                    drag-abs-x: root.folder-open-drag-active ? root.file-drag-abs-x : root.drag-abs-x;
                    drag-abs-y: root.folder-open-drag-active ? root.file-drag-abs-y : root.drag-abs-y;
                    tab-tooltip-enabled: root.tab-tooltip-enabled;
                    is-drag-source: root.drag-active && idx == root.drag-source-panel;
                    // The panel under the cursor claims the drop target.
                    changed drag-zone => {
                        if (self.drag-zone > 0) {
                            root.drag-target-panel = idx;
                            root.drag-target-zone = self.drag-zone;
                        } else if (root.drag-target-panel == idx) {
                            root.drag-target-panel = -1;
                            root.drag-target-zone = 0;
                        }
                    }
                    // File drag'n'drop between views ---
                    pointer-modifiers(control, shift) => {
                        root.ctrl-down = control;
                        root.shift-down = shift;
                        root.update-file-drag-action();
                    }
                    file-drag-active: root.file-drag-active;
                    folder-open-drag-active: root.folder-open-drag-active;
                    file-drag-abs-x: root.file-drag-abs-x;
                    file-drag-abs-y: root.file-drag-abs-y;
                    is-file-drag-source: idx == root.file-drag-source-panel;
                    file-drag-internal: root.file-drag-source-panel >= 0;
                    changed file-drag-over => {
                        if (self.file-drag-over) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        } else {
                            root.clear-file-drag-target(idx);
                        }
                    }
                    // The hovered row changes → publishes folder AND executable to
                    // the root to keep feedback and action aligned.
                    changed drag-target-row => {
                        if (root.file-drag-target-panel == idx) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        }
                    }
                    changed drag-target-exec => {
                        if (root.file-drag-target-panel == idx) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        }
                    }
                    changed drag-folder-row => {
                        if (root.file-drag-target-panel == idx) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        }
                    }
                    changed manual-drop-gap => {
                        if (self.manual-drop-gap >= 0) {
                            root.file-drag-manual-gap = self.manual-drop-gap;
                            root.file-drag-manual-panel = idx;
                        } else if (root.file-drag-manual-panel == idx) {
                            root.file-drag-manual-gap = -1;
                            root.file-drag-manual-panel = -1;
                        }
                    }
                    manual-gap-noop(gap) => {
                        return root.manual-order-gap-noop(idx, gap);
                    }
                    file-drag-started(ri, x, y) => {
                        root.cancel-sidebar-item-drag();
                        root.file-drag-source-panel = idx;
                        root.file-drag-abs-x = x;
                        root.file-drag-abs-y = y;
                        root.folder-open-drag-active = false;
                        root.folder-open-drag-used = false;
                        root.file-drag-action = root.file-drag-action-for-modifiers(root.ctrl-down, root.shift-down);
                        root.native-drag-armed = false;   // re-arms the native drag
                        root.file-drag-manual-gap = -1;
                        root.file-drag-manual-panel = -1;
                        root.file-drag-selection-can-favorite = root.file-drag-begin(idx, ri);
                        root.file-drag-active = true;
                        // `file-drag-begin` just guaranteed the selection of the
                        // grabbed row: now recompute the target/source conflict.
                        root.refresh-file-drag-target-invalid();
                    }
                    file-drag-progress(x, y) => {
                        root.file-drag-abs-x = x;
                        root.file-drag-abs-y = y;
                        root.update-file-drag-action();
                        // The cursor LEAVES the window → switches to a native OLE drag
                        // (once) for external apps. We end the
                        // Slint drag (releases ghost + state) before the modal loop.
                        if (root.file-drag-active && !root.folder-open-drag-used && !root.native-drag-armed
                                && (x < 0px || y < 0px || x > root.width || y > root.height)) {
                            root.native-drag-armed = true;
                            root.end-file-drag();
                            root.folder-drag-cancelled();
                            root.start-native-drag(root.file-drag-source-panel);
                        }
                    }
                    file-drag-dropped(x, y) => {
                        root.file-drag-abs-x = x;
                        root.file-drag-abs-y = y;
                        if (root.folder-open-drag-active) {
                            let source: int = root.file-drag-source-panel;
                            let gap: int = root.drag-target-gap;
                            let gap-panel: int = root.drag-target-gap-panel;
                            let gap-accepted: bool = gap-panel >= 0 && gap >= 0;
                            let panel: int = gap-accepted ? gap-panel : root.drag-target-panel;
                            let zone: int = root.directory-panel-drop-valid ? root.drag-target-zone : 0;
                            let fav-container: string = root.fav-hover-container;
                            let over-favorites: bool = root.fav-hover-panel;
                            root.end-file-drag();
                            root.cancel-sidebar-item-drag();
                            root.close-ctx-menus();
                            if (over-favorites) {
                                root.file-to-favorite(source, fav-container);
                            } else if (gap-accepted || zone > 0) {
                                root.folder-drag-dropped(panel, gap-accepted ? gap : -1, zone);
                            }
                            root.folder-drag-cancelled();
                            return;
                        }
                        // The pressed row keeps pointer ownership, therefore
                        // this callback belongs to the SOURCE panel. The target
                        // panel publishes its gap through the root properties.
                        // Freeze both before ending the gesture changes them.
                        let manual-target-panel: int = root.file-drag-manual-panel;
                        let manual-target-gap: int = root.file-drag-manual-gap;
                        // Drop on a FAVORITES folder: TAKES PRIORITY over the
                        // cross-view drop. `fav-hover-container` is read pull-based
                        // BEFORE cutting the drag (file-drag-abs position already up
                        // to date above); non-empty = hovered container → the
                        // selection is saved there as a favorite (no file operation).
                        if (root.fav-hover-container != "") {
                            root.close-ctx-menus();
                            root.file-to-favorite(root.file-drag-source-panel, root.fav-hover-container);
                        } else if (root.fav-hover-panel) {
                            // "No favorites" area or dead zone of the favorites
                            // section → adds AT THE ROOT (container "").
                            root.close-ctx-menus();
                            root.file-to-favorite(root.file-drag-source-panel, "");
                        } else if (manual-target-panel >= 0 && manual-target-gap >= 0) {
                            root.close-ctx-menus();
                            root.manual-order-drop(
                                root.file-drag-source-panel,
                                manual-target-panel,
                                manual-target-gap);
                        } else if (!root.file-drag-target-invalid
                                && root.file-drag-target-panel >= 0
                                && (root.file-drag-target-folder
                                    || root.file-drag-target-exec
                                    || root.file-drag-target-panel != root.file-drag-source-panel)) {
                            root.close-ctx-menus();
                            root.file-drop-src-panel = root.file-drag-source-panel;
                            root.file-drop-target-panel = root.file-drag-target-panel;
                            root.file-drop-target-row = root.file-drag-target-row;
                            // Drop ONTO an executable (.cmd/.bat/.exe…) → we
                            // LAUNCH it with the dropped files as arguments (dev
                            // habit of "dragging a .txt onto a .cmd"). The bridge
                            // returns true if it launched; otherwise normal Copy/… menu.
                            if (root.file-drop-onto-exec()) {
                                // launched — nothing else to do
                            } else if (root.file-drag-action >= 0) {
                                root.file-drop-action(root.file-drag-action);
                            } else {
                                root.file-drop-menu-x = x;
                                root.file-drop-menu-y = y;
                                root.file-drop-menu-open = true;
                            }
                        }
                        root.end-file-drag();
                        root.folder-drag-cancelled();
                    }
                    column-resized(id, w) => { root.panel-column-resized(idx, id, w); }
                    column-toggle(id, vis) => { root.column-toggle(idx, id, vis); }
                    column-moved(id, target) => { root.column-moved(idx, id, target); }
                    ext-filter-toggle => { root.ext-filter-toggle(idx); }
                    tabs-scrolled(vx) => { root.panel-tabs-scrolled(idx, vx); }
                    scroll-target(ti, fwd, vx, vw) => { return root.panel-scroll-target(idx, ti, fwd, vx, vw); }
                    filter-text: root.active-filter;
                    filter-take-keyboard: root.filter-take-keyboard;
                    filter-set(value) => { root.filter-set(value); }
                    filter-focused => { root.filter-take-keyboard = false; }
                    // Resolved exactly as the window's own key scope would,
                    // so a rebound combination behaves the same inside the
                    // filter field as outside it.
                    filter-key(ev) => {
                        // Tab means "done typing": the keyboard goes back to
                        // the list rather than to wherever the toolkit's own
                        // traversal would send it, which is nowhere in
                        // particular and leaves the next keystroke unheard.
                        // The view switch stays one Tab away, from the list.
                        if (ev.text == Key.Tab || ev.text == Key.Backtab) {
                            root.reclaim-list-keyboard();
                            return true;
                        }
                        let id: string = root.match-action(root.chord-key-name(ev.text),
                            ev.modifiers.control, ev.modifiers.alt,
                            ev.modifiers.shift, ev.modifiers.meta);
                        if (id == "") { return false; }
                        root.perform-action(id);
                        return true;
                    }
                    search-scope-toggle => { root.search-scope-toggle(); }
                    changed rows-pointer-busy => {
                        root.rows-pointer-busy = self.rows-pointer-busy;
                    }
                    rows-viewport-changed(top, height, grid) => {
                        return root.panel-viewport-changed(idx, top, height, grid);
                    }
                    zoom-feedback(x, y) => {
                        root.zoom-feedback-text = root.zoom-label(idx);
                        root.zoom-feedback-x = x;
                        root.zoom-feedback-y = y;
                        root.zoom-feedback-visible = true;
                        zoom-feedback-timer.restart();
                    }
                    item-at-content-point(x, y, grid) => { return root.panel-item-at-content-point(idx, x, y, grid); }
                    grid-layout(w, z, f, s, l) => { return root.grid-layout(w, z, f, s, l); }
                    grid-item-rect(grid, index) => { return root.grid-item-rect(grid, index); }
                    grid-insertion-gap(grid, count, x, y, keep) => { return root.grid-insertion-gap(grid, count, x, y, keep); }
                    open-columns-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.columns-menu-panel = idx;
                        root.columns-menu-x = mx;
                        root.columns-menu-y = my;
                        root.columns-menu-open = true;
                    }
                    open-split-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.split-menu-x = mx;
                        root.split-menu-y = my;
                        root.split-menu-open = true;
                    }
                    open-tabbar-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.tabbar-menu-panel = idx;
                        root.tabbar-menu-mode = panel.tab-bar-mode;
                        root.tabbar-menu-x = mx;
                        root.tabbar-menu-y = my;
                        root.tabbar-menu-open = true;
                    }
                    vbar-resized(w) => { root.panel-vbar-resized(idx, w); }
                    open-display-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.display-menu-panel = idx;
                        root.display-menu-x = mx;
                        root.display-menu-y = my;
                        root.display-menu-open = true;
                    }
                    open-sort-menu(mx, my) => {
                        root.show-sort-options(idx, mx, my);
                    }
                    zoom-step(d, top, width, height, pointer-x, pointer-y) => {
                        return root.zoom-view(idx, d, top, width, height, pointer-x, pointer-y);
                    }
                    keyboard-interaction-gen: root.keyboard-interaction-gen;
                    address-focus-gen: root.address-focus-gen;
                    overlay-open: root.any-overlay-open;
                    toggle-show-hidden => { root.toggle-show-hidden(idx); }
                    open-url-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.url-menu-x = mx;
                        root.url-menu-y = my;
                        root.url-menu-open = true;
                    }
                    close-ctx-menu => { root.close-ctx-menus(); }
                    url-edit-text <=> root.url-edit-text;
                    url-menu-open: root.url-menu-open;
                    url-copy-serial: root.url-copy-serial;
                    url-paste-serial: root.url-paste-serial;

                    activate => { root.panel-clicked(idx); }
                    go-back => { root.go-back(); }
                    go-forward => { root.go-forward(); }
                    go-parent => { root.go-parent(); }
                    go-home => { root.go-home(); }
                    refresh => { root.refresh(); }
                    sort-clicked(c) => { root.sort-clicked(c); }
                    secondary-sort-action(action) => { root.secondary-sort-action(action); }
                    row-activated(i) => { root.row-activated(i); }
                    row-clicked(i) => { root.reclaim-list-keyboard(); return root.row-clicked(i); }
                    row-ctrl-clicked(i) => { root.reclaim-list-keyboard(); root.row-ctrl-clicked(i); }
                    row-shift-clicked(i) => { root.reclaim-list-keyboard(); root.row-shift-clicked(i); }
                    rename-selected => { root.action-rename(); }
                    right-clicked(i, x, y) => { root.close-ctx-menus(); root.row-right-clicked(i, x, y); }
                    menu-key-serial: root.menu-key-serial;
                    keyboard-context-row() => { return root.keyboard-context-row(); }
                    select-all => { root.select-all(); }
                    deselect-all => { root.reclaim-list-keyboard(); root.deselect-all(); }
                    rubber-band-begin(m) => { root.reclaim-list-keyboard(); root.rubber-band-begin(m); }
                    rubber-band-update(a, b, c, d) => { root.rubber-band-update(a, b, c, d); }
                    tab-new => { root.tab-new(); }
                    tab-clicked(i) => { root.tab-clicked(i); }
                    tab-closed(i) => { root.tab-closed(i); }
                    tab-context(ti, x, y) => {
                        root.close-ctx-menus();
                        root.tab-menu-panel = idx;
                        root.tab-menu-tab = ti;
                        root.tab-menu-folder-slot = ti >= 0 && ti < panel.tabs.length
                            ? panel.tabs[ti].folder-slot
                            : 0;
                        root.tab-menu-x = x;
                        root.tab-menu-y = y;
                        root.tab-menu-open = true;
                    }
                    tab-bar-context(x, y) => {
                        root.close-ctx-menus();
                        root.tab-empty-menu-panel = idx;
                        root.tab-empty-menu-x = x;
                        root.tab-empty-menu-y = y;
                        root.tab-empty-menu-open = true;
                    }
                    tab-drag-completed(i, ti, ax, ay) => {
                        // Drop on a FAVORITES folder: takes priority over
                        // the normal drop (panel / tear-off / transfer), which is
                        // thus left 100% INTACT. `fav-hover-container` is read
                        // PULL-BASED BEFORE cutting the drag (the binding resets
                        // as soon as `drag-active = false`); non-empty = hovered container.
                        if (root.fav-hover-container != "") {
                            // `idx` = drag's SOURCE panel (may be non-active).
                            root.tab-to-favorite(idx, i, root.fav-hover-container);
                            root.drag-active = false;
                            root.drag-target-gap = -1;
                            root.drag-target-gap-panel = -1;
                        } else if (root.fav-hover-panel) {
                            // Empty / dead zone of the favorites → root ("").
                            root.tab-to-favorite(idx, i, "");
                            root.drag-active = false;
                            root.drag-target-gap = -1;
                            root.drag-target-gap-panel = -1;
                        } else {
                            root.drag-active = false;
                            root.tab-drag-completed(idx, i, ti, ax, ay);
                        }
                        root.drag-target-panel = -1;
                        root.drag-target-zone = 0;
                        root.drag-source-panel = -1;
                    }
                    tab-drag-progress(i, ax, ay) => {
                        // Drag start → purges the previous drag's gap.
                        if (!root.drag-active) {
                            root.drag-target-gap = -1;
                            root.drag-target-gap-panel = -1;
                        }
                        root.drag-active = true;
                        root.drag-abs-x = ax;
                        root.drag-abs-y = ay;
                        root.drag-source-panel = idx;
                        root.tab-drag-progress(i, ax, ay);
                    }
                    tab-gap-claimed(g) => {
                        root.drag-target-gap = g;
                        root.drag-target-gap-panel = idx;
                    }
                    tab-gap-cleared => {
                        if (root.drag-target-gap-panel == idx) {
                            root.drag-target-gap = -1;
                            root.drag-target-gap-panel = -1;
                        }
                    }
                    request-focus => { key-scope.focus(); }
                    navigate-to(p) => { root.navigate-to(p); }
                    empty-right-clicked(x, y) => { root.close-ctx-menus(); root.empty-right-clicked(x, y); }
                    close-panel => { root.panel-closed(idx); }
                }

                // Which views a double-click on the hovered separator would
                // move. Two identical bars can govern very different regions —
                // the outer one commands the whole layout — and nothing on
                // screen says so, hence this outline BEFORE the click rather
                // than an animation after it. Drawn only where the answer is
                // not already obvious: a pair of views needs no help. It bears
                // no TouchArea, so it never stands between the pointer and the
                // panels underneath.
                if root.hover-splitter >= 0
                    && root.splitters[root.hover-splitter].governs > 2 : Rectangle {
                    property <SplitterView> sp: root.splitters[root.hover-splitter];
                    x: panels-container.width * self.sp.area-x;
                    y: panels-container.height * self.sp.area-y;
                    width: panels-container.width * self.sp.area-w;
                    height: panels-container.height * self.sp.area-h;
                    background: transparent;
                    border-width: 1px;
                    border-color: Theme.accent-background;
                    border-radius: Tokens.radius-panel;
                }

                // Separators (resize grips) overlaid on the seams.
                for sp[i] in root.splitters : PanelSplitterAbs {
                    vertical: sp.vertical;
                    equalize => { root.equalize-views(sp.idx); }
                    // Only the separator that claimed the outline may drop it:
                    // leaving one and entering the next fires both handlers in
                    // an order nothing guarantees.
                    changed outlined => {
                        if (self.outlined) {
                            root.hover-splitter = i;
                        } else if (root.hover-splitter == i) {
                            root.hover-splitter = -1;
                        }
                    }
                    x: sp.vertical
                        ? round(panels-container.width * sp.pos / 1px) * 1px - self.width / 2
                        : round(panels-container.width * sp.cross-start / 1px) * 1px;
                    y: sp.vertical
                        ? round(panels-container.height * sp.cross-start / 1px) * 1px
                        : round(panels-container.height * sp.pos / 1px) * 1px - self.height / 2;
                    width: sp.vertical ? 8px : round(panels-container.width * sp.cross-len / 1px) * 1px;
                    height: sp.vertical ? round(panels-container.height * sp.cross-len / 1px) * 1px : 8px;
                    dragged(ax, ay) => {
                        root.splitter-resized(sp.idx,
                            sp.vertical
                                ? (ax - panels-container.absolute-position.x) / panels-container.width
                                : (ay - panels-container.absolute-position.y) / panels-container.height);
                    }
                }
            }
            } // closes the HorizontalLayout (sidebar + panels)
        }

        // ===== Context menu =====
        // NO full-screen backdrop: it used to consume the 2nd click (the menu
        // wouldn't reposition on the next right-click) and swallow the left click
        // (the clicked row wasn't selected). Instead, clicks
        // within the content (sel-touch / dead-zones) close the menu, a right
        // click repositions it (the bridge rewrites ctx-menu-x/y + open), and
        // any interaction with the CHROME (rail, sidebar, tabs, headers,
        // splitters, empty areas…) closes it via the global `Dismiss`.
        if root.ctx-menu-open : Rectangle {
            x: Flyout.pinned-x(root.ctx-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.ctx-menu-y, self.height, root.height);
            width: 240px;
            // Adapted height: full menu (an entry is targeted) vs reduced
            // menu (blank area).
            //
            // The base counts every row that is ALWAYS there (26px each, 1px
            // per separator, 4px of padding above and below); each row that
            // can be hidden then adds its own term, on the very condition of
            // the `if` that renders it. Anything else drifts: the rule is one
            // term per conditional row, and none for the others.
            //
            // "Open as administrator" and "Open in new tab" take the same
            // slot under opposite conditions — exactly one of them shows, so
            // they belong to the base and add nothing.
            height: (root.ctx-on-empty ? 194px : 350px
                    + (root.ctx-can-reveal-result ? 26px : 0px)
                    + (root.ctx-selection-is-dir ? 0px : 26px)          // Open with
                    + ((root.ctx-selection-single && root.ctx-selection-is-dir) ? 26px : 0px)
                    + (root.ctx-selection-single ? 26px : 0px)          // Create a shortcut
                    + (root.ctx-selection-has-favorite-target ? 26px : 0px) // Add to favorites
                    + ((root.ctx-selection-has-dir || root.ctx-selection-single) ? 26px : 0px)) // Color & note
                + (root.ctx-custom-entries.length > 0 ? root.ctx-custom-entries.length * 26px + 1px : 0px)
                + (root.ctx-shell-entries.length > 0 ? root.ctx-shell-entries.length * 26px + 1px : 0px);
            background: Theme.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;

            // Catch-all: absorbs clicks in the menu's empty areas to
            // prevent propagation to the backdrop (which would close it).
            TouchArea { }

            // ----- Full menu: an entry (file/folder) is targeted -----
            if !root.ctx-on-empty : VerticalLayout {
                padding: 4px;
                spacing: 0px;

                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-open; shortcut: root.menu-shortcuts.open; clicked => { root.ctx-close(); root.action-open(); } }
                // File on Windows → "Open as administrator" ("new
                // tab" would only open the parent folder: not very useful). Otherwise
                // (folder, multiple selection, or Linux) → "new tab".
                if root.platform-windows && root.ctx-selection-is-file : MenuItem {
                    nav-level: root.ctx-full-nav-level > 0
                        && root.platform-windows && root.ctx-selection-is-file ? 1 : 0;
                    label: Strings.ctx-open-admin;
                    clicked => { root.ctx-close(); root.action-open-admin(); }
                }
                if !(root.platform-windows && root.ctx-selection-is-file) : MenuItem {
                    nav-level: root.ctx-full-nav-level > 0
                        && !(root.platform-windows && root.ctx-selection-is-file) ? 1 : 0;
                    label: Strings.ctx-open-new-tab;
                    clicked => { root.ctx-close(); root.action-open-new-tab(); }
                }
                if root.ctx-selection-single && root.ctx-selection-is-dir : SubmenuRow {
                    nav-level: root.ctx-full-nav-level > 0
                        && root.ctx-selection-single && root.ctx-selection-is-dir ? 1 : 0;
                    label: Strings.ctx-open-new-pane;
                    open: root.folder-menu-open && !root.folder-menu-reveal;
                    flyout-hover: root.folder-flyout-hover;
                    show(at) => { root.folder-menu-reveal = false; root.folder-menu-at = at; root.folder-menu-open = true; }
                    hovered(h) => { root.folder-pane-parent-hover = h; }
                }
                // "Open with" → flyout on HOVER (the parent menu stays open).
                // Files only: a folder is opened by navigating into it, not by
                // handing it to an application.
                if !root.ctx-selection-is-dir : SubmenuRow {
                    nav-level: root.ctx-full-nav-level > 0
                        && !root.ctx-selection-is-dir ? 1 : 0;
                    label: Strings.ctx-open-with;
                    open: root.ow-menu-open;
                    flyout-hover: root.ow-flyout-hover;
                    show(at) => { root.ow-menu-at = at; root.ow-menu-open = true; }
                    hovered(h) => { root.ow-parent-hover = h; }
                }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-open-parent; clicked => { root.ctx-close(); root.action-open-parent(); } }
                if root.ctx-can-reveal-result : SubmenuRow {
                    nav-level: root.ctx-full-nav-level > 0 && root.ctx-can-reveal-result ? 1 : 0;
                    // Names the action rather than its target, like every
                    // other entry around it, and says it with the string its
                    // own first child already carries.
                    label: Strings.search-reveal;
                    open: root.folder-reveal-open;
                    flyout-hover: root.folder-flyout-hover;
                    show(at) => { root.folder-menu-reveal = true; root.folder-menu-at = at; root.folder-menu-open = true; }
                    hovered(h) => { root.folder-reveal-parent-hover = h; }
                }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-open-terminal; shortcut: root.menu-shortcuts.terminal; clicked => { root.ctx-close(); root.action-open-terminal(); } }
                // Pinned user commands — filtered by the bridge
                // based on the target (file / folder).
                if root.ctx-custom-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for cc in root.ctx-custom-entries : IconMenuRow {
                    nav-level: root.ctx-full-nav-level;
                    label: cc.label;
                    icon: cc.icon;
                    icon-kind: cc.icon-kind;
                    clicked => { root.ctx-close(); root.ctx-custom-run(cc.id); }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-copy; shortcut: root.menu-shortcuts.copy; clicked => { root.ctx-close(); root.action-copy(); } }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-cut; shortcut: root.menu-shortcuts.cut; clicked => { root.ctx-close(); root.action-cut(); } }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-paste; shortcut: root.menu-shortcuts.paste; clicked => { root.ctx-close(); root.action-paste(); } }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-duplicate; clicked => { root.ctx-close(); root.action-duplicate(); } }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-copy-path; clicked => { root.ctx-close(); root.action-copy-path(); } }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-copy-name; clicked => { root.ctx-close(); root.action-copy-name(); } }
                if root.ctx-selection-has-favorite-target : MenuItem {
                    nav-level: root.ctx-full-nav-level > 0
                        && root.ctx-selection-has-favorite-target ? 1 : 0;
                    label: Strings.fav-add;
                    clicked => { root.ctx-close(); root.fav-add-selection(); }
                }
                // "Create a shortcut" — any SINGLE item, file or folder: opens
                // the popup (.lnk shortcut / symlink tabs) creating a link in the
                // current folder to it. Folders link fine (junction on Windows,
                // symlink on Linux, or a .lnk pointing at the folder).
                if root.ctx-selection-single : MenuItem {
                    nav-level: root.ctx-full-nav-level > 0
                        && root.ctx-selection-single ? 1 : 0;
                    label: Strings.ctx-create-link;
                    clicked => { root.ctx-close(); root.action-create-link(); }
                }
                // Annotations Favnyr keeps ABOUT the item, which is what this
                // block already gathers — copy path, copy name, add to
                // favorites. Nothing here touches a byte on disk.
                // Shown when there is something to offer: a folder to colour,
                // or a lone item to annotate.
                if root.ctx-selection-has-dir || root.ctx-selection-single : SubmenuRow {
                    nav-level: root.ctx-full-nav-level > 0
                        && (root.ctx-selection-has-dir || root.ctx-selection-single) ? 1 : 0;
                    label: Strings.ctx-mark;
                    open: root.mark-menu-open && root.mark-target-kind == 0;
                    flyout-hover: root.mark-flyout-hover;
                    show(at) => {
                        root.mark-target-kind = 0;
                        root.mark-menu-at = at;
                        root.mark-menu-open = true;
                    }
                    hovered(h) => { root.mark-parent-hover = h; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-rename; shortcut: root.menu-shortcuts.rename; clicked => { root.ctx-close(); root.action-rename(); } }
                MenuItem { nav-level: root.ctx-full-nav-level; label: root.ctx-selection-in-trash ? Strings.net-delete-confirm : Strings.ctx-delete; shortcut: root.menu-shortcuts.delete; clicked => { root.ctx-close(); root.action-delete(); } }
                // WINDOWS context menu entries (shell extensions).
                if root.ctx-shell-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for se in root.ctx-shell-entries : ShellMenuRow {
                    nav-level: root.ctx-full-nav-level;
                    entry: se;
                    sub-open: root.ctx-shell-sub-open && se.has-sub && root.ctx-shell-sub-for == se.sub;
                    flyout-hover: root.ctx-shell-sub-flyout-hover;
                    run(id) => { root.ctx-close(); root.ctx-shell-run(id); }
                    hover-changed(h) => {
                        if (se.has-sub) { root.ctx-shell-sub-parent-hover = h; }
                        else if (h) { root.ctx-shell-sub-open = false; }
                    }
                    sub-hover(at) => {
                        root.ctx-shell-sub-at = at;
                        root.ctx-shell-sub-for = se.sub;
                        root.ctx-shell-sub-hover(se.sub);
                        root.ctx-shell-sub-open = true;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { nav-level: root.ctx-full-nav-level; label: Strings.ctx-properties; shortcut: root.menu-shortcuts.properties; clicked => { root.ctx-close(); root.action-properties(); } }
            }

            // ----- Reduced menu: right-click on a blank area -----
            // No Copy/Cut/Duplicate/Rename/Delete (no target).
            // Actions target the current folder (Paste, path, name…).
            if root.ctx-on-empty : VerticalLayout {
                padding: 4px;
                spacing: 0px;

                // Unified "New" entry → flyout on HOVER (folder / file
                // / shortcut). SAME mechanism as "Open with".
                SubmenuRow {
                    nav-level: root.ctx-empty-nav-level;
                    label: Strings.ctx-new;
                    open: root.new-menu-open;
                    flyout-hover: root.new-flyout-hover;
                    show(at) => { root.new-menu-at = at; root.new-menu-open = true; }
                    hovered(h) => { root.new-parent-hover = h; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { nav-level: root.ctx-empty-nav-level; label: Strings.ctx-paste; shortcut: root.menu-shortcuts.paste; clicked => { root.ctx-close(); root.action-paste(); } }
                MenuItem { nav-level: root.ctx-empty-nav-level; label: Strings.ctx-open-parent; clicked => { root.ctx-close(); root.action-open-parent(); } }
                MenuItem { nav-level: root.ctx-empty-nav-level; label: Strings.ctx-open-terminal; shortcut: root.menu-shortcuts.terminal; clicked => { root.ctx-close(); root.action-open-terminal(); } }
                // Commands pinned to the view BACKGROUND, e.g. a shell
                // started here; they target the current folder.
                if root.ctx-custom-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for cc in root.ctx-custom-entries : IconMenuRow {
                    nav-level: root.ctx-empty-nav-level;
                    label: cc.label;
                    icon: cc.icon;
                    icon-kind: cc.icon-kind;
                    clicked => { root.ctx-close(); root.ctx-custom-run(cc.id); }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { nav-level: root.ctx-empty-nav-level; label: Strings.ctx-copy-path; clicked => { root.ctx-close(); root.action-copy-path(); } }
                MenuItem { nav-level: root.ctx-empty-nav-level; label: Strings.ctx-copy-name; clicked => { root.ctx-close(); root.action-copy-name(); } }
                // WINDOWS context menu entries for the CURRENT FOLDER —
                // queried "as an item" (this exposes the
                // full menus of archivers, shells, comparison tools…).
                if root.ctx-shell-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for se in root.ctx-shell-entries : ShellMenuRow {
                    nav-level: root.ctx-empty-nav-level;
                    entry: se;
                    sub-open: root.ctx-shell-sub-open && se.has-sub && root.ctx-shell-sub-for == se.sub;
                    flyout-hover: root.ctx-shell-sub-flyout-hover;
                    run(id) => { root.ctx-close(); root.ctx-shell-run(id); }
                    hover-changed(h) => {
                        if (se.has-sub) { root.ctx-shell-sub-parent-hover = h; }
                        else if (h) { root.ctx-shell-sub-open = false; }
                    }
                    sub-hover(at) => {
                        root.ctx-shell-sub-at = at;
                        root.ctx-shell-sub-for = se.sub;
                        root.ctx-shell-sub-hover(se.sub);
                        root.ctx-shell-sub-open = true;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { nav-level: root.ctx-empty-nav-level; label: Strings.ctx-properties; shortcut: root.menu-shortcuts.properties; clicked => { root.ctx-close(); root.action-properties(); } }
            }
        }

        // ===== "Split" menu =====
        // Opened by a panel's split token. Transparent backdrop that
        // closes on an outside click; acts on the active panel (the token
        // activated it beforehand) via `panel-split`.
        // (no more backdrop — unified closing via close-ctx-menus/Dismiss.)
        if root.split-menu-open : Rectangle {
            x: Flyout.pinned-x(root.split-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.split-menu-y, self.height, root.height);
            width: 224px;
            // Two split rows, then a filet and the equalizer — which only
            // exists to offer once there is more than one view to even out.
            height: root.equalize-available ? 123px : 82px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;

            // Catch-all: absorbs clicks in the menu's empty areas.
            TouchArea { }

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                SplitMenuItem {
                    label: Strings.split-side-by-side;
                    icon: @image-url("../../assets/icons/split.svg");
                    shortcut: root.menu-shortcuts.split-side;
                    clicked => { root.split-menu-open = false; root.panel-split(0); }
                }
                SplitMenuItem {
                    label: Strings.split-stacked;
                    icon: @image-url("../../assets/icons/split-stacked.svg");
                    shortcut: root.menu-shortcuts.split-stack;
                    clicked => { root.split-menu-open = false; root.panel-split(1); }
                }
                // The menu has no place on screen, so it cannot aim at one
                // separator: it evens out the whole layout, and says so. While
                // a way back is held, the same row offers it instead — the
                // menu can afford to change its wording where a separator,
                // which has none, cannot.
                if root.equalize-available : Rectangle {
                    height: 5px;
                    Rectangle {
                        y: 2px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                if root.equalize-available : SplitMenuItem {
                    label: root.equalize-undone
                        ? Strings.equalize-restore
                        : Strings.equalize-all;
                    icon: @image-url("../../assets/icons/equalize.svg");
                    shortcut: root.menu-shortcuts.equalize;
                    clicked => { root.split-menu-open = false; root.equalize-views(-1); }
                }
            }
        }

        if root.sort-menu-open && root.sort-menu-panel >= 0
                && root.sort-menu-panel < root.panels.length : sort-popup := Rectangle {
            property <bool> has-secondary: root.panels[root.sort-menu-panel].secondary-sort-column != "";
            property <string> secondary-preview-column: self.has-secondary
                ? root.panels[root.sort-menu-panel].secondary-sort-column
                : (root.panels[root.sort-menu-panel].sort-column == "name" ? "modified" : "name");
            property <bool> date-primary: root.panels[root.sort-menu-panel].sort-column == "modified"
                || root.panels[root.sort-menu-panel].sort-column == "created"
                || root.panels[root.sort-menu-panel].sort-column == "age";
            property <bool> fewer-secondary-columns: root.panels[root.sort-menu-panel].sort-column == "modified"
                || root.panels[root.sort-menu-panel].sort-column == "age";
            x: Flyout.pinned-x(root.sort-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.sort-menu-y, self.height, root.height);
            width: 224px;
            height: root.sort-menu-page == 1 ? 296px
                : root.sort-menu-page == 2 ? (self.fewer-secondary-columns ? 224px : 260px)
                : 233px + (self.date-primary ? 36px : 0px);
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                if root.sort-menu-page == 0 : TabBarMenuItem {
                    label: Strings.sort-primary;
                    selected: true;
                    interactive: false;
                }
                if root.sort-menu-page == 0 : TabBarMenuItem {
                    label: root.sort-column-label(root.panels[root.sort-menu-panel].sort-column);
                    icon: @image-url("../../assets/icons/caret-down.svg");
                    clicked => { root.sort-menu-page = 1; }
                }
                if root.sort-menu-page == 0 : TabBarMenuItem {
                    label: root.panels[root.sort-menu-panel].sort-asc
                        ? Strings.sort-ascending : Strings.sort-descending;
                    icon: root.panels[root.sort-menu-panel].sort-asc
                        ? @image-url("../../assets/icons/arrow-up.svg")
                        : @image-url("../../assets/icons/arrow-down.svg");
                    clicked => {
                        root.panel-clicked(root.sort-menu-panel);
                        root.sort-clicked(root.panels[root.sort-menu-panel].sort-column);
                    }
                }
                if root.sort-menu-page == 0 : Rectangle {
                    height: 9px;
                    Rectangle { y: 4px; height: 1px; background: Theme.border; }
                }
                if root.sort-menu-page == 0 : TabBarMenuItem {
                    label: Strings.sort-secondary;
                    selected: sort-popup.has-secondary;
                    clicked => {
                        root.panel-clicked(root.sort-menu-panel);
                        root.secondary-sort-action("toggle");
                    }
                }
                if root.sort-menu-page == 0 : TabBarMenuItem {
                    label: root.sort-column-label(sort-popup.secondary-preview-column);
                    icon: @image-url("../../assets/icons/caret-down.svg");
                    interactive: sort-popup.has-secondary;
                    opacity: sort-popup.has-secondary ? 1.0 : 0.45;
                    clicked => { root.sort-menu-page = 2; }
                }
                if root.sort-menu-page == 0 : TabBarMenuItem {
                    label: root.panels[root.sort-menu-panel].secondary-sort-asc
                        ? Strings.sort-ascending : Strings.sort-descending;
                    icon: root.panels[root.sort-menu-panel].secondary-sort-asc
                        ? @image-url("../../assets/icons/arrow-up.svg")
                        : @image-url("../../assets/icons/arrow-down.svg");
                    interactive: sort-popup.has-secondary;
                    opacity: sort-popup.has-secondary ? 1.0 : 0.45;
                    clicked => {
                        root.panel-clicked(root.sort-menu-panel);
                        root.secondary-sort-action("reverse");
                    }
                }
                if root.sort-menu-page == 0 && sort-popup.date-primary : TabBarMenuItem {
                    label: Strings.sort-by-day;
                    selected: root.panels[root.sort-menu-panel].group-dates-by-day;
                    interactive: sort-popup.has-secondary;
                    opacity: sort-popup.has-secondary ? 1.0 : 0.45;
                    clicked => {
                        root.panel-clicked(root.sort-menu-panel);
                        root.secondary-sort-action("day");
                    }
                }
                if root.sort-menu-page != 0 : TabBarMenuItem {
                    label: root.sort-menu-page == 1
                        ? Strings.sort-primary : Strings.sort-secondary;
                    icon: @image-url("../../assets/icons/arrow-left.svg");
                    clicked => { root.sort-menu-page = 0; }
                }
                for option in [
                    { code: "name", label: Strings.col-name },
                    { code: "path", label: Strings.col-path },
                    { code: "size", label: Strings.col-size },
                    { code: "modified", label: Strings.col-modified },
                    { code: "created", label: Strings.col-created },
                    { code: "age", label: Strings.col-age },
                    { code: "ext", label: Strings.col-ext },
                ] : TabBarMenuItem {
                    visible: root.sort-menu-page == 1
                        || (root.sort-menu-page == 2
                            && option.code != root.panels[root.sort-menu-panel].sort-column
                            && !(option.code == "age" && root.panels[root.sort-menu-panel].sort-column == "modified")
                            && !(option.code == "modified" && root.panels[root.sort-menu-panel].sort-column == "age"));
                    height: self.visible ? 36px : 0px;
                    label: option.label;
                    selected: root.sort-menu-page == 2
                        ? root.panels[root.sort-menu-panel].secondary-sort-column == option.code
                        : root.panels[root.sort-menu-panel].sort-column == option.code;
                    clicked => {
                        root.panel-clicked(root.sort-menu-panel);
                        if (root.sort-menu-page == 2) {
                            if (root.panels[root.sort-menu-panel].secondary-sort-column != option.code) {
                                root.secondary-sort-action(option.code);
                            }
                        } else if (root.panels[root.sort-menu-panel].sort-column != option.code) {
                            root.sort-clicked(option.code);
                        }
                        root.sort-menu-page = 0;
                    }
                }
            }
        }
        if root.display-menu-open && root.display-menu-panel >= 0
                && root.display-menu-panel < root.panels.length : Rectangle {
            x: Flyout.pinned-x(root.display-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.display-menu-y, self.height, root.height);
            width: 224px;
            height: 164px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/list.svg");
                    label: Strings.view-layout-list;
                    selected: !root.panels[root.display-menu-panel].grid-mode;
                    clicked => {
                        root.display-menu-open = false;
                        root.set-item-arrangement(root.display-menu-panel, false);
                    }
                }
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/grid.svg");
                    label: Strings.view-layout-grid;
                    selected: root.panels[root.display-menu-panel].grid-mode;
                    clicked => {
                        root.display-menu-open = false;
                        root.set-item-arrangement(root.display-menu-panel, true);
                    }
                }
                Rectangle { height: 1px; background: Tokens.hairline; }
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/file.svg");
                    label: Strings.settings-view-mode-list;
                    selected: !root.panels[root.display-menu-panel].preview-mode;
                    clicked => {
                        root.display-menu-open = false;
                        if (root.panels[root.display-menu-panel].preview-mode) {
                            root.toggle-preview-mode(root.display-menu-panel);
                        }
                    }
                }
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/image.svg");
                    label: Strings.settings-view-mode-previews;
                    selected: root.panels[root.display-menu-panel].preview-mode;
                    clicked => {
                        root.display-menu-open = false;
                        if (!root.panels[root.display-menu-panel].preview-mode) {
                            root.toggle-preview-mode(root.display-menu-panel);
                        }
                    }
                }
            }
        }

        // ===== "Tab bar position" menu =====
        // 3 radio options (checkmark on the current mode), per view.
        if root.tabbar-menu-open : Rectangle {
            x: Flyout.pinned-x(root.tabbar-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.tabbar-menu-y, self.height, root.height);
            width: 224px;
            height: 120px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;

            // Catch-all: absorbs clicks in the menu's empty areas.
            TouchArea { }

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/tabs-top.svg");
                    label: Strings.tabbar-top;
                    selected: root.tabbar-menu-mode == 0;
                    clicked => {
                        root.tabbar-menu-open = false;
                        root.set-tab-bar-mode(root.tabbar-menu-panel, 0);
                    }
                }
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/tabs-left.svg");
                    label: Strings.tabbar-left;
                    selected: root.tabbar-menu-mode == 1;
                    clicked => {
                        root.tabbar-menu-open = false;
                        root.set-tab-bar-mode(root.tabbar-menu-panel, 1);
                    }
                }
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/tabs-right.svg");
                    label: Strings.tabbar-right;
                    selected: root.tabbar-menu-mode == 2;
                    clicked => {
                        root.tabbar-menu-open = false;
                        root.set-tab-bar-mode(root.tabbar-menu-panel, 2);
                    }
                }
            }
        }

        // ===== URL bar menu (right-click): Paste / Copy path =====
        if root.url-menu-open : Rectangle {
            x: Flyout.pinned-x(root.url-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.url-menu-y, self.height, root.height);
            width: 220px;
            height: 64px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    label: Strings.ctx-copy;     // "Copy"
                    clicked => { root.url-menu-open = false; root.url-copy-serial += 1; }
                }
                MenuItem {
                    label: Strings.ctx-paste;    // "Paste"
                    clicked => { root.url-menu-open = false; root.url-paste-serial += 1; }
                }
            }
        }

        // ===== Trash context menu (sidebar): Empty (two-step) =====
        if root.trash-menu-open : Rectangle {
            x: Flyout.pinned-x(root.trash-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.trash-menu-y, self.height, root.height);
            width: 220px;
            height: 40px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: root.trash-menu-confirm
                        ? Tokens.danger.with-alpha(empty-touch.has-hover ? 0.34 : 0.20)
                        : (empty-touch.has-hover ? Tokens.danger.with-alpha(0.14) : transparent);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            // 1st click: "Empty trash"; 2nd: confirmation.
                            text: root.trash-menu-confirm
                                ? Strings.sidebar-empty-trash-confirm
                                : Strings.sidebar-empty-trash;
                            color: Tokens.danger;
                            font-size: 12px;
                            font-weight: root.trash-menu-confirm ? 700 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    empty-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.trash-menu-confirm) {
                                root.trash-menu-open = false;
                                root.empty-trash();
                            } else {
                                root.trash-menu-confirm = true;
                            }
                        }
                    }
                }
            }
        }

        // ===== Drive / Network context menu (sidebar) =====
        // Actions: open in a new tab · copy path · (removable)
        // safely remove · (mapped network, device = letter) disconnect.
        if root.drive-menu-open : dmenu := Rectangle {
            // Item count: open + copy (2) + eject? + disconnect?
            property <bool> can-eject: root.drive-menu-removable && root.drive-menu-device != "";
            property <bool> can-disconnect: root.drive-menu-kind == 4 && root.drive-menu-device != "";
            property <int> item-count: 2 + (self.can-eject ? 1 : 0) + (self.can-disconnect ? 1 : 0);
            x: Flyout.pinned-x(root.drive-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.drive-menu-y, self.height, root.height);
            width: 240px;
            height: 8px + self.item-count * 30px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    label: Strings.ctx-open-new-tab;
                    clicked => { root.drive-menu-open = false; root.place-open-new-tab(root.drive-menu-path, root.drive-menu-kind); }
                }
                MenuItem {
                    label: Strings.ctx-copy-path;
                    clicked => { root.drive-menu-open = false; root.place-copy-path(root.drive-menu-path); }
                }
                if dmenu.can-eject : MenuItem {
                    label: root.drive-menu-hotplug
                        ? Strings.net-eject
                        : Strings.net-release;
                    clicked => { root.drive-menu-open = false; root.drive-eject(root.drive-menu-device, root.drive-menu-hotplug); }
                }
                if dmenu.can-disconnect : MenuItem {
                    label: Strings.net-disconnect;
                    clicked => { root.drive-menu-open = false; root.drive-disconnect(root.drive-menu-device); }
                }
            }
        }

        if root.ow-menu-open : Rectangle {
            x: Flyout.cascade-x(root.ow-menu-at, self.width, root.width);
            y: Flyout.cascade-y(root.ow-menu-at, self.height, root.height);
            width: 240px;
            height: 8px
                + root.openers-suggested.length * 26px
                + (root.openers-suggested.length > 0 ? 8px : 0px)
                + 26px /* Choose an application */
                + 26px /* Custom command */
                + (root.selection-is-executable ? 26px : 0px)
                + 8px + 26px /* Manage */;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            // Tracks the flyout's hover state (for the deferred close). The content
            // is INSIDE the TouchArea → has-hover stays stable even while
            // hovering the items (see the WorkspaceRow pattern).
            TouchArea {
                changed has-hover => { root.ow-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    // Recent opener row: app icon (generic fallback) + label.
                    for op in root.openers-suggested : Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: (sug-ta.has-hover || nav-on) ? Theme.alternate-background : transparent;
                        // Keyboard navigation, as in `MenuItem` — this row is
                        // drawn by hand rather than with that component.
                        property <int> nav-level: root.ctx-ow-nav-level;
                        property <bool> nav-on: CtxNav.on(self.nav-level, self.y);
                        property <int> nav-poll: CtxNav.poll;
                        changed nav-poll => { CtxNav.offer(self.nav-level, self.y); }
                        property <int> activate-watch: CtxNav.activate;
                        changed activate-watch => {
                            if (self.nav-on) {
                                root.ctx-close();
                                root.run-opener(op.id);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 10px;
                            CommandIcon {
                                kind: op.icon-kind;
                                extracted: op.icon;
                            }
                            Text {
                                text: op.label;
                                font-size: 12px;
                                color: Theme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                        sug-ta := TouchArea {
                            // `ctx-close` closes the parent menu AND the flyout (via
                            // `changed ctx-menu-open`), like the normal items.
                            clicked => { root.ctx-close(); root.run-opener(op.id); }
                            changed has-hover => {
                                if (self.has-hover) { CtxNav.point(parent.nav-level, parent.y); }
                            }
                        }
                    }
                if root.openers-suggested.length > 0 : Rectangle {
                    height: 8px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                MenuItem {
                    nav-level: root.ctx-ow-nav-level;
                    label: Strings.ow-choose;
                    clicked => { root.ctx-close(); root.ow-open-picker(); }
                }
                MenuItem {
                    nav-level: root.ctx-ow-nav-level;
                    label: Strings.ow-custom;
                    clicked => { root.ctx-close(); root.ow-add(); }
                }
                if root.selection-is-executable : MenuItem {
                    nav-level: root.ctx-ow-nav-level > 0
                        && root.selection-is-executable ? 2 : 0;
                    label: Strings.ow-use-as-app;
                    clicked => { root.ctx-close(); root.ow-use-as-app(); }
                }
                Rectangle {
                    height: 8px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                MenuItem {
                    nav-level: root.ctx-ow-nav-level;
                    label: Strings.ow-manage;
                    // Directly opens the "Open with" tab of Settings.
                    clicked => {
                        root.ctx-close();
                        root.settings-tab = 2;
                        // "Manage applications" always targets the Favnyr
                        // applications list, never the last Windows
                        // sub-tab remembered from a previous visit.
                        root.ow-subtab = 0;
                        root.settings-open = true;
                    }
                }
                }
            }
        }

        // Folder navigation uses the same rows and keyboard scope as other flyouts.
        if root.folder-menu-open : Rectangle {
            x: Flyout.cascade-x(root.folder-menu-at, self.width, root.width);
            y: Flyout.cascade-y(root.folder-menu-at, self.height, root.height);
            width: root.folder-menu-reveal ? 340px : 200px;
            height: 60px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea {
                changed has-hover => { root.folder-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    MenuItem {
                        nav-level: root.ctx-folder-nav-level;
                        enabled: root.folder-menu-reveal || root.can-add-panel;
                        label: root.folder-menu-reveal ? Strings.search-reveal : Strings.split-side-by-side;
                        clicked => {
                            let reveal = root.folder-menu-reveal;
                            root.ctx-close();
                            if (reveal) { root.action-reveal-result(false); }
                            else { root.action-open-new-pane(0); }
                        }
                    }
                    MenuItem {
                        nav-level: root.ctx-folder-nav-level;
                        enabled: root.folder-menu-reveal || root.can-add-panel;
                        label: root.folder-menu-reveal ? Strings.search-reveal-new-tab : Strings.split-stacked;
                        clicked => {
                            let reveal = root.folder-menu-reveal;
                            root.ctx-close();
                            if (reveal) { root.action-reveal-result(true); }
                            else { root.action-open-new-pane(1); }
                        }
                    }
                }
            }
        }

        // ===== "New" submenu (flyout on hover) =====
        // Same mechanism as "Open with" above (no backdrop: the parent
        // menu stays active). Opens the creation popup with the right `create-kind`.
        if root.new-menu-open : Rectangle {
            x: Flyout.cascade-x(root.new-menu-at, self.width, root.width);
            y: Flyout.cascade-y(root.new-menu-at, self.height, root.height);
            width: 200px;
            height: 8px + (root.platform-windows ? 3 : 2) * 26px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea {
                changed has-hover => { root.new-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    MenuItem {
                        nav-level: root.ctx-new-nav-level;
                        label: Strings.ctx-new-folder;
                        clicked => { root.ctx-close(); root.create-kind = 0; root.create-name = ""; root.create-target = ""; root.create-popup-open = root.search-root-action-allowed(); }
                    }
                    MenuItem {
                        nav-level: root.ctx-new-nav-level;
                        label: Strings.ctx-new-file;
                        clicked => { root.ctx-close(); root.create-kind = 1; root.create-name = ""; root.create-target = ""; root.create-popup-open = root.search-root-action-allowed(); }
                    }
                    // .lnk shortcut: Windows ONLY (a concept absent on Linux,
                    // where symbolic links are followed natively).
                    if root.platform-windows : MenuItem {
                        nav-level: root.ctx-new-nav-level > 0
                            && root.platform-windows ? 2 : 0;
                        label: Strings.ctx-new-shortcut;
                        clicked => { root.ctx-close(); root.create-kind = 2; root.create-name = ""; root.create-target = ""; root.create-shortcut-folder = true; root.create-popup-open = root.search-root-action-allowed(); }
                    }
                }
            }
        }

        // ===== Windows shell menu CASCADE flyout =====
        // Same mechanism as the "Open with" flyout: no backdrop, the parent
        // menu stays active; deferred close via the dedicated Timer.
        if root.ctx-shell-sub-open : Rectangle {
            x: Flyout.cascade-x(root.ctx-shell-sub-at, self.width, root.width);
            y: Flyout.cascade-y(root.ctx-shell-sub-at, self.height, root.height);
            width: 280px;
            height: 8px + root.ctx-shell-sub-entries.length * 26px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea {
                changed has-hover => { root.ctx-shell-sub-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    for se in root.ctx-shell-sub-entries : ShellMenuRow {
                        nav-level: root.ctx-shell-nav-level;
                        entry: se;
                        run(id) => { root.ctx-close(); root.ctx-shell-run(id); }
                    }
                }
            }
        }

        // ===== Home-grown application picker =====
        if root.ow-picker-open : ModalBackdrop {
            dismiss-on-click: true;
            dismiss => { root.ow-picker-open = false; }
        }
        if root.ow-picker-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(440px, parent.width - 24px);
            height: min(420px, parent.height - 24px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            // This catch-all absorbs clicks in the panel's empty areas. Only
            // a click outside the panel, received by the backdrop, closes the picker.
            TouchArea { }
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: Strings.ow-choose;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.foreground;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.platform-linux : CheckBox {
                        text: Strings.ow-display-other-apps;
                        checked <=> root.ow-picker-show-other-apps;
                        toggled => { root.ow-picker-show-other-apps-changed(self.checked); }
                    }
                }
                picker-search := SearchField {
                    placeholder-text: Strings.ow-search-placeholder;
                    text <=> root.ow-picker-search-text;
                    edited(value) => { root.ow-picker-search(value); }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.alternate-background.with-alpha(0.5);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;
                            if root.ow-picker-handlers.length == 0 : Text {
                                text: root.ow-picker-search-text == ""
                                    ? Strings.ow-empty
                                    : Strings.ow-no-results;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.45);
                                height: 40px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            for h in root.ow-picker-handlers : Rectangle {
                                height: 30px;
                                border-radius: 5px;
                                background: pick-ta.has-hover ? Theme.alternate-background : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 18px;
                                        height: parent.height;
                                        if h.icon.width > 0 : Image {
                                            source: h.icon;
                                            width: 16px;
                                            height: 16px;
                                            x: 0;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if h.icon.width == 0 : Image {
                                            width: 16px;
                                            x: 0;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../../assets/icons/application.svg");
                                            colorize: Theme.foreground.with-alpha(0.7);
                                        }
                                    }
                                    Text {
                                        text: h.label;
                                        font-size: 13px;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                                pick-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.ow-picker-open = false; root.ow-pick(h.id); }
                                }
                            }
                        }
                    }
                }
                // "Set as default": when the app is chosen, also saves the
                // file's extension as a Favnyr default (overrides the OS).
                CheckBox {
                    text: Strings.ow-set-default;
                    checked <=> root.ow-picker-set-default;
                }
                HorizontalBox {
                    padding: 0px;
                    // Browse the OS for a custom exe (like the "…" in Custom
                    // Command): the handler saves it as an opener then launches it.
                    Button {
                        text: Strings.ow-pick-browse;
                        clicked => { root.ow-pick-browse(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: Strings.btn-cancel; clicked => { root.ow-picker-open = false; } }
                }
            }
        }

        // ===== Promotion toast after the native dialog (Windows) =====
        if root.ow-promote-visible : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 18px;
            height: 40px;
            width: promo-row.preferred-width + 28px;
            border-radius: 10px;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.accent-background.with-alpha(0.45);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow.with-alpha(0.30);
            drop-shadow-offset-y: 3px;
            Timer { interval: 6s; running: root.ow-promote-visible; triggered => { root.ow-promote-visible = false; } }
            promo-row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 12px;
                Text { text: Strings.ow-promote; font-size: 12.5px; color: Theme.foreground; vertical-alignment: center; }
                Rectangle {
                    width: promo-btn-txt.preferred-width + 20px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: promo-ta.has-hover ? Theme.accent-background : Theme.accent-background.with-alpha(0.8);
                    promo-btn-txt := Text { text: Strings.ow-promote-add; font-size: 12px; color: Theme.accent-foreground; x: (parent.width - self.width)/2; vertical-alignment: center; height: parent.height; }
                    promo-ta := TouchArea { clicked => { root.ow-promote-visible = false; root.ow-promote-accept(); } }
                }
            }
        }

        // The New folder, Expand all, and Collapse all actions live
        // in the Favorites section's header.

        if root.fav-menu-open : Rectangle {
            x: Flyout.pinned-x(root.fav-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.fav-menu-y, self.height, root.height);
            width: 220px;
            height: root.fav-menu-container
                ? 120px
                : 126px + (root.fav-menu-is-dir ? 26px : 0px);
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                // --- CONTAINER ---
                if root.fav-menu-container : MenuItem {
                    label: Strings.fav-open-all;
                    clicked => { root.fav-menu-open = false; root.fav-open-all(root.fav-menu-id); }
                }
                if root.fav-menu-container : Rectangle {
                    height: 7px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                if root.fav-menu-container : MenuItem {
                    label: Strings.fav-new-subcontainer;
                    clicked => { root.fav-menu-open = false; root.open-fav-name(false, root.fav-menu-id, ""); }
                }
                if root.fav-menu-container : MenuItem {
                    label: Strings.fav-rename;
                    clicked => { root.fav-menu-open = false; root.open-fav-name(true, root.fav-menu-id, root.fav-menu-name); }
                }
                // Container deletion: 2nd click = confirmation (recursive).
                if root.fav-menu-container : Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: root.fav-menu-confirm-delete
                        ? Tokens.danger.with-alpha(fdc-touch.has-hover ? 0.34 : 0.20)
                        : (fdc-touch.has-hover ? Tokens.danger.with-alpha(0.14) : transparent);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.fav-menu-confirm-delete ? Strings.fav-delete-confirm : Strings.fav-delete;
                            color: Tokens.danger;
                            font-size: 12px;
                            font-weight: root.fav-menu-confirm-delete ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    fdc-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.fav-menu-confirm-delete) {
                                root.fav-menu-open = false;
                                root.fav-delete(root.fav-menu-id);
                            } else {
                                root.fav-menu-confirm-delete = true;
                            }
                        }
                    }
                }
                // --- FAVORITE ---
                if !root.fav-menu-container : MenuItem {
                    label: root.fav-menu-is-file
                        ? Strings.fav-execute
                        : Strings.fav-open;
                    clicked => { root.fav-menu-open = false; root.fav-open(root.fav-menu-id); }
                }
                if !root.fav-menu-container && root.fav-menu-is-dir : SubmenuRow {
                    label: Strings.ctx-mark;
                    open: root.mark-menu-open && root.mark-target-kind == 2;
                    flyout-hover: root.mark-flyout-hover;
                    show(at) => {
                        root.mark-target-kind = 2;
                        root.mark-current-color = root.fav-menu-folder-slot;
                        root.mark-menu-at = at;
                        root.mark-menu-open = true;
                    }
                    hovered(h) => { root.mark-parent-hover = h; }
                }
                if !root.fav-menu-container : Rectangle {
                    height: 7px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                if !root.fav-menu-container : MenuItem {
                    label: Strings.fav-rename;
                    clicked => { root.fav-menu-open = false; root.open-fav-name(true, root.fav-menu-id, root.fav-menu-name); }
                }
                if !root.fav-menu-container : MenuItem {
                    label: Strings.fav-delete;
                    clicked => { root.fav-menu-open = false; root.fav-delete(root.fav-menu-id); }
                }
                if !root.fav-menu-container : Rectangle {
                    height: 7px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                if !root.fav-menu-container : MenuItem {
                    label: Strings.fav-copy-path;
                    clicked => { root.fav-menu-open = false; root.fav-copy-path(root.fav-menu-id); }
                }
            }
        }

        // ===== Context menu of a tab bar's dead zone =====
        if root.tab-empty-menu-open : Rectangle {
            x: Flyout.pinned-x(root.tab-empty-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.tab-empty-menu-y, self.height, root.height);
            width: 270px;
            height: 60px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    label: Strings.fav-save-all-tabs;
                    clicked => {
                        root.tab-empty-menu-open = false;
                        root.fav-save-all-tabs(root.tab-empty-menu-panel);
                    }
                }
                MenuItem {
                    label: Strings.tab-reopen-closed;
                    shortcut: root.menu-shortcuts.tab-reopen-closed;
                    enabled: root.closed-tabs-available;
                    clicked => {
                        root.tab-empty-menu-open = false;
                        root.reopen-last-closed-tab(root.tab-empty-menu-panel);
                    }
                }
            }
        }

        // ===== Context menu of a tab =====
        if root.tab-menu-open : Rectangle {
            x: Flyout.pinned-x(root.tab-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.tab-menu-y, self.height, root.height);
            width: 260px;
            height: 122px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    label: Strings.tab-duplicate;
                    clicked => {
                        root.tab-menu-open = false;
                        root.duplicate-tab(root.tab-menu-panel, root.tab-menu-tab);
                    }
                }
                SubmenuRow {
                    label: Strings.ctx-mark;
                    open: root.mark-menu-open && root.mark-target-kind == 1;
                    flyout-hover: root.mark-flyout-hover;
                    show(at) => {
                        root.mark-target-kind = 1;
                        root.mark-current-color = root.tab-menu-folder-slot;
                        root.mark-menu-at = at;
                        root.mark-menu-open = true;
                    }
                    hovered(h) => { root.mark-parent-hover = h; }
                }
                MenuItem {
                    label: Strings.fav-save-tab;
                    clicked => {
                        root.tab-menu-open = false;
                        root.fav-save-tab(root.tab-menu-panel, root.tab-menu-tab);
                    }
                }
                MenuItem {
                    label: Strings.fav-save-all-tabs;
                    clicked => {
                        root.tab-menu-open = false;
                        root.fav-save-all-tabs(root.tab-menu-panel);
                    }
                }
                // The tab bar's position is set from its dedicated
                // button in the navigation bar.
            }
        }

        // ===== "Colour & note" submenu (flyout on hover) =====
        // This shared flyout is declared after all three parent menus so it is
        // always painted above the view, favorite, or tab menu that opened it.
        if root.mark-menu-open : Rectangle {
            x: Flyout.cascade-x(root.mark-menu-at, self.width, root.width);
            y: Flyout.cascade-y(root.mark-menu-at, self.height, root.height);
            width: 240px;
            height: 8px
                + ((root.mark-target-kind != 0 || root.ctx-selection-has-dir) ? 26px : 0px)
                + ((root.mark-target-kind != 0 || root.ctx-selection-single) ? 26px : 0px);
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            // The content sits inside the touch area so its hover flag stays
            // active while the pointer is over a swatch or menu entry.
            TouchArea {
                changed has-hover => { root.mark-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    if root.mark-target-kind != 0 || root.ctx-selection-has-dir : FolderSwatchRow {
                        current: root.mark-current-color;
                        picked(slot) => {
                            root.close-mark-parent();
                            root.folder-color-picked(slot);
                        }
                    }
                    // The ellipsis indicates that a dialog follows.
                    if root.mark-target-kind != 0 || root.ctx-selection-single : MenuItem {
                        nav-level: root.ctx-mark-nav-level > 0
                            && (root.mark-target-kind != 0 || root.ctx-selection-single) ? 2 : 0;
                        label: Strings.ctx-comment;
                        clicked => { root.close-mark-parent(); root.open-comment-editor(); }
                    }
                }
            }
        }

        // ===== Modal popup for naming or renaming a favorites container =====
        // It shares the rules of the other naming popups: validation via
        // `is_valid_entry_name`, deferred focus, and a disabled button if the name is invalid.
        if root.fav-name-open : ModalBackdrop { }
        if root.fav-name-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 196px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            Timer {
                interval: 1ms;
                running: root.fav-name-focus-armed && !root.exit-warning-open;
                triggered => {
                    favname-edit.focus();
                    // Caret at the END of the line (no selection) — same behavior
                    // as a folder name (see rename-edit).
                    favname-edit.set-selection-offsets(99999, 99999);
                    root.fav-name-focus-armed = false;
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.fav-name-rename ? Strings.fav-rename : Strings.fav-new-container;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                favname-edit := EditLineEdit {
                    placeholder-text: Strings.create-placeholder;
                    text <=> root.fav-name-value;
                    edited(t) => { root.fav-name-check(t); }
                    accepted(t) => {
                        if (!root.fav-name-invalid && t != "") { root.fav-name-confirm(); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.fav-name-open = false; }
                    }
                    Button {
                        text: root.fav-name-rename ? Strings.rename-confirm : Strings.create-confirm;
                        primary: true;
                        enabled: !root.fav-name-invalid && root.fav-name-value != "";
                        clicked => { root.fav-name-confirm(); }
                    }
                }
            }
        }

        // ===== "Save as favorite" popup =====
        if root.fav-save-open : ModalBackdrop { }
        if root.fav-save-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 300px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: Strings.fav-popup-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                // Target (path, or "N items").
                Text {
                    text: root.fav-save-target;
                    color: Theme.foreground.with-alpha(0.7);
                    font-size: 12px;
                    overflow: elide;
                }
                // Alias (single item).
                if !root.fav-save-multi : Text {
                    text: Strings.fav-popup-alias;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 0.3px;
                    color: Theme.foreground.with-alpha(0.55);
                }
                if !root.fav-save-multi : fav-save-alias-edit := EditLineEdit {
                    text <=> root.fav-save-alias;
                }
                // Target container.
                Text {
                    text: Strings.fav-popup-container;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 0.3px;
                    color: Theme.foreground.with-alpha(0.55);
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    ComboBox {
                        model: root.fav-container-labels;
                        current-index <=> root.fav-container-index;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: Strings.fav-popup-new;
                        clicked => {
                            // Opens the creation sub-popup (name + parent container).
                            root.fav-newc-name = Strings.fav-new-container;
                            root.fav-newc-parent-index = root.fav-container-index;
                            root.fav-newc-open = true;
                            root.fav-newc-focus-armed = true;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.fav-save-open = false; }
                    }
                    Button {
                        text: Strings.fav-save;
                        primary: true;
                        enabled: root.fav-save-multi || root.fav-save-alias != "";
                        clicked => {
                            root.fav-save-commit(root.fav-save-alias, root.fav-container-index);
                            root.fav-save-open = false;
                        }
                    }
                }
            }
        }

        // ===== "New container" sub-popup (from the save flow) =====
        if root.fav-newc-open : ModalBackdrop { }
        if root.fav-newc-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: 210px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            Timer {
                interval: 1ms;
                running: root.fav-newc-focus-armed && !root.exit-warning-open;
                triggered => {
                    fav-newc-edit.focus();
                    fav-newc-edit.set-selection-offsets(0, 99999);
                    root.fav-newc-focus-armed = false;
                }
            }
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: Strings.fav-new-container;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                fav-newc-edit := EditLineEdit {
                    text <=> root.fav-newc-name;
                    accepted(t) => {
                        if (t != "") {
                            root.fav-save-new-container(t, root.fav-newc-parent-index);
                            root.fav-newc-open = false;
                        }
                    }
                }
                Text {
                    text: Strings.fav-popup-parent;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 0.3px;
                    color: Theme.foreground.with-alpha(0.55);
                }
                ComboBox {
                    model: root.fav-container-labels;
                    current-index <=> root.fav-newc-parent-index;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.fav-newc-open = false; }
                    }
                    Button {
                        text: Strings.fav-save;
                        primary: true;
                        enabled: root.fav-newc-name != "";
                        clicked => {
                            root.fav-save-new-container(root.fav-newc-name, root.fav-newc-parent-index);
                            root.fav-newc-open = false;
                        }
                    }
                }
            }
        }

        // ===== Columns menu (right-click on a header) =====
        // Lists ALL columns (check/uncheck). "name" (anchor) greyed out.
        if root.columns-menu-open : Rectangle {
            property <bool> grid-mode: root.panels[root.columns-menu-panel].grid-mode;
            property <[ColumnInfo]> cols: self.grid-mode ? [] : root.panels[root.columns-menu-panel].columns-menu;
            x: Flyout.pinned-x(root.columns-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.columns-menu-y, self.height, root.height);
            width: 270px;
            // Manual mode (52 + separator 9), grouping, columns, extension
            // filter and outer padding.
            height: self.cols.length * 30px + (self.grid-mode ? 250px : 259px)
                + (root.panels[root.columns-menu-panel].manual-order || self.grid-mode ? 0px : 36px);
            background: Theme.surface;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                Rectangle {
                    height: 52px;
                    border-radius: 4px;
                    background: moitem.has-hover ? Theme.alternate-background : transparent;
                    accessible-role: checkbox;
                    accessible-label: Strings.manual-order-label;
                    accessible-checked: root.panels[root.columns-menu-panel].manual-order;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 9px;
                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.panels[root.columns-menu-panel].manual-order
                                    ? Theme.accent-background : Theme.border;
                                background: root.panels[root.columns-menu-panel].manual-order
                                    ? Theme.accent-background : transparent;
                                if root.panels[root.columns-menu-panel].manual-order : Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.accent-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: Strings.manual-order-label;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.foreground;
                            }
                            Text {
                                text: Strings.manual-order-hint;
                                font-size: 9px;
                                color: Theme.foreground.with-alpha(0.55);
                                wrap: word-wrap;
                            }
                        }
                    }
                    moitem := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.manual-order-toggle(root.columns-menu-panel);
                            root.columns-menu-open = false;
                            key-scope.focus();
                        }
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                if !root.panels[root.columns-menu-panel].manual-order
                    && !root.panels[root.columns-menu-panel].grid-mode : TabBarMenuItem {
                    label: Strings.sort-secondary;
                    icon: @image-url("../../assets/icons/filter.svg");
                    clicked => {
                        root.show-sort-options(root.columns-menu-panel,
                            root.columns-menu-x, root.columns-menu-y);
                    }
                }
                // "Grouping" section: 4 exclusive modes -----
                // Marks (check.svg) the active mode; orthogonal to column
                // sorting (which remains driven by clicking the header).
                Text {
                    text: Strings.group-section;
                    font-size: 10px;
                    color: Theme.foreground.with-alpha(0.5);
                    height: 22px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
                for gopt[gi] in [
                    { code: "folders", label: Strings.group-folders-first },
                    { code: "colored", label: Strings.group-colored-folders-first },
                    { code: "files", label: Strings.group-files-first },
                    { code: "mixed", label: Strings.group-mixed },
                ] : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    opacity: root.panels[root.columns-menu-panel].manual-order ? 0.42 : 1.0;
                    background: gitem.has-hover && !root.panels[root.columns-menu-panel].manual-order
                        ? Theme.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 9px;
                        // Radio mark (check.svg if active), full-height slot.
                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            if gopt.code == root.panels[root.columns-menu-panel].group-mode : Image {
                                source: @image-url("../../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Theme.accent-background;
                            }
                        }
                        Text {
                            text: gopt.label;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    gitem := TouchArea {
                        enabled: !root.panels[root.columns-menu-panel].manual-order;
                        mouse-cursor: root.panels[root.columns-menu-panel].manual-order ? default : pointer;
                        clicked => {
                            root.set-group-mode(root.columns-menu-panel, gopt.code);
                            root.columns-menu-open = false;
                        }
                    }
                }
                // Separator between grouping and column visibility.
                if !root.panels[root.columns-menu-panel].grid-mode : Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                for col[ci] in parent.cols : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    opacity: col.id == "name" ? 0.5 : 1.0;   // anchor, not uncheckable
                    background: citem.has-hover && col.id != "name"
                        ? Theme.alternate-background
                        : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 9px;
                        // Checkbox (full-height slot → vertical centering).
                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: col.visible ? Theme.accent-background : Theme.border;
                                background: col.visible ? Theme.accent-background : transparent;
                                if col.visible : Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.accent-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: col.label;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    citem := TouchArea {
                        mouse-cursor: col.id == "name" ? default : pointer;
                        clicked => {
                            if (col.id != "name") {
                                root.column-toggle(root.columns-menu-panel, col.id, !col.visible);
                            }
                        }
                    }
                }
                // Separator before the extension filter option.
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                // "Filter by extension" option: checkable, unchecked by default.
                // Shows/hides the panel's input bar; closes the menu to
                // let the field take focus.
                Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    opacity: root.panels[root.columns-menu-panel].manual-order ? 0.42 : 1.0;
                    background: xfitem.has-hover && !root.panels[root.columns-menu-panel].manual-order
                        ? Theme.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 9px;
                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.panels[root.columns-menu-panel].ext-filter-on
                                    ? Theme.accent-background : Theme.border;
                                background: root.panels[root.columns-menu-panel].ext-filter-on
                                    ? Theme.accent-background : transparent;
                                if root.panels[root.columns-menu-panel].ext-filter-on : Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.accent-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: Strings.ext-filter-label;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    xfitem := TouchArea {
                        enabled: !root.panels[root.columns-menu-panel].manual-order;
                        mouse-cursor: root.panels[root.columns-menu-panel].manual-order ? default : pointer;
                        clicked => {
                            root.filter-take-keyboard = true;
                            root.ext-filter-toggle(root.columns-menu-panel);
                            root.columns-menu-open = false;
                            // Immediate keyboard focus → direct input with no click,
                            // like the type-ahead filter (no caret).
                            key-scope.focus();
                        }
                    }
                }
            }
        }

        // ===== Cross-view drag'n'drop drop menu =====
        // Move / Copy / Link here. Opened on release over another view.
        if root.file-drop-menu-open : Rectangle {
            x: Flyout.pinned-x(root.file-drop-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.file-drop-menu-y, self.height, root.height);
            width: 200px;
            height: 94px;
            background: Theme.surface;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    label: Strings.drop-move;
                    clicked => { root.file-drop-menu-open = false; root.file-drop-action(0); }
                }
                MenuItem {
                    label: Strings.drop-copy;
                    clicked => { root.file-drop-menu-open = false; root.file-drop-action(1); }
                }
                MenuItem {
                    label: Strings.drop-link;
                    clicked => { root.file-drop-menu-open = false; root.file-drop-action(2); }
                }
            }
        }

        if root.zoom-feedback-visible && !root.any-overlay-open : Rectangle {
            x: clamp(root.zoom-feedback-x + 16px, 4px, max(4px, root.width - self.width - 4px));
            y: clamp(root.zoom-feedback-y + 20px, 4px, max(4px, root.height - self.height - 4px));
            width: zoom-feedback-label.preferred-width + 16px;
            height: 24px;
            border-radius: 5px;
            background: Theme.surface.with-alpha(0.92);
            border-width: 1px;
            border-color: Theme.border;
            zoom-feedback-label := Text {
                x: 8px;
                text: root.zoom-feedback-text;
                font-size: 11px;
                color: Theme.foreground.with-alpha(0.8);
                vertical-alignment: center;
            }
        }

        // ===== Properties panel =====
        // Internal answer to "what is this item", used where no desktop file
        // manager offers its own dialog. The backdrop only absorbs clicks:
        // Escape or the close button dismiss it, like every other panel here.
        if root.prop-open : ModalBackdrop { }
        if root.prop-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: min(560px, parent.height - 40px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 0px;

                // ----- Title bar -----
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 10px;
                        Text {
                            text: Strings.prop-title;
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: close-prop-touch.has-hover
                                ? Tokens.danger.with-alpha(0.27)
                                : Tokens.danger.with-alpha(0.13);
                            border-width: 1px;
                            border-color: Tokens.danger.with-alpha(0.4);
                            Image {
                                source: @image-url("../../assets/icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: close-prop-touch.has-hover ? Tokens.danger : Theme.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            close-prop-touch := TouchArea {
                                clicked => { root.prop-open = false; root.prop-closed(); }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // ----- Tab bar -----
                Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 4px;
                        alignment: start;
                        PropTab {
                            label: Strings.prop-tab-general;
                            selected: root.prop-tab == 0;
                            clicked => { root.prop-tab = 0; }
                        }
                        if root.prop-has-permissions : PropTab {
                            label: Strings.prop-tab-permissions;
                            selected: root.prop-tab == 1;
                            clicked => { root.prop-tab = 1; }
                        }
                        PropTab {
                            label: Strings.prop-tab-checksums;
                            selected: root.prop-tab == 2;
                            clicked => { root.prop-tab = 2; }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // ----- General -----
                if root.prop-tab == 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        // Rows keep the height they ask for; without this the
                        // layout shares the leftover between them and the
                        // values drift apart from their labels.
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        // Icon and name, the item's identity.
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                Image {
                                    width: 40px;
                                    height: 40px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.prop-icon;
                                    image-fit: contain;
                                }
                            }
                            PropValueBox {
                                text: root.prop-name;
                                text-size: 14px;
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }

                        for row in root.prop-general-rows : HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 128px;
                                text: row.label;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.6);
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            PropValueBox {
                                text: row.value;
                            }
                        }
                    }
                }

                // ----- Checksums -----
                // Nothing is computed on opening: reading a large file costs
                // real time, and most visits to this panel never come here.
                if root.prop-tab == 2 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        if !root.prop-can-hash : Text {
                            text: Strings.prop-hash-folder;
                            font-size: 12px;
                            color: Theme.foreground.with-alpha(0.6);
                            wrap: word-wrap;
                        }

                        if root.prop-can-hash && root.prop-digest-rows.length == 0 && !root.prop-hashing : Text {
                            text: Strings.prop-hash-hint;
                            font-size: 12px;
                            color: Theme.foreground.with-alpha(0.6);
                            wrap: word-wrap;
                        }

                        if root.prop-can-hash && !root.prop-hashing : HorizontalLayout {
                            alignment: start;
                            Button {
                                text: Strings.prop-hash-compute;
                                clicked => { root.prop-hash-start(); }
                            }
                        }

                        if root.prop-hashing : VerticalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.alternate-background;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.prop-hash-progress;
                                    height: parent.height;
                                    border-radius: 3px;
                                    background: Theme.accent-background;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: Strings.prop-hash-cancel-label;
                                    clicked => { root.prop-hash-cancel(); }
                                }
                            }
                        }

                        // The digests are the only values here that cannot
                        // fit: a SHA-512 needs about 900 px at this size. They
                        // share one scrollbar so the four move together, which
                        // is what lets them be compared column by column.
                        //
                        // The names stay outside it. Scrolling a digest must
                        // not carry away the label saying which one it is.
                        if root.prop-digest-rows.length > 0 : HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                width: 64px;
                                spacing: PropDigest.gap;
                                alignment: start;
                                for row in root.prop-digest-rows : Text {
                                    height: PropDigest.row;
                                    text: row.label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.foreground.with-alpha(0.6);
                                    vertical-alignment: center;
                                }
                            }
                            // The box asks the layout for nothing and takes
                            // what the row leaves. Without it the scroll view
                            // would pass its content's width up, and the
                            // controls below would stretch to a SHA-512 again.
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                // The rows, their gaps, and the bar beneath
                                // them. Stated rather than derived from the
                                // content, which would make the height depend
                                // on a width that depends on the height.
                                height: root.prop-digest-rows.length * PropDigest.row
                                    + (root.prop-digest-rows.length - 1) * PropDigest.gap
                                    + PropDigest.bar;
                                ScrollView {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    VerticalLayout {
                                        spacing: PropDigest.gap;
                                        alignment: start;
                                        for row in root.prop-digest-rows : PropValue {
                                            height: PropDigest.row;
                                            text: row.value;
                                            font-size: 12px;
                                            font-family: "monospace";
                                        }
                                    }
                                }
                            }
                        }

                        if root.prop-digest-rows.length > 0 : Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        if root.prop-digest-rows.length > 0 : VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: Strings.prop-expected-label;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.6);
                            }
                            expected-field := LineEdit {
                                text: root.prop-expected;
                                font-size: 12px;
                                edited => { root.prop-expected-changed(expected-field.text); }
                            }
                            if root.prop-expected-verdict >= 0 : Text {
                                text: root.prop-expected-verdict == 1
                                    ? root.prop-expected-match
                                    : Strings.prop-expected-no-match;
                                font-size: 12px;
                                font-weight: 600;
                                color: root.prop-expected-verdict == 1 ? Tokens.success : Tokens.danger;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ----- Permissions -----
                // Unix only: the tab is absent elsewhere, so nothing here
                // needs to describe a platform that has no such notion.
                if root.prop-tab == 1 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        PropAccessRow {
                            label: Strings.prop-perm-owner;
                            choices: root.prop-access-labels-owner;
                            index: root.prop-access-owner;
                            chosen(i) => { root.prop-access-changed(0, i); }
                        }
                        PropAccessRow {
                            label: Strings.prop-perm-group;
                            choices: root.prop-access-labels-group;
                            index: root.prop-access-group;
                            chosen(i) => { root.prop-access-changed(1, i); }
                        }
                        PropAccessRow {
                            label: Strings.prop-perm-others;
                            choices: root.prop-access-labels-others;
                            index: root.prop-access-others;
                            chosen(i) => { root.prop-access-changed(2, i); }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 128px;
                                text: "";
                            }
                            CheckBox {
                                text: Strings.prop-perm-execute;
                                checked <=> root.prop-executable;
                                toggled => { root.prop-executable-changed(self.checked); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border; }

                        Text {
                            text: Strings.prop-perm-ownership;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.foreground;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 128px;
                                text: Strings.prop-perm-owner;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.6);
                                vertical-alignment: center;
                            }
                            PropValueBox {
                                text: root.prop-owner;
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 128px;
                                text: Strings.prop-perm-group;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.6);
                                vertical-alignment: center;
                            }
                            PropValueBox {
                                text: root.prop-group;
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 128px;
                                text: Strings.prop-perm-mode;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.6);
                                vertical-alignment: center;
                            }
                            PropValueBox {
                                text: root.prop-mode;
                            }
                        }
                    }
                }
            }
        }

        // ===== Settings panel =====
        // Same here: the backdrop only absorbs clicks, doesn't close it. Escape or X.
        if root.settings-open : ModalBackdrop { }
        if root.settings-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 560px;
            // 480 → 620: less scrolling to reach the bottom of the tabs
            // (long General, "Open with"). Bounded to the window to stay
            // visible on small screens.
            height: min(620px, parent.height - 40px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            // Catch-all BELOW the content (declared first = bottom of the
            // z-order → steals no click from the controls above): a click on an
            // inert part of the panel closes the floating menus, exactly as the
            // window's own catch-all does for the rail and the sidebar.
            TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) { Dismiss.serial += 1; }
                }
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Header
                Rectangle {
                    height: 50px;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        Text {
                            text: Strings.settings-title;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // Favnyr's version (discreet, to the right of the title).
                        Text {
                            text: "v" + root.app-version;
                            font-size: 12px;
                            color: Theme.foreground.with-alpha(0.45);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        Rectangle { width: 10px; }
                        // "X" button (subtle red)
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: close-settings-touch.has-hover ? Tokens.danger.with-alpha(0.27) : Tokens.danger.with-alpha(0.13);
                            border-width: 1px;
                            border-color: Tokens.danger.with-alpha(0.4);
                            Image {
                                source: @image-url("../../assets/icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: close-settings-touch.has-hover ? Tokens.danger : Theme.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            close-settings-touch := TouchArea {
                                clicked => { root.settings-open = false; }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // Tab bar: General | Shortcuts. The shortcuts page is
                // separate so there's no need to scroll through all of "General" anymore.
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    // -- "General" tab --
                    Rectangle {
                        height: 30px;
                        width: gen-tab-txt.preferred-width + 26px;
                        border-radius: 6px;
                        background: root.settings-tab == 0 ? Theme.accent-background.with-alpha(0.14)
                            : (gen-tab-touch.has-hover ? Theme.alternate-background : transparent);
                        gen-tab-txt := Text {
                            text: Strings.settings-tab-general;
                            x: (parent.width - self.width) / 2;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 12.5px;
                            font-weight: root.settings-tab == 0 ? 700 : 500;
                            color: root.settings-tab == 0 ? Theme.accent-background : Theme.foreground.with-alpha(0.75);
                        }
                        gen-tab-touch := TouchArea { clicked => { root.settings-tab = 0; } }
                    }
                    // -- "Shortcuts" tab --
                    Rectangle {
                        height: 30px;
                        width: sc-tab-txt.preferred-width + 26px;
                        border-radius: 6px;
                        background: root.settings-tab == 1 ? Theme.accent-background.with-alpha(0.14)
                            : (sc-tab-touch.has-hover ? Theme.alternate-background : transparent);
                        sc-tab-txt := Text {
                            text: Strings.settings-shortcuts-section;
                            x: (parent.width - self.width) / 2;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 12.5px;
                            font-weight: root.settings-tab == 1 ? 700 : 500;
                            color: root.settings-tab == 1 ? Theme.accent-background : Theme.foreground.with-alpha(0.75);
                        }
                        sc-tab-touch := TouchArea { clicked => { root.settings-tab = 1; } }
                    }
                    // "Open with" tab --
                    Rectangle {
                        height: 30px;
                        width: ow-tab-txt.preferred-width + 26px;
                        border-radius: 6px;
                        background: root.settings-tab == 2 ? Theme.accent-background.with-alpha(0.14)
                            : (ow-tab-touch.has-hover ? Theme.alternate-background : transparent);
                        ow-tab-txt := Text {
                            text: Strings.settings-openers-section;
                            x: (parent.width - self.width) / 2;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 12.5px;
                            font-weight: root.settings-tab == 2 ? 700 : 500;
                            color: root.settings-tab == 2 ? Theme.accent-background : Theme.foreground.with-alpha(0.75);
                        }
                        ow-tab-touch := TouchArea { clicked => { root.settings-tab = 2; } }
                    }
                    // "Storage" tab --
                    Rectangle {
                        height: 30px;
                        width: st-tab-txt.preferred-width + 26px;
                        border-radius: 6px;
                        background: root.settings-tab == 3 ? Theme.accent-background.with-alpha(0.14)
                            : (st-tab-touch.has-hover ? Theme.alternate-background : transparent);
                        st-tab-txt := Text {
                            text: Strings.settings-tab-storage;
                            x: (parent.width - self.width) / 2;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 12.5px;
                            font-weight: root.settings-tab == 3 ? 700 : 500;
                            color: root.settings-tab == 3 ? Theme.accent-background : Theme.foreground.with-alpha(0.75);
                        }
                        st-tab-touch := TouchArea { clicked => { root.settings-tab = 3; } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // Scrollable content — GENERAL tab
                if root.settings-tab == 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        // Cards keep the height they ask for. Without this the
                        // layout stretches them to fill the view whenever the
                        // panel is shorter than it, and each card hands the
                        // surplus down to its own rows, where it surfaces as
                        // stray space under a label.
                        alignment: start;
                        padding: 20px;
                        spacing: 18px;

                        // -- Card: the choices that apply to the whole
                        // application. All combo boxes take the same fixed
                        // width as the ones below, so every row in the panel
                        // has its control on the same vertical line.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-language;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    settings-lang := ComboBox {
                                        width: 200px;
                                        model: root.language-labels;
                                        current-index <=> root.language-index;
                                        selected(_) => { root.language-changed(settings-lang.current-index); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-appearance;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    settings-theme-appearance := ComboBox {
                                        width: 200px;
                                        enabled: !root.theme-loading;
                                        model: root.theme-appearance-labels;
                                        current-index <=> root.theme-appearance-index;
                                        selected(_) => { root.theme-appearance-changed(self.current-index); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-theme;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    WsIconBtn {
                                        icon: @image-url("../../assets/icons/folder.svg");
                                        tooltip: Strings.theme-folder;
                                        clicked => { root.open-themes-folder(); }
                                    }
                                    // Only a theme file can be read again, so the button
                                    // appears only when one is selected. Opening the list
                                    // below has the same effect, this saves the detour
                                    // while a palette is being adjusted.
                                    if root.theme-user-file : WsIconBtn {
                                        icon: @image-url("../../assets/icons/refresh.svg");
                                        tooltip: Strings.theme-reload;
                                        clicked => { root.reload-theme(); }
                                    }
                                    settings-theme := ComboBox {
                                        width: 200px;
                                        enabled: !root.theme-loading;
                                        model: root.theme-labels;
                                        current-index <=> root.theme-index;
                                        // A file added to or edited in the themes folder is picked
                                        // up here, so the list is scanned when it is opened rather
                                        // than watched. The scan runs off the UI thread and the
                                        // list updates under the pointer when it brings something
                                        // new.
                                        opened => { root.refresh-themes(); }
                                        selected(_) => { root.theme-changed(settings-theme.current-index); }
                                    }
                                }
                                if root.theme-status != "" : Text {
                                    text: root.theme-status;
                                    color: Tokens.warning;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-terminal;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    settings-terminal := ComboBox {
                                        width: 200px;
                                        model: root.terminal-labels;
                                        current-index <=> root.terminal-index;
                                        // Installing a terminal while Favnyr is running is
                                        // enough: the list is built when it is opened.
                                        opened => { root.refresh-terminals(); }
                                        selected(_) => { root.terminal-changed(settings-terminal.current-index); }
                                    }
                                }
                            }
                        }

                        // The three scale-related controls share one card so
                        // their scopes and effects remain easy to compare.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-ui-scale;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    settings-ui-scale := ComboBox {
                                        width: 160px;
                                        model: root.ui-scale-labels;
                                        current-index <=> root.ui-scale-index;
                                        selected(_) => {
                                            root.ui-scale-changed(settings-ui-scale.current-index);
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-view-text-size-title;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: Strings.settings-view-text-size-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    CheckBox {
                                        width: 24px;
                                        text: "";
                                        accessible-label: Strings.settings-view-text-size-toggle;
                                        checked <=> root.view-text-font-size-override;
                                        toggled => {
                                            root.view-text-font-size-override-changed(self.checked);
                                        }
                                    }
                                    SpinBox {
                                        width: 96px;
                                        minimum: 9;
                                        maximum: 20;
                                        enabled: root.view-text-font-size-override;
                                        value <=> root.view-text-font-size;
                                        edited(v) => { root.view-text-font-size-changed(v); }
                                    }
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        if root.view-text-font-size-override : WsIconBtn {
                                            icon: @image-url("../../assets/icons/refresh.svg");
                                            tooltip: Strings.shortcut-reset-tooltip;
                                            clicked => { root.view-text-font-size-reset(); }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-view-item-spacing-title;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: Strings.settings-view-item-spacing-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    Rectangle { width: 24px; }
                                    SpinBox {
                                        width: 96px;
                                        minimum: 0;
                                        maximum: 16;
                                        value <=> root.view-item-spacing;
                                        edited(v) => { root.view-item-spacing-changed(v); }
                                    }
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        if root.view-item-spacing != 0 : WsIconBtn {
                                            icon: @image-url("../../assets/icons/refresh.svg");
                                            tooltip: Strings.shortcut-reset-tooltip;
                                            clicked => { root.view-item-spacing-reset(); }
                                        }
                                    }
                                }
                            }
                        }

                        // Hybrid thumbnail mode: thumbnailable content keeps the
                        // chosen zoom, plain icons stay at normal height. Enabled
                        // by default. Sits next to the zoom card because it is
                        // about row height, and applies immediately everywhere.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-compact-preview-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: Strings.settings-compact-preview-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    CheckBox {
                                        checked <=> root.compact-preview-rows-enabled;
                                        toggled => { root.compact-preview-rows-changed(self.checked); }
                                    }
                                }
                            }
                        }

                        // -- Card: what a newly opened tab starts with. All three
                        // rows share the same scope, so the caveat about already
                        // open tabs is stated once for the card instead of being
                        // repeated under every row.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text {
                                    text: Strings.settings-tab-defaults-title;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                }
                                Text {
                                    text: Strings.settings-tab-defaults-hint;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-default-view-mode-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: Strings.settings-default-view-mode-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    settings-view-mode := ComboBox {
                                        width: 160px;
                                        vertical-stretch: 0;
                                        model: [Strings.settings-view-mode-list, Strings.settings-view-mode-previews];
                                        current-index <=> root.default-view-mode-index;
                                        selected(_) => {
                                            root.default-view-mode-changed(settings-view-mode.current-index);
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-thumbnail-zoom-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: Strings.settings-thumbnail-zoom-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    SpinBox {
                                        width: 96px;
                                        minimum: 1;
                                        maximum: 8;
                                        value <=> root.default-thumbnail-zoom;
                                        edited(value) => { root.default-thumbnail-zoom-changed(value); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-default-item-arrangement-label;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    settings-item-arrangement := ComboBox {
                                        width: 160px;
                                        vertical-stretch: 0;
                                        model: [Strings.view-layout-list, Strings.view-layout-grid];
                                        current-index <=> root.default-item-arrangement-index;
                                        selected(_) => {
                                            root.default-item-arrangement-changed(settings-item-arrangement.current-index);
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-default-hidden-label;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    CheckBox {
                                        checked <=> root.default-show-hidden;
                                        toggled => { root.default-show-hidden-changed(self.checked); }
                                    }
                                }
                            }
                        }

                        // -- Card: the starting point of a brand new workspace.
                        // A narrower scope than the card above, hence a card of
                        // its own: these two are read once, when there is no
                        // existing view to copy from.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text {
                                    text: Strings.settings-new-workspace-title;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                }
                                Text {
                                    text: Strings.settings-new-workspace-hint;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-tabbar-default;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    settings-tabbar := ComboBox {
                                        width: 160px;
                                        vertical-stretch: 0;
                                        model: root.tabbar-default-labels;
                                        current-index <=> root.tabbar-default-pref;
                                        selected(_) => { root.tabbar-default-changed(settings-tabbar.current-index); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                Text {
                                    text: Strings.settings-columns-section;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                }
                                // The list carries no frame of its own: it is a
                                // part of this card, not a card inside a card.
                                VerticalLayout {
                                    spacing: 0px;
                                    for col[ci] in root.settings-columns : Rectangle {
                                        height: 32px;
                                        border-radius: 5px;
                                        opacity: col.id == "name" ? 0.5 : 1.0;
                                        background: scol-touch.has-hover && col.id != "name"
                                            ? Theme.alternate-background
                                            : transparent;
                                        HorizontalLayout {
                                            padding-right: 4px;
                                            spacing: 10px;
                                            Rectangle {
                                                width: 16px;
                                                height: parent.height;
                                                Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: col.visible ? Theme.accent-background : Theme.border;
                                                    background: col.visible ? Theme.accent-background : transparent;
                                                    if col.visible : Image {
                                                        source: @image-url("../../assets/icons/check.svg");
                                                        width: 10px;
                                                        height: 10px;
                                                        colorize: Theme.accent-foreground;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: col.label;
                                                font-size: 13px;
                                                color: Theme.foreground;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        scol-touch := TouchArea {
                                            mouse-cursor: col.id == "name" ? default : pointer;
                                            clicked => {
                                                if (col.id != "name") {
                                                    root.default-column-toggle(col.id, !col.visible);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // -- Card: how dates and sizes are read. The two depths
                        // drive ONE background walk on the Rust side, so they
                        // belong together and share the closing note.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text {
                                    text: Strings.settings-group-dates;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: Strings.settings-clock-label;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.foreground;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    settings-clock := ComboBox {
                                        width: 160px;
                                        vertical-stretch: 0;
                                        model: [Strings.settings-clock-local, "UTC"];
                                        current-index <=> root.clock-utc-pref;
                                        selected(_) => { root.clock-mode-changed(settings-clock.current-index); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-rmtime-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: Strings.settings-rmtime-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    SpinBox {
                                        width: 96px;
                                        minimum: 0;
                                        // Same bound as `MAX_FOLDER_STAT_DEPTH`
                                        // on the Rust side, which clamps the
                                        // value it is handed.
                                        maximum: 16;
                                        value <=> root.rmtime-depth;
                                        edited(v) => { root.rmtime-depth-changed(v); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-fsize-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: Strings.settings-fsize-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    SpinBox {
                                        width: 96px;
                                        minimum: 0;
                                        // Same bound as `MAX_FOLDER_STAT_DEPTH`
                                        // on the Rust side, which clamps the
                                        // value it is handed.
                                        maximum: 16;
                                        value <=> root.size-depth;
                                        edited(v) => { root.size-depth-changed(v); }
                                    }
                                }
                                Text {
                                    text: Strings.settings-folder-depth-hint;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Tooltip preferences share the same global bubble.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text {
                                    text: Strings.settings-group-tooltips;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                SettingsToggleRow {
                                    label: Strings.settings-tab-tooltip-label;
                                    hint: Strings.settings-tab-tooltip-hint;
                                    checked <=> root.tab-tooltip-enabled;
                                    toggled(on) => { root.tab-tooltip-changed(on); }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                SettingsToggleRow {
                                    label: Strings.settings-grid-name-tooltip-label;
                                    hint: Strings.settings-grid-name-tooltip-hint;
                                    checked <=> root.grid-name-tooltip-enabled;
                                    toggled(on) => { root.grid-name-tooltip-changed(on); }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                SettingsToggleRow {
                                    label: Strings.settings-search-path-tooltip-label;
                                    hint: Strings.settings-search-path-tooltip-hint;
                                    checked <=> root.search-path-tooltip-enabled;
                                    toggled(on) => { root.search-path-tooltip-changed(on); }
                                }
                            }
                        }

                        // Manual workspace loading and indexed shortcuts have separate policies.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text {
                                    text: Strings.settings-group-workspaces;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                Text {
                                    text: root.ws-panel-settings-title;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: Strings.settings-ws-panel-hint;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                                ComboBox {
                                    model: [Strings.ws-shortcut-ask,
                                        Strings.ws-shortcut-discard, Strings.ws-shortcut-save];
                                    current-index <=> root.ws-panel-save-index;
                                    selected(_) => { root.ws-panel-save-changed(self.current-index); }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                Text {
                                    text: root.ws-shortcut-settings-title;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: Strings.settings-ws-shortcut-hint;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                                ComboBox {
                                    model: [Strings.ws-shortcut-ask,
                                        Strings.ws-shortcut-discard, Strings.ws-shortcut-save];
                                    current-index <=> root.ws-shortcut-save-index;
                                    selected(_) => { root.ws-shortcut-save-changed(self.current-index); }
                                }
                            }
                        }

                        // Optional command-line tools on Linux. Detection
                        // starts on expansion, so opening Settings stays cheap.
                        // Last in the panel: it reports, it does not configure.
                        if !root.platform-windows : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Rectangle {
                                    height: 38px;
                                    header-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.optional-tools-expanded = !root.optional-tools-expanded; }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text {
                                                text: Strings.settings-optional-tools-title;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.foreground;
                                            }
                                            Text {
                                                text: Strings.settings-optional-tools-hint;
                                                font-size: 11px;
                                                color: Theme.foreground.with-alpha(0.55);
                                                overflow: elide;
                                            }
                                        }
                                        Image {
                                            width: 14px;
                                            height: 14px;
                                            y: (parent.height - self.height) / 2;
                                            source: root.optional-tools-expanded
                                                ? @image-url("../../assets/icons/chevron-up.svg")
                                                : @image-url("../../assets/icons/chevron-down.svg");
                                            colorize: Theme.foreground.with-alpha(0.65);
                                        }
                                    }
                                }
                                if root.optional-tools-expanded : VerticalLayout {
                                    spacing: 6px;
                                    OptionalToolRow {
                                        name: "ffmpeg";
                                        hint: Strings.settings-tool-ffmpeg-hint;
                                        found: root.ffmpeg-found;
                                        version: root.ffmpeg-version;
                                        available-label: Strings.settings-optional-tools-available;
                                        missing-label: Strings.settings-optional-tools-missing;
                                    }
                                    OptionalToolRow {
                                        name: "poppler-utils";
                                        hint: Strings.settings-tool-poppler-hint;
                                        found: root.poppler-found;
                                        version: root.poppler-version;
                                        available-label: Strings.settings-optional-tools-available;
                                        missing-label: Strings.settings-optional-tools-missing;
                                    }
                                    OptionalToolRow {
                                        name: "7-Zip";
                                        hint: Strings.settings-tool-seven-zip-hint;
                                        found: root.seven-zip-found;
                                        version: root.seven-zip-version;
                                        available-label: Strings.settings-optional-tools-available;
                                        missing-label: Strings.settings-optional-tools-missing;
                                    }
                                    if root.optional-tools-flatpak : Text {
                                        text: Strings.settings-optional-tools-flatpak;
                                        font-size: 11px;
                                        color: Theme.foreground.with-alpha(0.55);
                                        wrap: word-wrap;
                                    }
                                    Button {
                                        text: Strings.settings-optional-tools-recheck;
                                        enabled: root.optional-tools-checked;
                                        clicked => { root.optional-tools-recheck(); }
                                    }
                                }
                            }
                        }
                    }
                } // <- end of the GENERAL tab (closes VerticalLayout + ScrollView)

                // Scrollable content of the Shortcuts tab.
                if root.settings-tab == 1 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 20px;
                        spacing: 18px;
                        sc-box := VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            property <bool> reset-all-armed: false;

                            // Header: search + reset all
                            HorizontalLayout {
                                spacing: 8px;
                                SearchField {
                                    horizontal-stretch: 1;
                                    placeholder-text: Strings.shortcut-search-placeholder;
                                    text <=> root.shortcut-search-text;
                                    edited(value) => { root.shortcut-search(value); }
                                }
                                if root.shortcut-has-overrides : Rectangle {
                                    height: 32px;
                                    width: rall-text.preferred-width + 24px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: rall-touch.has-hover ? Theme.accent-background : Theme.border;
                                    background: rall-touch.has-hover ? Theme.alternate-background : transparent;
                                    rall-text := Text {
                                        text: sc-box.reset-all-armed
                                            ? Strings.shortcut-reset-all-confirm
                                            : Strings.shortcut-reset-all;
                                        font-size: 12px;
                                        color: sc-box.reset-all-armed ? Tokens.danger : Theme.foreground;
                                        x: (parent.width - self.width) / 2;
                                        vertical-alignment: center;
                                    }
                                    rall-touch := TouchArea {
                                        pointer-event(ev) => {
                                            // Same rule as the rows: consumed here, so reported here.
                                            if (ev.kind == PointerEventKind.down
                                                    && ev.button == PointerEventButton.left) {
                                                Dismiss.serial += 1;
                                            }
                                        }
                                        clicked => {
                                            if (sc-box.reset-all-armed) {
                                                root.shortcut-reset-all();
                                                sc-box.reset-all-armed = false;
                                            } else {
                                                sc-box.reset-all-armed = true;
                                            }
                                        }
                                    }
                                }
                            }

                            // Compatibility preferences remain visible above filtered action groups.
                            Rectangle {
                                vertical-stretch: 0;
                                background: Theme.alternate-background.with-alpha(0.5);
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    // One choice, not a switch: the same
                                    // Cyrillic letter sits on a different key
                                    // depending on the arrangement, so the
                                    // layout has to be named rather than merely
                                    // turned on. Hovering the label says why.
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            Text {
                                                x: 0;
                                                width: parent.width;
                                                height: parent.height;
                                                text: Strings.settings-letter-layout;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            // Declared after the text so it
                                            // receives the hover; it draws
                                            // nothing and steals no click.
                                            layout-tip := TouchArea {
                                                mouse-cursor: default;
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        Tip.text = Strings.settings-letter-layout-tip;
                                                        Tip.x = self.absolute-position.x;
                                                        Tip.y = self.absolute-position.y + self.height + 4px;
                                                    } else if (Tip.text == Strings.settings-letter-layout-tip) {
                                                        Tip.text = "";
                                                    }
                                                }
                                            }
                                        }
                                        letter-layout := ComboBox {
                                            width: 210px;
                                            vertical-stretch: 0;
                                            model: [
                                                Strings.settings-letter-layout-off,
                                                Strings.settings-keyboard-russian-standard,
                                                Strings.settings-keyboard-ukrainian-standard,
                                            ];
                                            current-index <=> root.letter-layout-index;
                                            selected(_) => {
                                                root.letter-layout-changed(letter-layout.current-index);
                                            }
                                        }
                                    }
                                }
                            }

                            // Grouped list
                            for grp[gi] in root.shortcut-groups : VerticalLayout {
                                spacing: 0px;
                                Text {
                                    text: grp.name;
                                    font-weight: 600;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.5);
                                    letter-spacing: 0.5px;
                                    height: 28px;
                                    vertical-alignment: bottom;
                                }
                                Rectangle {
                                    background: Theme.alternate-background.with-alpha(0.5);
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 0px;
                                        for row[ri] in grp.rows : VerticalLayout {
                                            spacing: 0px;
                                            // Main row
                                            Rectangle {
                                                height: 36px;
                                                border-radius: 5px;
                                                background: row-hover.has-hover ? Theme.alternate-background : transparent;
                                                row-hover := TouchArea {
                                                    pointer-event(ev) => {
                                                        // Reported like every other click inside this
                                                        // tab: a touch area consumes what it receives,
                                                        // so the panel's catch-all underneath never
                                                        // hears it and the floating menu would survive.
                                                        if (ev.kind == PointerEventKind.down
                                                                && ev.button == PointerEventButton.left) {
                                                            Dismiss.serial += 1;
                                                        }
                                                        if (ev.kind == PointerEventKind.down
                                                                && ev.button == PointerEventButton.right) {
                                                            root.open-shortcut-menu(row.action-id,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y);
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: row.name;
                                                        font-size: 13px;
                                                        color: Theme.foreground;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    if row.overridden : Rectangle {
                                                        width: 22px;
                                                        Image {
                                                            width: 13px;
                                                            height: 13px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            source: @image-url("../../assets/icons/refresh.svg");
                                                            colorize: rst-touch.has-hover ? Theme.accent-background : Theme.foreground.with-alpha(0.55);
                                                        }
                                                        rst-touch := TouchArea {
                                                            clicked => { root.shortcut-reset(row.action-id); }
                                                            pointer-event(ev) => {
                                                                // Same rule as the rows: consumed here, so reported here.
                                                                if (ev.kind == PointerEventKind.down
                                                                        && ev.button == PointerEventButton.left) {
                                                                    Dismiss.serial += 1;
                                                                }
                                                            }
                                                        }
                                                    }
                                                    // Clickable cluster: capture pill / caps / unassigned
                                                    Rectangle {
                                                        width: sc-cluster.preferred-width;
                                                        sc-cluster := HorizontalLayout {
                                                            spacing: 3px;
                                                            if root.shortcut-capturing == row.action-id : Rectangle {
                                                                height: 24px;
                                                                width: 168px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 6px;
                                                                border-width: 1px;
                                                                border-color: Theme.accent-background;
                                                                background: Theme.accent-background.with-alpha(0.10);
                                                                Text {
                                                                    text: Strings.shortcut-listening;
                                                                    font-size: 11px;
                                                                    color: Theme.accent-background;
                                                                    x: (parent.width - self.width) / 2;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                            if root.shortcut-capturing != row.action-id && row.assigned : HorizontalLayout {
                                                                spacing: 3px;
                                                                for cap[ci] in row.caps : HorizontalLayout {
                                                                    spacing: 3px;
                                                                    if ci > 0 : Text {
                                                                        text: "+";
                                                                        font-size: 11px;
                                                                        color: Theme.foreground.with-alpha(0.45);
                                                                        vertical-alignment: center;
                                                                    }
                                                                    Rectangle {
                                                                        height: 22px;
                                                                        width: cap.kind == 0 ? max(24px, cap-lbl.preferred-width + 14px) : 24px;
                                                                        y: (parent.height - self.height) / 2;
                                                                        border-radius: 5px;
                                                                        border-width: 1px;
                                                                        border-color: Theme.border;
                                                                        background: Theme.surface;
                                                                        cap-lbl := Text {
                                                                            visible: cap.kind == 0;
                                                                            text: cap.label;
                                                                            font-size: 11px;
                                                                            font-weight: 600;
                                                                            color: Theme.foreground;
                                                                            x: (parent.width - self.width) / 2;
                                                                            vertical-alignment: center;
                                                                        }
                                                                        if cap.kind != 0 : Image {
                                                                            width: 11px;
                                                                            height: 11px;
                                                                            x: (parent.width - self.width) / 2;
                                                                            y: (parent.height - self.height) / 2;
                                                                            colorize: Theme.foreground;
                                                                            source: cap.kind == 1 ? @image-url("../../assets/icons/arrow-up.svg")
                                                                                : cap.kind == 2 ? @image-url("../../assets/icons/arrow-down.svg")
                                                                                : cap.kind == 3 ? @image-url("../../assets/icons/chevron-left.svg")
                                                                                : @image-url("../../assets/icons/chevron-right.svg");
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            if root.shortcut-capturing != row.action-id && !row.assigned : Text {
                                                                text: Strings.shortcut-unassigned;
                                                                font-size: 11px;
                                                                font-italic: true;
                                                                color: Theme.foreground.with-alpha(0.4);
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.shortcut-capturing = row.action-id;
                                                                key-scope.focus();
                                                            }
                                                            pointer-event(ev) => {
                                                                // Above the panel's catch-all, so this
                                                                // row reports its own left click: without
                                                                // it, the menu opened on one row survived
                                                                // a click on the next.
                                                                if (ev.kind == PointerEventKind.down
                                                                        && ev.button == PointerEventButton.left) {
                                                                    Dismiss.serial += 1;
                                                                }
                                                                if (ev.kind == PointerEventKind.down
                                                                        && ev.button == PointerEventButton.right) {
                                                                    root.open-shortcut-menu(row.action-id,
                                                                        self.absolute-position.x + self.mouse-x,
                                                                        self.absolute-position.y + self.mouse-y);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            // Conflict band
                                            if row.action-id == root.shortcut-conflict-action : Rectangle {
                                                height: 32px;
                                                border-radius: 6px;
                                                background: Tokens.danger.with-alpha(0.12);
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: root.shortcut-conflict-message;
                                                        font-size: 11px;
                                                        color: Tokens.danger;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Rectangle {
                                                        width: ra-text.preferred-width + 18px;
                                                        height: 24px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 5px;
                                                        border-width: 1px;
                                                        border-color: Theme.accent-background;
                                                        background: ra-touch.has-hover ? Theme.accent-background.with-alpha(0.12) : transparent;
                                                        ra-text := Text {
                                                            text: Strings.shortcut-conflict-reassign;
                                                            font-size: 11px;
                                                            color: Theme.accent-background;
                                                            x: (parent.width - self.width) / 2;
                                                            vertical-alignment: center;
                                                        }
                                                        ra-touch := TouchArea { clicked => { root.shortcut-resolve-conflict(true); } }
                                                    }
                                                    Rectangle {
                                                        width: rk-text.preferred-width + 18px;
                                                        height: 24px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 5px;
                                                        border-width: 1px;
                                                        border-color: Theme.border;
                                                        background: rk-touch.has-hover ? Theme.alternate-background : transparent;
                                                        rk-text := Text {
                                                            text: Strings.shortcut-conflict-keep;
                                                            font-size: 11px;
                                                            color: Theme.foreground;
                                                            x: (parent.width - self.width) / 2;
                                                            vertical-alignment: center;
                                                        }
                                                        rk-touch := TouchArea { clicked => { root.shortcut-resolve-conflict(false); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.shortcut-groups.length == 0 : Text {
                                text: Strings.shortcut-no-results;
                                color: Theme.foreground.with-alpha(0.5);
                                font-size: 12px;
                                height: 40px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Scrollable content — OPEN WITH tab
                if root.settings-tab == 2 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        // "Open with" and "Detected Windows entries" sub-tabs.
                        // The segmented style follows the shortcut popup's. A
                        // fixed height keeps the buttons from occupying the free space
                        // when the content is empty.
                        if root.platform-windows : HorizontalBox {
                            height: 32px;
                            padding: 0px;
                            spacing: 6px;
                            Button {
                                text: Strings.settings-openers-section;
                                primary: root.ow-subtab == 0;
                                clicked => { root.ow-subtab = 0; }
                            }
                            Button {
                                text: Strings.settings-shellext-list-label;
                                primary: root.ow-subtab == 1;
                                clicked => { root.ow-subtab = 1; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.ow-subtab == 0 : HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            SearchField {
                                horizontal-stretch: 1;
                                placeholder-text: Strings.ow-search-placeholder;
                                text <=> root.opener-search-text;
                                edited(value) => { root.opener-search(value); }
                            }
                            Rectangle {
                                width: owadd-txt.preferred-width + 22px;
                                height: 32px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: owadd-ta.has-hover ? Theme.accent-background : Theme.border;
                                background: owadd-ta.has-hover ? Theme.alternate-background : transparent;
                                owadd-txt := Text { text: Strings.ow-add; font-size: 12px; color: Theme.foreground; x: (parent.width - self.width)/2; vertical-alignment: center; height: parent.height; }
                                owadd-ta := TouchArea { clicked => { root.ow-add(); } }
                            }
                        }
                        // Ready-made archiving/sharing commands, on their own
                        // block under the search row. Wrapped over two rows so
                        // the menu never scrolls sideways — even in the longer
                        // languages or when every tool is installed. The label
                        // keeps a fixed height so its box cannot grow with the
                        // platform font's line spacing (which left a gap above
                        // the buttons on Linux).
                        // Ready-made commands, collapsed by default. The
                        // whole header line toggles it, on the model of the
                        // sidebar section headers.
                        // Shown even with nothing detected: the block is how
                        // one learns the recipes exist at all, and that
                        // installing an archiver makes them appear.
                        if root.ow-subtab == 0 : VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                // Fixed height: a bare Text grew with the system
                                // line spacing and left a gap on Linux.
                                height: 26px;
                                border-radius: 5px;
                                background: rcp-hdr.has-hover ? Theme.alternate-background : transparent;
                                accessible-role: button;
                                accessible-label: Strings.ow-recipes-label;
                                accessible-action-default => { root.ow-recipes-open = !root.ow-recipes-open; }
                                rcp-hdr := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.ow-recipes-open = !root.ow-recipes-open; }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    // Fixed slot: the two chevrons differ in
                                    // width, and the label would shift on toggle.
                                    Rectangle {
                                        width: 12px;
                                        Image {
                                            width: 10px;
                                            height: 10px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: root.ow-recipes-open
                                                ? @image-url("../../assets/icons/chevron-down.svg")
                                                : @image-url("../../assets/icons/chevron-right.svg");
                                            colorize: Theme.foreground.with-alpha(rcp-hdr.has-hover ? 0.75 : 0.45);
                                        }
                                    }
                                    Text {
                                        text: Strings.ow-recipes-label;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.foreground.with-alpha(rcp-hdr.has-hover ? 0.8 : 0.55);
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // Collapsed, this count is the only thing
                                    // saying the section holds anything.
                                    Text {
                                        text: "(" + (root.ow-recipes-col1.length + root.ow-recipes-col2.length) + ")";
                                        font-size: 11px;
                                        color: Theme.foreground.with-alpha(0.4);
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                            if root.ow-recipes-open : VerticalLayout {
                                padding-left: 18px;
                                spacing: 6px;
                                Text {
                                    text: Strings.ow-recipes-hint;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                                if root.ow-recipes-missing != "" : Text {
                                    text: root.ow-recipes-missing;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.4);
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        for r in root.ow-recipes-col1 : OwRecipeButton {
                                            recipe: r;
                                            activate => { root.ow-recipe-add(r.index); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        for r in root.ow-recipes-col2 : OwRecipeButton {
                                            recipe: r;
                                            activate => { root.ow-recipe-add(r.index); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.ow-subtab == 0 : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                if root.openers-all.length == 0 : Text {
                                    text: root.opener-search-text == ""
                                        ? Strings.ow-empty
                                        : Strings.ow-no-results;
                                    font-size: 12px;
                                    color: Theme.foreground.with-alpha(0.45);
                                    height: 30px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                for op[oi] in root.openers-all : Rectangle {
                                    height: 32px;
                                    border-radius: 5px;
                                    background: oprow.has-hover ? Theme.alternate-background : transparent;
                                    oprow := TouchArea { }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        CommandIcon {
                                            kind: op.icon-kind;
                                            extracted: op.icon;
                                            available: op.available;
                                        }
                                        Text {
                                            text: op.label;
                                            font-size: 13px;
                                            color: op.available ? Theme.foreground : Theme.foreground.with-alpha(0.45);
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/chevron-up.svg"); tooltip: Strings.ow-move-up; clicked => { root.ow-move(op.id, -1); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/chevron-down.svg"); tooltip: Strings.ow-move-down; clicked => { root.ow-move(op.id, 1); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/duplicate.svg"); tooltip: Strings.ow-duplicate-tip; clicked => { root.ow-duplicate(op.id); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/pencil.svg"); tooltip: Strings.ow-edit-tip; clicked => { root.ow-edit(op.id); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/trash.svg"); tooltip: Strings.ow-delete-tip; clicked => { root.ow-delete(op.id); } }
                                    }
                                }
                            }
                        }

                        // ===== Detected Windows entries (shell extensions) =====
                        // Dedicated sub-tab. List built at LAUNCH
                        // (completed as right-clicks happen); unchecking hides
                        // the entry from the context menu.
                        // Global toggle for the Windows context menu —
                        // moved here from the General tab: everything
                        // related to shell extensions lives in this sub-tab.
                        if root.platform-windows && root.ow-subtab == 1 : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-shellmenu-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: Strings.settings-shellmenu-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    CheckBox {
                                        checked <=> root.shell-menu-enabled;
                                        toggled => { root.shell-menu-changed(self.checked); }
                                    }
                                }
                            }
                        }
                        // The list below only makes sense if the integration is
                        // active → greyed out/hidden otherwise.
                        if root.platform-windows && root.ow-subtab == 1 && root.shell-menu-enabled : Text {
                            text: Strings.settings-shellext-list-hint;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.55);
                            wrap: word-wrap;
                        }
                        if root.platform-windows && root.ow-subtab == 1 && root.shell-menu-enabled && root.shell-ext-rows.length == 0 : Text {
                            text: Strings.settings-shellext-empty;
                            font-size: 12px;
                            color: Theme.foreground.with-alpha(0.45);
                            height: 40px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        if root.platform-windows && root.ow-subtab == 1 && root.shell-menu-enabled && root.shell-ext-rows.length > 0 : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                for sx in root.shell-ext-rows : Rectangle {
                                    height: 28px;
                                    border-radius: 5px;
                                    background: sxrow.has-hover ? Theme.alternate-background : transparent;
                                    sxrow := TouchArea { }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        Text {
                                            text: sx.label;
                                            font-size: 13px;
                                            color: Theme.foreground;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        CheckBox {
                                            checked: sx.enabled;
                                            toggled => { root.shell-ext-toggle(sx.label, self.checked); }
                                        }
                                    }
                                }
                            }
                        }
                        // End spring: absorbs the free space → the
                        // cards/tabs keep their natural height even when
                        // the list is empty or hidden.
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Scrollable content of the Storage tab. Where Favnyr keeps
                // its files, and the one action that prunes them. Pulled out
                // of General: both are about stored data, not preferences,
                // and at the bottom of a long panel nobody found them.
                if root.settings-tab == 3 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        // Cards keep the height they ask for. Without this the
                        // layout stretches them to fill the view whenever the
                        // panel is shorter than it, and each card hands the
                        // surplus down to its own rows, where it surfaces as
                        // stray space under a label.
                        alignment: start;
                        padding: 20px;
                        spacing: 18px;

                        // -- Card: the three per-user folders --
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 12px;
                                Text {
                                    text: Strings.settings-paths-section;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                }
                                if !root.config-path-redundant : PathRow {
                                    label: Strings.settings-config-path;
                                    value: root.config-dir-path;
                                    open-text: Strings.settings-open;
                                    open-clicked => { root.open-config-dir(); }
                                }
                                if !root.config-path-redundant : Rectangle { height: 1px; background: Theme.border; }
                                PathRow {
                                    label: Strings.settings-data-path;
                                    value: root.data-dir-path;
                                    open-text: Strings.settings-open;
                                    open-clicked => { root.open-data-dir(); }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                PathRow {
                                    label: Strings.settings-cache-path;
                                    value: root.cache-dir-path;
                                    open-text: Strings.settings-open;
                                    open-clicked => { root.open-cache-dir(); }
                                }
                            }
                        }

                        // -- Card: leftover colours and notes. Its own card now:
                        // an action has no business hanging off a hairline under
                        // three read-only paths.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 12px;
                                // Sweeping annotations left behind. Deliberately
                                // manual and deliberately explicit: the count is
                                // shown before anything is offered, and the hint
                                // says what will NOT be touched.
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: Strings.settings-annotations-title;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: Strings.settings-annotations-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    // Count badge. Neutral when there is nothing
                                    // to sweep, amber otherwise: leftovers are
                                    // untidy, never an error.
                                    orphan-badge := Rectangle {
                                        property <color> tone: root.annotation-orphans > 0
                                            ? Tokens.warning
                                            : Tokens.success;
                                        height: 22px;
                                        vertical-stretch: 0;
                                        border-radius: 11px;
                                        background: orphan-badge.tone.with-alpha(0.15);
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            Text {
                                                text: root.annotation-orphans;
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: orphan-badge.tone;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    SettingsRowButton {
                                        text: Strings.settings-annotations-clean;
                                        enabled: root.annotation-orphans > 0;
                                        clicked => { root.clean-annotations(); }
                                    }
                                }
                            }
                        }

                        // End spring, so the cards keep their natural height.
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // ===== Context menu of a keyboard shortcut =====
        // Rendered AFTER the Settings dialog → on top of it. Gated on
        // `settings-open`: closing settings also hides this menu.
        if root.settings-open && root.settings-tab == 1 && root.shortcut-menu-open : Rectangle {
            x: Flyout.pinned-x(root.shortcut-menu-x, self.width, root.width);
            y: Flyout.pinned-y(root.shortcut-menu-y, self.height, root.height);
            width: 240px;
            height: 40px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    label: Strings.shortcut-unassign;
                    clicked => {
                        root.shortcut-menu-open = false;
                        root.shortcut-unassign(root.shortcut-menu-action);
                    }
                }
            }
        }

        // ===== Workspaces overlay =====
        if root.workspaces-open : ModalBackdrop { }
        if root.workspaces-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            // Adaptive height driven by the list's ACTUAL content.
            // A row measures 44px and the spacing between two rows 4px; the
            // bottom padding adds 12px, i.e. `48 * N + 8` in total. The old
            // formula started at 480px and then added these rows on top: three
            // workspaces were therefore enough to reach 620px while leaving a
            // large empty area in the ScrollView.
            property <length> ws-list-ideal-height:
                root.workspaces.length == 0
                    ? 112px
                    : 8px + root.workspaces.length * 48px;
            // 188px cover the header, Save area, separators, and list
            // title. The name-taken warning adds its own line. 300px remains
            // a readable minimum for the empty state; beyond 620px the list
            // scrolls. The window bound keeps priority on small screens.
            property <length> ws-card-ideal-height:
                188px + self.ws-list-ideal-height + (root.ws-name-taken ? 21px : 0px);
            height: min(
                parent.height - 40px,
                min(620px, max(300px, self.ws-card-ideal-height)));
            background: Theme.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            // Toast timer: clears the message after 2s.
            Timer {
                interval: 2s;
                running: root.ws-toast != "";
                triggered => { root.ws-toast = ""; }
            }

            // Deferred focus of the "name" field (armed by the bridge on Ctrl+S of a
            // still-unnamed workspace). Same shared component as the
            // Rename / New / Paste-conflict popups.
            DeferredLineEditFocus {
                armed <=> root.ws-name-focus-armed;
                blocked: root.exit-warning-open;
                apply-focus => { ws-name-input.focus(); }
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Header + X
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: Strings.ws-title;
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // "Start a new workspace" button: starts over from the
                        // 1st-launch state (1 panel, $HOME). Goes through the
                        // guard — the bridge resets+closes if the current state
                        // is clean, otherwise opens the warning dialog.
                        Rectangle {
                            width: ws-reset-text.preferred-width + 22px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: ws-reset-touch.has-hover
                                ? Theme.accent-background
                                : Theme.border;
                            background: ws-reset-touch.has-hover
                                ? Theme.alternate-background
                                : transparent;
                            ws-reset-text := Text {
                                text: Strings.ws-reset;
                                font-size: 12px;
                                color: Theme.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ws-reset-touch := TouchArea {
                                mouse-cursor: pointer;
                                // The bridge decides: direct reset + close, or
                                // opening the dialog (which then closes itself).
                                clicked => { root.ws-reset-guarded(); }
                            }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: ws-close-touch.has-hover ? Tokens.danger.with-alpha(0.27) : transparent;
                            Image {
                                source: @image-url("../../assets/icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: ws-close-touch.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ws-close-touch := TouchArea {
                                clicked => { root.workspaces-open = false; }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // --- "Save" area (fixed, at the top) ---
                Rectangle {
                    background: Theme.alternate-background.with-alpha(0.35);
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: Strings.ws-save-section;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.foreground.with-alpha(0.55);
                            letter-spacing: 0.5px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 34px;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.background;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: ws-name-input.has-focus
                                    ? Theme.accent-background
                                    : Theme.border;
                                ws-name-input := EditTextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: "";
                                    font-size: 13px;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    single-line: true;
                                    selection-background-color: Theme.accent-background.with-alpha(0.5);
                                    accepted => {
                                        if (self.text != "" && !root.ws-name-taken) {
                                            root.ws-save-new(self.text);
                                            self.text = "";
                                        }
                                    }
                                    changed text => { root.ws-name-check(self.text); }
                                    Text {
                                        x: 0;
                                        visible: ws-name-input.text == "";
                                        text: Strings.ws-name-placeholder;
                                        font-size: 13px;
                                        color: Theme.foreground.with-alpha(0.4);
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }
                                }
                            }
                            // Save button — disabled if the field is empty or if
                            // the name already exists (live validation by the bridge).
                            Rectangle {
                                width: 104px;
                                height: 34px;
                                border-radius: 6px;
                                property <bool> active: ws-name-input.text != "" && !root.ws-name-taken;
                                opacity: self.active ? 1.0 : 0.45;
                                background: save-touch.has-hover && self.active
                                    ? Theme.accent-background.with-alpha(0.85)
                                    : Theme.accent-background;
                                Text {
                                    text: Strings.ws-save-btn;
                                    font-size: 12px;
                                    color: Theme.accent-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                save-touch := TouchArea {
                                    enabled: parent.active;
                                    clicked => {
                                        root.ws-save-new(ws-name-input.text);
                                        ws-name-input.text = "";
                                    }
                                }
                            }
                        }
                        if root.ws-name-taken : Text {
                            text: Strings.ws-name-taken;
                            font-size: 11px;
                            color: Tokens.danger;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // --- "My workspaces (N)" section + scrollable list ---
                Rectangle {
                    height: 14px;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text {
                        text: Strings.ws-saved-section + "  (" + root.workspaces.length + ")";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.foreground.with-alpha(0.55);
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // Sort direction toggle button (newest <-> oldest). The arrow
                    // indicates the current direction (down = most recent on top).
                    Rectangle {
                        width: ws-sort-text.preferred-width + 46px;
                        height: 22px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: ws-sort-touch.has-hover
                            ? Theme.accent-background
                            : Theme.border;
                        background: ws-sort-touch.has-hover
                            ? Theme.alternate-background
                            : transparent;
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: center;
                            Rectangle {
                                width: 12px;
                                Image {
                                    source: root.ws-sort-newest-first
                                        ? @image-url("../../assets/icons/arrow-down.svg")
                                        : @image-url("../../assets/icons/arrow-up.svg");
                                    width: 12px;
                                    height: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.foreground;
                                }
                            }
                            ws-sort-text := Text {
                                text: root.ws-sort-newest-first
                                    ? Strings.ws-sort-newest
                                    : Strings.ws-sort-oldest;
                                font-size: 11px;
                                color: Theme.foreground;
                                vertical-alignment: center;
                            }
                        }
                        ws-sort-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.ws-toggle-sort(); }
                        }
                    }
                }
                Rectangle { height: 8px; }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 12px;
                        spacing: 4px;

                        // Empty state (title + bootstrap hint).
                        if root.workspaces.length == 0 : VerticalLayout {
                            padding-top: 30px;
                            spacing: 6px;
                            Text {
                                text: Strings.ws-empty;
                                font-size: 13px;
                                color: Theme.foreground.with-alpha(0.6);
                                horizontal-alignment: center;
                            }
                            Text {
                                text: Strings.ws-empty-hint;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.4);
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        for ws[wi] in root.workspaces : WorkspaceRow {
                            name: ws.name;
                            panels: ws.panels;
                            tabs: ws.tabs;
                            is-current: ws.is-current;
                            is-dirty: ws.is-dirty;
                            slot: ws.slot;
                            slot-tip: ws.slot > 0 && ws.slot <= root.ws-slot-tips.length
                                ? root.ws-slot-tips[ws.slot - 1]
                                : "";

                            theme: ws.theme;

                            pick-slot(x, y) => {
                                root.ws-slot-picker-id = ws.id;
                                root.ws-slot-picker-current = ws.slot;
                                root.ws-slot-picker-x = x;
                                root.ws-slot-picker-y = y;
                                root.ws-slot-picker-open = true;
                            }
                            pick-theme(x, y) => {
                                // Opening the picker scans the themes folder,
                                // so a theme added while Favnyr runs is in the
                                // list without anything being restarted.
                                root.refresh-themes();
                                root.ws-theme-picker-id = ws.id;
                                root.ws-theme-picker-current = ws.theme-id;
                                root.ws-theme-picker-x = x;
                                root.ws-theme-picker-y = y;
                                root.ws-theme-picker-open = true;
                            }
                            // Load GOES THROUGH the guard: the bridge loads
                            // directly if nothing is pending, otherwise it opens the
                            // dialog (which itself closes the overlay once loaded).
                            load => { root.ws-load-guarded(ws.id); }
                            // "Update" (amber pill) = save the current
                            // state, 1 direct click (clear intent). The hover ⟳
                            // of ANOTHER row keeps its 2-step confirmation.
                            update-now => { root.ws-overwrite(ws.id); }
                            overwrite => { root.ws-overwrite(ws.id); }
                            delete => { root.ws-delete(ws.id); }
                            rename(n) => { root.ws-rename(ws.id, n); }
                        }
                    }
                }

                // --- Feedback toast (bottom band, auto-dismiss) ---
                if root.ws-toast != "" : Rectangle {
                    height: 34px;
                    background: Theme.accent-background.with-alpha(0.15);
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    Image {
                        source: @image-url("../../assets/icons/check.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.foreground;
                        x: 16px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.ws-toast;
                        font-size: 12px;
                        color: Theme.foreground;
                        x: 37px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
            }
        }

        // ===== Workspace slot picker =====
        // Declared AFTER the workspaces overlay so it paints above it: in this
        // file the order of declaration is the order of painting.
        //
        // A three by three pad rather than a list of ten entries: the digits
        // sit where they sit on the keyboard, so choosing one rehearses the
        // gesture that will fire it. A list would turn a keyboard choice into
        // a form, and would stand three times taller.
        if root.ws-slot-picker-open : Rectangle {
            // Covers the window so a click anywhere else puts the picker away
            // without touching the panel underneath.
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            background: Colors.transparent;
            TouchArea {
                clicked => { root.ws-slot-picker-open = false; }
            }
            Rectangle {
                x: Flyout.pinned-x(root.ws-slot-picker-x, self.width, root.width);
                y: Flyout.pinned-y(root.ws-slot-picker-y + 4px, self.height, root.height);
                width: 120px;
                height: 121px;
                background: Theme.background;
                border-radius: Tokens.radius-overlay;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 18px;
                drop-shadow-color: Theme.shadow.with-alpha(0.25);
                drop-shadow-offset-y: 4px;
                // Absorbs clicks inside the picker so they never reach the
                // surface above, which would close it.
                TouchArea { }
                VerticalLayout {
                    padding: 4px;
                    for band[bi] in [0, 1, 2] : HorizontalLayout {
                        height: 26px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 0px;
                        for column[ci] in [0, 1, 2] : cell := Rectangle {
                            width: 32px;
                            property <int> value: bi * 3 + ci + 1;
                            property <string> owner: self.value <= root.ws-slot-taken.length
                                ? root.ws-slot-taken[self.value - 1]
                                : "";
                            property <bool> mine: self.value == root.ws-slot-picker-current;
                            // A slot taken by another workspace stays
                            // choosable: it belongs to one workspace, so
                            // picking it is a transfer, and a transfer is one
                            // click away from being undone.
                            property <bool> elsewhere: self.owner != "" && !self.mine;
                            cell-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.ws-slot-picker-open = false;
                                    root.ws-set-slot(root.ws-slot-picker-id, cell.value);
                                }
                                changed has-hover => {
                                    if (self.has-hover && cell.elsewhere) {
                                        Tip.text = cell.owner;
                                        Tip.x = self.absolute-position.x - 40px;
                                        Tip.y = self.absolute-position.y - 26px;
                                    } else if (!self.has-hover) {
                                        Tip.text = "";
                                    }
                                }
                            }
                            // Ring drawn OUTSIDE the badge so it never covers
                            // the digit, the way a colour swatch shows that it
                            // is being pointed at.
                            if cell-touch.has-hover : Rectangle {
                                x: 4px;
                                y: 1px;
                                width: 24px;
                                height: 24px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.foreground.with-alpha(0.45);
                            }
                            Rectangle {
                                x: 6px;
                                y: 3px;
                                width: 20px;
                                height: 20px;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: cell.elsewhere
                                    ? Theme.border.with-alpha(0.5)
                                    : Theme.border;
                                background: cell.elsewhere
                                    ? Theme.alternate-background
                                    : Theme.surface;
                                Text {
                                    text: cell.value;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: cell.elsewhere
                                        ? Theme.foreground.with-alpha(0.45)
                                        : Theme.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                            // The slot this workspace already holds is ticked,
                            // exactly as an applied colour is.
                            if cell.mine : Image {
                                source: @image-url("../../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                x: 10px;
                                y: 7px;
                                colorize: Theme.accent-foreground;
                            }
                        }
                    }
                    Rectangle {
                        height: 9px;
                        Rectangle { y: 4px; height: 1px; background: Tokens.hairline; }
                    }
                    // Clearing the slot, with the hollow badge that already
                    // means "nothing assigned" on the colour swatches.
                    Rectangle {
                        height: 26px;
                        none-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.ws-slot-picker-open = false;
                                root.ws-set-slot(root.ws-slot-picker-id, 0);
                            }
                        }
                        Rectangle {
                            x: 18px;
                            y: 3px;
                            width: 20px;
                            height: 20px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: none-touch.has-hover
                                ? Theme.foreground.with-alpha(0.45)
                                : Theme.foreground.with-alpha(0.30);
                        }
                        Text {
                            x: 46px;
                            text: Strings.ws-slot-none;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.4);
                            vertical-alignment: center;
                            height: parent.height;
                            overflow: elide;
                            width: 58px;
                        }
                    }
                }
            }
        }

        // ===== Theme picker of a workspace =====
        // Same shell as the slot picker above, with a scrolling list inside:
        // the families and the user's own theme files together outgrow any
        // fixed height. Clicking applies at once and LEAVES THE PICKER OPEN,
        // so the themes can be compared without reopening anything; the panel
        // behind is translucent, so the repainted window shows through.
        if root.ws-theme-picker-open : Rectangle {
            // Covers the window so a click anywhere else puts the picker away
            // without touching the panel underneath.
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            background: Colors.transparent;
            TouchArea {
                clicked => { root.ws-theme-picker-open = false; }
            }
            Rectangle {
                x: Flyout.pinned-x(root.ws-theme-picker-x, self.width, root.width);
                y: Flyout.pinned-y(root.ws-theme-picker-y + 4px, self.height, root.height);
                width: 190px;
                // The list is capped and scrolls past that, so the picker
                // never grows taller than the card it opens over.
                height: min(295px, 43px + root.theme-labels.length * 26px);
                background: Theme.background;
                border-radius: Tokens.radius-overlay;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 18px;
                drop-shadow-color: Theme.shadow.with-alpha(0.25);
                drop-shadow-offset-y: 4px;
                // Absorbs clicks inside the picker so they never reach the
                // surface above, which would close it.
                TouchArea { }
                VerticalLayout {
                    padding: 4px;
                    // Following the global theme, first and set apart, with
                    // the hollow square that already means "nothing assigned"
                    // on the colour swatches and on the slot badge. An entry
                    // of its own is the whole reason for a list rather than a
                    // control that cycles: taking an override away is one
                    // click, at the place that set it.
                    Rectangle {
                        height: 26px;
                        theme-none-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.ws-set-theme(root.ws-theme-picker-id, ""); }
                        }
                        Rectangle {
                            x: 8px;
                            y: 3px;
                            width: 20px;
                            height: 20px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: theme-none-touch.has-hover
                                ? Theme.foreground.with-alpha(0.45)
                                : Theme.foreground.with-alpha(0.30);
                        }
                        if root.ws-theme-picker-current == "" : Image {
                            source: @image-url("../../assets/icons/check.svg");
                            x: 13px;
                            y: 8px;
                            width: 10px;
                            height: 10px;
                            colorize: Theme.foreground.with-alpha(0.6);
                        }
                        Text {
                            x: 36px;
                            text: Strings.ws-theme-none;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.55);
                            vertical-alignment: center;
                            height: parent.height;
                            overflow: elide;
                            width: parent.width - 44px;
                        }
                    }
                    Rectangle {
                        height: 9px;
                        Rectangle { y: 4px; height: 1px; background: Tokens.hairline; }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            for label[ti] in root.theme-labels : entry := Rectangle {
                                height: 26px;
                                property <string> id: ti < root.theme-ids.length
                                    ? root.theme-ids[ti]
                                    : "";
                                property <bool> mine: self.id != ""
                                    && self.id == root.ws-theme-picker-current;
                                // The tick follows what was actually stored,
                                // which the bridge publishes once the write
                                // went through, in the same turn as the
                                // repaint. Moving it here instead would show
                                // a choice a failed write never recorded.
                                entry-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.ws-set-theme(root.ws-theme-picker-id, entry.id);
                                    }
                                }
                                background: entry-touch.has-hover
                                    ? Theme.accent-background.with-alpha(0.14)
                                    : transparent;
                                border-radius: 4px;
                                if entry.mine : Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    x: 13px;
                                    y: 8px;
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.accent-background;
                                }
                                Text {
                                    x: 36px;
                                    text: label;
                                    font-size: 11px;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    height: entry.height;
                                    overflow: elide;
                                    width: entry.width - 44px;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ===== Rename popup =====
        // Lightweight modal: title + current name + LineEdit + Cancel/Rename.
        // The backdrop absorbs clicks (TouchArea with no handler); only X / Escape
        // / Cancel / Enter close it.
        // ===== Note editor — same shell as the rename popup, without its
        // conflict states: a note has nothing to collide with.
        if root.comment-popup-open : ModalBackdrop { }
        if root.comment-popup-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 210px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            DeferredLineEditFocus {
                armed <=> root.comment-focus-armed;
                blocked: root.exit-warning-open;
                apply-focus => {
                    comment-edit.focus();
                    // Whole text selected: reopening the editor on an existing
                    // note is most often about replacing it.
                    comment-edit.select-all();
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: Strings.comment-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.comment-target-name;
                    color: Theme.foreground.with-alpha(0.7);
                    font-size: 12px;
                    overflow: elide;
                }
                // The note is copied in on every opening. Conditional elements
                // are instantiated eagerly, so initialization cannot represent
                // the popup's open transition.
                comment-edit := EditLineEdit {
                    placeholder-text: Strings.comment-placeholder;
                    property <bool> open-watch: root.comment-popup-open;
                    changed open-watch => {
                        if (self.open-watch) { self.text = root.comment-text; }
                    }
                    accepted(t) => {
                        root.comment-confirmed(t);
                        root.comment-popup-open = false;
                    }
                }
                // Clearing the field and saving is what removes a note, so the
                // link is a shortcut to the first half rather than a third
                // action. Held on its own line, right-aligned, so it cannot be
                // taken for one of the two buttons below.
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    FieldLink {
                        text: Strings.comment-clear;
                        clicked => {
                            comment-edit.text = "";
                            comment-edit.focus();
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.comment-popup-open = false; }
                    }
                    Button {
                        text: Strings.fav-save;
                        primary: true;
                        clicked => {
                            root.comment-confirmed(comment-edit.text);
                            root.comment-popup-open = false;
                        }
                    }
                }
            }
        }

        if root.rename-popup-open : ModalBackdrop { }
        if root.rename-popup-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 244px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            // Deferred focus (armed on opening): focus + caret before
            // a file's extension, or at the end for a folder.
            DeferredLineEditFocus {
                armed <=> root.rename-focus-armed;
                blocked: root.exit-warning-open;
                apply-focus => {
                    rename-edit.focus();
                    let offset = TextMetrics.rename-caret-offset(
                        root.rename-new-name, root.rename-current-is-dir);
                    rename-edit.set-selection-offsets(offset, offset);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: Strings.rename-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: Strings.rename-current-prefix + root.rename-current-name;
                    color: Theme.foreground.with-alpha(0.7);
                    font-size: 12px;
                    overflow: elide;
                }
                rename-edit := EditLineEdit {
                    placeholder-text: Strings.rename-new-placeholder;
                    text <=> root.rename-new-name;
                    // Live validation carried by the widget — same mechanism as the
                    // paste-conflict popup (`pc-edit`). Avoids a global
                    // `changed` that would call back into Rust on every write to the property,
                    // including those made by the bridge on opening.
                    edited(t) => { root.rename-check(t); }
                    accepted(t) => {
                        // Confirmation blocked on conflict (same guard as paste).
                        if (!root.rename-conflict && t != "") {
                            root.rename-confirmed(t);
                            root.rename-popup-open = false;
                        }
                    }
                }
                // Why the name is refused: already taken, or unusable on this
                // filesystem. The bridge decides and translates.
                //
                // The field helper shares this line. It belongs to the text
                // field it acts on rather than to the dialog's actions, and the
                // line is held open in any case — a blank space keeps its
                // height when there is no error — so the card does not grow.
                // When the helper is most useful, right after opening, the line
                // is empty and it sits alone.
                HorizontalBox {
                    padding: 0px;
                    Text {
                        text: root.rename-name-error == "" ? " " : root.rename-name-error;
                        color: Tokens.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    // Selects the name WITHOUT its extension, through the very
                    // offset the deferred focus above uses to place the caret —
                    // one rule for where a name ends, not two that could
                    // disagree. A folder, or a file with no extension, has
                    // nothing to set aside: the whole name is selected.
                    FieldLink {
                        text: Strings.rename-select-name;
                        clicked => {
                            rename-edit.focus();
                            rename-edit.set-selection-offsets(0,
                                TextMetrics.rename-caret-offset(
                                    root.rename-new-name,
                                    root.rename-current-is-dir));
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.rename-popup-open = false; }
                    }
                    if root.rename-replace-available : Button {
                        text: Strings.rename-force-replace;
                        clicked => {
                            if (root.rename-force-replace(root.rename-new-name)) {
                                root.rename-popup-open = false;
                            }
                        }
                    }
                    Button {
                        text: Strings.rename-confirm;
                        primary: true;
                        enabled: !root.rename-conflict && root.rename-new-name != "";
                        clicked => {
                            root.rename-confirmed(root.rename-new-name);
                            root.rename-popup-open = false;
                        }
                    }
                }
            }
        }

        // ===== New folder / file / shortcut popup (empty-area) =====
        // Same modal pattern as Rename: backdrop + centered card + deferred
        // focus (caret adapted to the type). `create-kind` picks the title/action; shortcut
        // mode (2) adds a "Target" field → taller card.
        if root.create-popup-open : ModalBackdrop { }
        if root.create-popup-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: root.create-kind == 2 ? 290px : (root.create-kind == 3 ? 258px : 220px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            DeferredLineEditFocus {
                armed <=> root.create-focus-armed;
                blocked: root.exit-warning-open;
                apply-focus => {
                    create-edit.focus();
                    // Only kind 0 is a folder. File, .lnk shortcut and
                    // symlink are all file entries and share the rule.
                    let offset = TextMetrics.rename-caret-offset(
                        root.create-name, root.create-kind == 0);
                    create-edit.set-selection-offsets(offset, offset);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.create-kind == 0
                        ? Strings.ctx-new-folder
                        : (root.create-kind == 1 ? Strings.ctx-new-file
                            : (root.create-kind == 2 ? Strings.ctx-new-shortcut
                                : Strings.ctx-create-link));
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                create-edit := EditLineEdit {
                    placeholder-text: Strings.create-placeholder;
                    text <=> root.create-name;
                    accepted(t) => {
                        if (root.create-can-confirm
                            && root.create-confirmed(root.create-kind, t, root.create-target)) {
                            root.create-popup-open = false;
                            // Returns focus to the view: a second Enter press opens
                            // the freshly created entry, which is selected.
                            key-scope.focus();
                        }
                    }
                }
                if root.create-kind == 0 || root.create-kind == 1 : Text {
                    text: root.create-name-error == "" ? " " : root.create-name-error;
                    color: Tokens.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                // Shortcut mode only. Two tabs, Folder / File:
                // they determine the type of "Browse…" picker (folder vs
                // file) — creating the .lnk is identical either way.
                if root.create-kind == 2 : HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Button {
                        text: Strings.prop-kind-folder;
                        primary: root.create-shortcut-folder;
                        clicked => { root.create-shortcut-folder = true; }
                    }
                    Button {
                        text: Strings.prop-kind-file;
                        primary: !root.create-shortcut-folder;
                        clicked => { root.create-shortcut-folder = false; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // "Target" field — the path can be typed OR chosen via the
                // native picker ("Browse…", folder or file depending on the tab).
                if root.create-kind == 2 : HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: Strings.create-shortcut-target;
                        font-size: 12px;
                        color: Theme.foreground.with-alpha(0.6);
                        vertical-alignment: center;
                    }
                    LineEdit {
                        placeholder-text: Strings.create-shortcut-target;
                        text <=> root.create-target;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: Strings.create-browse;
                        clicked => { root.create-browse-target(); }
                    }
                }
                // "Create link" mode (kind 3): Shortcut
                // (.lnk, Windows) / Symlink tabs, then a reminder of the target (selected
                // file). The link is created in the current folder.
                if root.create-kind == 3 : HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    // .lnk shortcut tab: Windows only.
                    if root.platform-windows : Button {
                        text: Strings.ctx-create-link;
                        primary: !root.create-link-symlink;
                        clicked => { root.create-link-symlink = false; }
                    }
                    Button {
                        text: Strings.create-symlink-tab;
                        primary: root.create-link-symlink;
                        clicked => { root.create-link-symlink = true; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.create-kind == 3 : Text {
                    text: "→ " + root.create-target;
                    font-size: 11px;
                    color: Theme.foreground.with-alpha(0.55);
                    overflow: elide;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.create-popup-open = false; }
                    }
                    Button {
                        text: Strings.create-confirm;
                        primary: true;
                        enabled: root.create-can-confirm;
                        clicked => {
                            if (root.create-confirmed(
                                root.create-kind, root.create-name, root.create-target
                            )) {
                                root.create-popup-open = false;
                                key-scope.focus(); // focus view → 2nd Enter opens the created entry
                            }
                        }
                    }
                }
            }
        }

        // ===== Cleanup list for colours and notes =====
        // What goes here is NOT a file — the file left long ago — but the
        // colour and the note it carried. A list of bare paths would hide the
        // very thing the question is about, so every row leads with what is
        // lost and keeps the path behind it, dimmed.
        //
        // Everything arrives ticked. Reaching this list already took opening
        // the settings and asking for a cleanup; what was missing was SEEING
        // what goes, not one more step to click through. Unticking is how an
        // entry is kept.
        if root.orphans-open : ModalBackdrop { }
        if root.orphans-open : Rectangle {
            // The width of the settings card underneath, so the two read as one
            // stack rather than two cards badly piled.
            width: 560px;
            // Grows with the list, then stops: nine rows at a time is what the
            // other lists of this application already show, and past that one
            // sweeps rather than reads.
            height: min(parent.height - 40px,
                min(620px, max(300px, 200px + root.orphan-rows.length * 46px)));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Image {
                        source: @image-url("../../assets/icons/trash.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Tokens.danger;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: Strings.annotations-cleanup-title;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                // The sentence the settings block already shows, word for word,
                // including what is never touched: one wording to keep true
                // rather than two that could drift.
                Text {
                    text: Strings.settings-annotations-hint;
                    font-size: 12px;
                    color: Theme.foreground.with-alpha(0.8);
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.alternate-background.with-alpha(0.5);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    // The count was taken when the panel opened; an item
                    // restored from the trash since then leaves nothing to do.
                    if root.orphan-rows.length == 0 : Text {
                        width: parent.width;
                        height: parent.height;
                        text: Strings.annotations-cleanup-empty;
                        font-size: 13px;
                        color: Theme.foreground.with-alpha(0.6);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.orphan-rows.length > 0 : ScrollView {
                        width: parent.width;
                        height: parent.height;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            for row in root.orphan-rows : Rectangle {
                                height: 44px;
                                border-radius: 5px;
                                background: orow.has-hover
                                    ? Theme.alternate-background
                                    : transparent;
                                // The whole row answers: a 16px box is a small
                                // target in a list one sweeps through.
                                orow := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.orphan-toggled(row.key, !row.checked);
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    MarkBox {
                                        checked: row.checked;
                                        y: (parent.height - self.height) / 2;
                                        toggled(on) => {
                                            root.orphan-toggled(row.key, on);
                                        }
                                    }
                                    // The colour, and under it the quote bar of
                                    // the note: one narrow column that reads as
                                    // a small stave down the left of the row.
                                    VerticalLayout {
                                        width: 14px;
                                        alignment: center;
                                        spacing: 2px;
                                        Rectangle {
                                            height: 14px;
                                            // No colour to lose: nothing is
                                            // drawn. An empty ring would be
                                            // wrong — in the palette it already
                                            // means "the default gold".
                                            if row.slot > 0 : Rectangle {
                                                width: 14px;
                                                height: 14px;
                                                border-radius: 4px;
                                                background: Tokens.folder-color(row.slot);
                                                opacity: row.checked ? 1.0 : 0.35;
                                                animate opacity {
                                                    duration: 110ms;
                                                    easing: ease-out;
                                                }
                                            }
                                        }
                                        if row.note != "" : Rectangle {
                                            height: 14px;
                                            Rectangle {
                                                x: 6px;
                                                width: 2px;
                                                height: 14px;
                                                border-radius: 1px;
                                                background: Theme.foreground.with-alpha(0.30);
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 0px;
                                            // The folder still exists — that is
                                            // the very rule that made this an
                                            // orphan — so it is context, not
                                            // the subject. Dimmed, and elided
                                            // from the LEFT: the tail, next to
                                            // the name, is what tells two alike
                                            // apart.
                                            Text {
                                                text: row.parent;
                                                font-size: 13px;
                                                color: Theme.foreground.with-alpha(
                                                    row.checked ? 0.50 : 0.28);
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: row.name;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.foreground.with-alpha(
                                                    row.checked ? 1.0 : 0.45);
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        if row.note != "" : Text {
                                            text: row.note;
                                            font-size: 12px;
                                            color: Theme.foreground.with-alpha(
                                                row.checked ? 0.72 : 0.32);
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 10px;
                    FieldLink {
                        text: Strings.annotations-cleanup-all;
                        clicked => { root.orphans-select-all(true); }
                    }
                    FieldLink {
                        text: Strings.annotations-cleanup-none;
                        clicked => { root.orphans-select-all(false); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.orphans-open = false; }
                    }
                    Button {
                        // Destructive, so deliberately NOT primary: the house
                        // rule is that an irreversible action lets Cancel go
                        // first. The label carries the count, so the last thing
                        // read before confirming is how many go.
                        text: root.orphans-confirm-label;
                        enabled: root.orphans-checked > 0;
                        clicked => {
                            root.orphans-confirmed();
                            root.orphans-open = false;
                        }
                    }
                }
            }
        }

        // ===== "Permanent deletion" popup =====
        // Shared between network-without-trash and Shift+Delete. Delete button is
        // secondary (not primary): the action is irreversible, Cancel comes first.
        if root.delete-warning-open : ModalBackdrop { }
        // ===== "Open all these files?" =====
        // Enter on a selection of files opens every one of them. Past a
        // threshold each launch is an application, so the count is put in front
        // of the user first: a selection made with Ctrl+A and an Enter pressed
        // out of habit would otherwise start a few hundred at once. The body
        // carries the count, interpolated by the bridge.
        if root.open-many-open : ModalBackdrop { }
        if root.open-many-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 196px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: Strings.open-many-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.open-many-body;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.open-many-open = false; }
                    }
                    Button {
                        text: Strings.open-many-confirm;
                        primary: true;
                        clicked => {
                            root.open-many-confirmed();
                            root.open-many-open = false;
                        }
                    }
                }
            }
        }

        if root.delete-warning-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 196px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: Strings.net-delete-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.delete-warning-from-trash ? Strings.trash-delete-body
                        : root.delete-warning-permanent ? Strings.permanent-delete-body
                        : Strings.net-delete-body;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.btn-cancel;
                        clicked => { root.delete-warning-open = false; }
                    }
                    Button {
                        // "Delete permanently" (NOT "trash": on
                        // a network volume the deletion is irreversible).
                        text: Strings.net-delete-confirm;
                        clicked => {
                            root.delete-warning-confirmed();
                            root.delete-warning-open = false;
                        }
                    }
                }
            }
        }

        // ===== "Unsaved changes" dialog (safety guard) =====
        // Opens when asked to load ANOTHER workspace while
        // the current one has unsaved changes. Rendered at the
        // window level (after the Workspaces overlay, which stays open behind it)
        // to layer cleanly on top. Three outcomes: load without saving
        // (red, destructive, on the left), Cancel (neutral / cross), save
        // and load (primary = default). Title & body are interpolated by the bridge.
        // Dim absorbs clicks WITHOUT closing (default): this warning needs an
        // explicit choice from its own buttons.
        if root.ws-dirty-warn-open : ModalBackdrop { }
        if root.ws-dirty-warn-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 500px;
            height: 280px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            // Close cross (= Cancel) in the top-right corner.
            close-x := TouchArea {
                x: parent.width - 34px;
                y: 10px;
                width: 24px;
                height: 24px;
                mouse-cursor: pointer;
                clicked => { root.ws-dirty-warn-open = false; }
                Image {
                    width: 14px;
                    height: 14px;
                    source: @image-url("../../assets/icons/close.svg");
                    colorize: close-x.has-hover ? Theme.foreground : Theme.foreground.with-alpha(0.5);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    Image {
                        width: 22px;
                        height: 22px;
                        source: @image-url("../../assets/icons/alert-triangle.svg");
                        colorize: Tokens.warning;
                    }
                    Text {
                        text: root.ws-dirty-title-text;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    Rectangle { width: 20px; } // reserves space for the cross
                }
                Text {
                    text: root.ws-dirty-body-text;
                    wrap: word-wrap;
                    color: Theme.foreground.with-alpha(0.8);
                }
                Rectangle { vertical-stretch: 1; }
                CheckBox {
                    text: root.ws-dirty-shortcut ? Strings.ws-shortcut-remember
                        : Strings.ws-panel-remember;
                    checked <=> root.ws-dirty-remember;
                }
                HorizontalLayout {
                    spacing: 8px;
                    // Destructive on the left (red ghost): executes the pending
                    // action WITHOUT saving — loads the target, or starts
                    // fresh if the pending action is a "new workspace".
                    WsButton {
                        label: root.ws-dirty-reset ? Strings.ws-dirty-discard-new
                            : Strings.ws-dirty-discard;
                        danger: true;
                        clicked => {
                            root.ws-discard-and-load();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // Neutral: Cancel.
                    WsButton {
                        label: Strings.btn-cancel;
                        clicked => { root.ws-dirty-warn-open = false; }
                    }
                    // Primary (default): save the current one THEN load the target.
                    WsButton {
                        label: root.ws-dirty-reset ? Strings.ws-dirty-save-new
                            : Strings.ws-dirty-save-load;
                        primary: true;
                        clicked => { root.ws-save-and-load(); }
                    }
                }
            }
        }

        // ===== Paste conflict popup =====
        // Opens when a pasted item has a name that already exists in the
        // folder. The user confirms the proposed name (`… - Copy01`) or
        // types another one (protected against collisions). Opening/closing
        // is driven by the bridge (chaining multiple conflicts).
        if root.paste-conflict-open : ModalBackdrop { }
        if root.paste-conflict-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: 300px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            DeferredLineEditFocus {
                armed <=> root.paste-conflict-focus-armed;
                blocked: root.exit-warning-open;
                apply-focus => {
                    pc-edit.focus();
                    let offset = TextMetrics.rename-caret-offset(
                        root.paste-conflict-name, root.paste-conflict-is-dir);
                    pc-edit.set-selection-offsets(offset, offset);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: Strings.paste-conflict-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.paste-conflict-original;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.foreground.with-alpha(0.8);
                    overflow: elide;
                }
                Text {
                    text: Strings.paste-conflict-hint;
                    font-size: 12px;
                    color: Theme.foreground.with-alpha(0.55);
                    wrap: word-wrap;
                }
                pc-edit := EditLineEdit {
                    text <=> root.paste-conflict-name;
                    edited(t) => { root.paste-conflict-check(t); }
                    accepted(t) => {
                        if (!root.paste-conflict-name-taken && t != "") {
                            root.paste-conflict-confirm(t);
                        }
                    }
                }
                Text {
                    text: root.paste-conflict-name-taken ? Strings.paste-conflict-taken : " ";
                    font-size: 11px;
                    color: Tokens.danger;
                }
                Rectangle { vertical-stretch: 1; }
                // Row 1 — replace (this item / all) · skip. HIDDEN for
                // a copy within the same folder (rename only).
                if !root.paste-conflict-rename-only : HorizontalBox {
                    padding: 0px;
                    Button {
                        text: Strings.paste-conflict-replace;
                        clicked => { root.paste-conflict-replace(); }
                    }
                    Button {
                        text: Strings.paste-conflict-replace-all;
                        clicked => { root.paste-conflict-replace-all(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.paste-conflict-skip;
                        clicked => { root.paste-conflict-skip(); }
                    }
                    Button {
                        text: Strings.paste-conflict-skip-all;
                        clicked => { root.paste-conflict-skip-all(); }
                    }
                }
                // Row 2 — cancel / rename.
                HorizontalBox {
                    padding: 0px;
                    Button {
                        text: Strings.btn-cancel;
                        clicked => {
                            root.paste-conflict-open = false;
                            root.paste-conflict-cancel();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Strings.paste-conflict-confirm;
                        primary: true;
                        enabled: !root.paste-conflict-name-taken && root.paste-conflict-name != "";
                        clicked => { root.paste-conflict-confirm(root.paste-conflict-name); }
                    }
                }
            }
        }

        // ===== Non-blocking progress toasts, stacked bottom-right =====
        // Cards are drawn upwards from the bottom corner. Past the third one the
        // stack would eat the window, so the remainder is summarised by the chip
        // below. Each card runs its own auto-dismiss countdown.
        for op[i] in root.ops : ProgressToast {
            visible: i < 3;
            x: parent.width - self.width - 16px;
            y: parent.height - 16px - (i + 1) * 88px - i * 8px;
            op-state: op.state;
            progress: op.progress;
            indeterminate: op.indeterminate;
            title: op.title;
            detail: op.detail;
            percent: op.percent;
            cancel-label: Strings.btn-cancel;
            cancel => { root.op-cancel(op.id); }
            dismiss => { root.op-dismiss(op.id); }
        }
        // Sits one slot above the third card, on the same right edge.
        if root.ops.length > 3 : Rectangle {
            x: parent.width - self.width - 16px;
            y: parent.height - 16px - 3 * 88px - 3 * 8px - 32px;
            width: 360px;
            height: 32px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            // Absorbs clicks on the chip (but NOT elsewhere → non-blocking).
            TouchArea { }
            Text {
                text: root.ops-more-text;
                font-size: 12px;
                color: Theme.foreground.with-alpha(0.7);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ===== Drag-and-drop indicator — pill following the cursor =====
        // Icon, tint and label reflect the action in real time. It rides a FILE
        // drag anywhere, a TAB drag while it hovers the favorites, and a sidebar
        // location drag while no tab gap or panel zone can accept it. A
        // favorite that only supports reordering uses the same forbidden state
        // outside its tree. Over the favorites, a file/tab drag reads as "Add to
        // favorites"; otherwise the file action drives it: open with the
        // executable target, copy (Ctrl), or move/menu.
        if root.file-drag-active
                || (root.drag-active && fav-panel.hover-panel)
                || root.sidebar-item-drop-will-cancel
                || root.favorite-reorder-drop-will-cancel : drag-pill := Rectangle {
            // A drag over the favorites bookmarks the target — same for a file
            // or a tab drag — which outranks the file-specific move/copy states.
            property <bool> over-fav: fav-panel.hover-panel;
            property <bool> manual-reorder: !root.folder-open-drag-active && root.file-drag-manual-gap >= 0;
            property <bool> exec-drop: !root.folder-open-drag-active && root.file-drag-target-exec
                && root.file-drag-manual-gap < 0;
            // An exact tab insertion wins over a panel's split zone on release.
            property <bool> split-drop: root.folder-open-drag-active
                && !(root.drag-target-gap-panel >= 0 && root.drag-target-gap >= 0)
                && root.directory-panel-drop-valid && root.drag-target-zone >= 2;
            // File drags and non-droppable location/reorder drags share the
            // same compact forbidden state. Valid sidebar and favorite targets
            // already have an insertion line or panel preview, so this is only
            // a no-op.
            property <bool> will-cancel:
                root.file-drop-will-cancel
                || (root.folder-open-drag-active && !root.fav-hover-panel
                    && !(root.drag-target-gap-panel >= 0 && root.drag-target-gap >= 0)
                    && !root.directory-panel-drop-valid)
                || root.sidebar-item-drop-will-cancel
                || root.favorite-reorder-drop-will-cancel;
            // Beside the cursor (not underneath). File, location and pure
            // favorite-reorder drags each contribute their live coordinates.
            x: (root.file-drag-active
                ? root.file-drag-abs-x
                : (root.favorite-reorder-drop-will-cancel
                    ? fav-panel.reorder-drag-abs-x
                    : root.drag-abs-x)) + 14px;
            y: (root.file-drag-active
                ? root.file-drag-abs-y
                : (root.favorite-reorder-drop-will-cancel
                    ? fav-panel.reorder-drag-abs-y
                    : root.drag-abs-y)) + 12px;
            width: drag-feedback-row.preferred-width + 18px;
            height: 26px;
            border-radius: 7px;
            // Favorites first (accent). Otherwise the NON-DROPPABLE ZONE takes
            // priority (red + "forbidden"), then exec, copy, move. A single
            // element (no separate floating badge) → lighter display.
            background: drag-pill.over-fav
                ? Theme.accent-background
                : (drag-pill.will-cancel
                    ? Tokens.danger
                    : (drag-pill.manual-reorder
                        ? Theme.accent-background
                        : (drag-pill.exec-drop
                        ? Tokens.warning
                        : (root.file-drag-action == 1 && !root.folder-open-drag-active
                            ? Tokens.success : Theme.accent-background))));
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drag-feedback-row := HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 7px;
                // An Image directly nested in a Layout is top-aligned
                // by Slint. The full-height slot guarantees vertical centering.
                Rectangle {
                    width: 15px;
                    Image {
                        width: 15px;
                        height: 15px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: drag-pill.over-fav
                            ? @image-url("../../assets/icons/bookmark.svg")
                            : (drag-pill.will-cancel
                                ? @image-url("../../assets/icons/no-drop.svg")
                                : (drag-pill.manual-reorder
                                    ? @image-url("../../assets/icons/move.svg")
                                    : (drag-pill.exec-drop
                                    ? @image-url("../../assets/icons/application.svg")
                                    : (root.folder-open-drag-active
                                        ? @image-url("../../assets/icons/folder.svg")
                                        : (root.file-drag-action == 1
                                        ? @image-url("../../assets/icons/plus.svg")
                                        : @image-url("../../assets/icons/move.svg"))))));
                        colorize: Theme.accent-foreground;
                    }
                }
                // Invalid destinations hide the action label.
                // Favorites always retain their action label.
                if drag-pill.over-fav || !drag-pill.will-cancel : Text {
                    text: drag-pill.over-fav
                        ? Strings.drop-favorite
                        : (drag-pill.manual-reorder
                            ? Strings.manual-order-drag
                            : (drag-pill.exec-drop
                            ? Strings.drag-open-with
                            : (root.folder-open-drag-active
                                ? (drag-pill.split-drop ? Strings.drop-split : Strings.ctx-open-new-tab)
                                : (root.file-drag-action == 1 ? Strings.drop-copy : Strings.drop-move))));
                    font-size: 11px;
                    color: Theme.accent-foreground;
                    vertical-alignment: center;
                }
            }
        }

        // Layout feedback shared by whole views, tabs and sidebar directories.
        // Tab insertion gaps keep their own preview without an extra pill.
        if root.view-drag-active || root.panel-layout-drop : layout-drop-pill := Rectangle {
            property <bool> whole-view: root.view-drag-active;
            property <bool> outside: self.whole-view && root.view-drag-outside;
            property <bool> accepted: self.whole-view ? root.view-drag-target >= 0 : root.panel-layout-drop;
            property <int> zone: self.whole-view ? root.view-drag-target-zone : root.drag-target-zone;
            x: (self.whole-view ? root.view-drag-abs-x : root.drag-abs-x) + 14px;
            y: (self.whole-view ? root.view-drag-abs-y : root.drag-abs-y) + 12px;
            width: layout-drop-pill-row.preferred-width + 18px;
            height: 26px;
            border-radius: 7px;
            // Leaving the window is a placement ELSEWHERE, not a loss:
            // accent, never red. The red is kept for "releasing here does
            // nothing at all".
            background: (self.accepted || self.outside)
                ? Theme.accent-background
                : Tokens.danger;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            layout-drop-pill-row := HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 7px;
                // An Image nested directly in a layout is top-aligned by
                // Slint; the full-height slot centres it.
                Rectangle {
                    width: 15px;
                    Image {
                        width: 15px;
                        height: 15px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: layout-drop-pill.outside
                            ? @image-url("../../assets/icons/detach.svg")
                            : (layout-drop-pill.accepted
                                ? (layout-drop-pill.zone == 1
                                    ? (layout-drop-pill.whole-view
                                        ? @image-url("../../assets/icons/swap.svg")
                                        : (root.drag-active ? @image-url("../../assets/icons/move.svg")
                                            : @image-url("../../assets/icons/folder.svg")))
                                    : (layout-drop-pill.zone >= 4
                                        ? @image-url("../../assets/icons/split-stacked.svg")
                                        : @image-url("../../assets/icons/split.svg")))
                                : @image-url("../../assets/icons/no-drop.svg"));
                        colorize: Theme.accent-foreground;
                    }
                }
                // Nothing under the cursor → the icon alone and the pill
                // shrinks to a dot, the same abbreviation the file pill uses.
                if layout-drop-pill.accepted || layout-drop-pill.outside : Text {
                    text: layout-drop-pill.outside
                        ? Strings.drop-detach
                        : (layout-drop-pill.zone != 1 ? Strings.drop-split
                            : (layout-drop-pill.whole-view ? Strings.drop-swap
                                : (root.drag-active ? Strings.drop-move : Strings.ctx-open-new-tab)));
                    font-size: 11px;
                    color: Theme.accent-foreground;
                    vertical-alignment: center;
                }
            }
        }

        // ===== GLOBAL "notice" toast (bottom-center, non-blocking) =====
        // Transient feedback for silent cases (e.g. access denied to an
        // unreadable folder, which would otherwise look like an empty folder). Subtle
        // "danger" tint + lock icon. Auto-dismiss after 2.8s.
        if root.notice-text != "" : notice-box := Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 18px;
            height: max(38px, notice-row.preferred-height + 16px);
            width: min(notice-row.preferred-width + 32px, parent.width - 32px);
            border-radius: 10px;
            // Tint based on tone: success green · info accent · danger red.
            property <color> tone-color: root.notice-tone == 1
                ? Tokens.success
                : (root.notice-tone == 2 ? Theme.accent-background : Tokens.danger);
            background: root.notice-tone == 1
                ? Theme.toast-success
                : (root.notice-tone == 2
                    ? Theme.toast-info
                    : Theme.toast-danger);
            border-width: 1px;
            border-color: self.tone-color.with-alpha(0.45);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow.with-alpha(0.30);
            drop-shadow-offset-y: 3px;
            notice-row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 9px;
                Image {
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                    // 0 lock · 1 open lock · 2 check · 3 bookmark · 4 gear.
                    source: root.notice-icon == 1
                        ? @image-url("../../assets/icons/unlock.svg")
                        : (root.notice-icon == 2
                            ? @image-url("../../assets/icons/check.svg")
                            : (root.notice-icon == 3
                                ? @image-url("../../assets/icons/bookmark.svg")
                                : (root.notice-icon == 4
                                    ? @image-url("../../assets/icons/gear.svg")
                                    : @image-url("../../assets/icons/lock.svg"))));
                    colorize: notice-box.tone-color;
                }
                Text {
                    text: root.notice-text;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
        }
        Timer {
            interval: root.notice-duration;
            running: root.notice-text != "";
            triggered => { root.notice-text = ""; }
        }
        // Auto-expand: a collapsed container hovered during a drag
        // expands after a short delay (in-place insertion on the bridge side → the ongoing
        // drag survives). The countdown restarts on every change of
        // hovered container.
        fav-autoexp-timer := Timer {
            interval: 650ms;
            running: root.fav-drag-active && root.fav-drag-hover-container != "";
            triggered => { root.fav-expand(root.fav-drag-hover-container); }
        }
        // Also auto-expands during a TAB or FILE drag over a
        // collapsed container — makes the gesture consistent with internal drag.
        // `root.fav-ext-collapsed` (declared at the root) tracks
        // `fav-panel.hover-collapsed-container`; its `changed` (at the root) restarts
        // this countdown.
        fav-autoexp-ext-timer := Timer {
            interval: 650ms;
            running: (root.drag-active || root.file-drag-active)
                && root.fav-ext-collapsed != "";
            triggered => { root.fav-expand(root.fav-ext-collapsed); }
        }
        // Auto-expands the whole COLLAPSED favorites section when a tab/file drag
        // dwells on its header → the tree appears so the drop can land, instead of
        // the gesture doing nothing over a folded section. Purely declarative (no
        // imperative restart): it arms only while the drag actually hovers the
        // header, fires once after 650ms, and expanding flips
        // `hover-collapsed-section` false so `running` drops — it cannot re-fire
        // or loop, and leaves no pending fire to re-expand a section the user
        // later collapses.
        Timer {
            interval: 650ms;
            running: (root.drag-active || root.file-drag-active)
                && fav-panel.hover-collapsed-section;
            triggered => {
                root.fav-section-collapsed = false;
                root.sidebar-section-state-changed(2, false);
            }
        }
        Timer {
            interval: 50ms;
            running: root.file-drag-refresh-pending && !root.file-drag-active
                && !root.file-drop-menu-open && !root.op-busy;
            triggered => {
                root.file-drag-refresh-pending = false;
                root.refresh();
            }
        }
        // Drive change detection: subst, USB, `net use`,
        // mount… don't always emit a system event. We probe the
        // signature only while the "Locations" panel is open;
        // the bridge only rebuilds the sidebar if it changed (near-zero cost).
        Timer {
            interval: 1500ms;
            running: root.left-panel == 1;
            triggered => { root.poll-drives(); }
        }
        Timer {
            interval: 1500ms;
            running: true;
            triggered => { root.poll-annotations(); }
        }
        // Cross-instance IPC init: shortly after startup (the window
        // exists → HWND available for tagging + subclassing). RETRIES as long
        // as the bridge returns `false` (window not found yet).
        ipc-init-timer := Timer {
            interval: 250ms;
            running: true;
            triggered => { if (root.init-ipc()) { ipc-init-timer.running = false; } }
        }
        // Watch mount changes only while a view is unavailable. Retries use
        // background listings without opening authentication dialogs.
        Timer {
            interval: 2s;
            running: root.any-unavailable;
            triggered => { root.recheck-unavailable(); }
        }
        // Closes the "Open with", "New", and Windows shell sub-menu cascade
        // flyouts when neither the parent entry nor the flyout is hovered
        // (small delay → tolerates passing through the gap between them).
        FlyoutCloseTimer {
            open <=> root.mark-menu-open;
            parent-hover: root.mark-parent-hover;
            flyout-hover: root.mark-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.ow-menu-open;
            parent-hover: root.ow-parent-hover;
            flyout-hover: root.ow-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.new-menu-open;
            parent-hover: root.new-parent-hover;
            flyout-hover: root.new-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.folder-menu-open;
            parent-hover: root.folder-menu-reveal ? root.folder-reveal-parent-hover : root.folder-pane-parent-hover;
            flyout-hover: root.folder-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.ctx-shell-sub-open;
            parent-hover: root.ctx-shell-sub-parent-hover;
            flyout-hover: root.ctx-shell-sub-flyout-hover;
        }

        // ===== "Custom command" popup — rendered LAST
        // (so it sits above Settings → editing from the "Open with" tab).
        if root.ow-popup-open : ModalBackdrop { }
        if root.ow-popup-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            // Sized to its OWN content — the form plus the pinned footer — so
            // every field (down to the last checkbox) shows without scrolling,
            // in any language and whether or not the Windows admin row is there.
            // Clamped to the window (the card is centred): only on a short window
            // (or at 150% scale) does the form fall back to scrolling.
            // `max(preferred, min)`: a bare LineEdit and a Button declare a
            // preferred height of 0 with a minimum of 32, so summing the
            // preferred alone can under-measure the card and make the form
            // scroll on a screen that had room for it.
            height: min(
                max(owp-form.preferred-height, owp-form.min-height)
                    + max(owp-footer.preferred-height, owp-footer.min-height) + 3px,
                parent.height - 32px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            Timer {
                interval: 1ms;
                running: root.ow-popup-focus-armed && !root.exit-warning-open;
                triggered => {
                    owp-name.focus();
                    owp-name.set-selection-offsets(0, 99999);
                    root.ow-popup-focus-armed = false;
                }
            }
            // Card body: a scrollable form ABOVE a pinned footer. The footer
            // (Cancel/Save) lives outside the scroll area so it stays visible
            // however tall the form is or however short the window — the user
            // never has to scroll to reach it. The form itself still scrolls as
            // a fallback on a very short window (or at 150% scale) instead of
            // spilling past the card's edges.
            VerticalLayout {
            ScrollView {
                vertical-stretch: 1;
            owp-form := VerticalBox {
                padding: 18px;
                spacing: 11px;   // a bit more breathing room between fields
                Text { text: Strings.ow-title; font-size: 16px; font-weight: 700; color: Theme.foreground; }
                Text { text: Strings.ow-name; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                owp-name := EditLineEdit { text <=> root.ow-popup-name; }
                Text { text: Strings.ow-program; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                // OS/Store app (association, no exe): FIXED field + label — avoids an
                // editable empty field the user might mistake for broken.
                if root.ow-popup-is-store : Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.alternate-background.with-alpha(0.45);
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: Strings.ow-store-program;
                            font-size: 12px;
                            font-italic: true;
                            color: Theme.foreground.with-alpha(0.55);
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                // Editable program + "Browse…" button (native exe picker).
                if !root.ow-popup-is-store : HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    LineEdit { text <=> root.ow-popup-program; horizontal-stretch: 1; edited(t) => { root.ow-popup-changed(); } }
                    Button { text: "…"; clicked => { root.ow-browse(); } }
                }
                Text { text: Strings.ow-args; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                owp-args := HintEdit { hint: "{file}"; text <=> root.ow-popup-args; read-only: root.ow-popup-archive-dialog; edited(t) => { root.ow-popup-changed(); } }
                if !root.ow-popup-is-store && root.ow-popup-icon-kind == 1 : CheckBox {
                    text: Strings.archive-managed;
                    checked <=> root.ow-popup-archive-dialog;
                    toggled => {
                        if (self.checked) { root.ow-popup-elevated = false; }
                        root.ow-popup-changed();
                    }
                }
                if root.ow-popup-archive-dialog : Text {
                    text: Strings.archive-managed-hint;
                    color: Theme.foreground.with-alpha(0.65);
                    font-size: 11px;
                    wrap: word-wrap;
                }
                // Tag insertion buttons, one per tag the core substitutes.
                // The label sits on its OWN line: sharing a row with six
                // buttons left too little room in longer languages and at 150%
                // scale. Hovering a button explains what it stands for.
                Text { text: Strings.ow-tags; font-size: 11px; color: Theme.foreground.with-alpha(0.55); }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    for t in [
                        { tag: "{file}", hint: Strings.ow-tag-file },
                        { tag: "{dir}", hint: Strings.ow-tag-dir },
                        { tag: "{dirname}", hint: Strings.ow-tag-dirname },
                        { tag: "{setname}", hint: Strings.ow-tag-setname },
                        { tag: "{name}", hint: Strings.ow-tag-name },
                        { tag: "{stem}", hint: Strings.ow-tag-stem },
                        { tag: "{ext}", hint: Strings.ow-tag-ext },
                        { tag: "{uri}", hint: Strings.ow-tag-uri },
                        { tag: "{files}", hint: Strings.ow-tag-files },
                    ] : Rectangle {
                        width: tagtxt.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        // Filled rather than outlined: these insert text, they
                        // are not toggles, and six more outlines next to the
                        // field borders above only added noise.
                        border-width: 1px;
                        border-color: tagta.has-hover ? Theme.accent-background : transparent;
                        background: tagta.has-hover
                            ? Theme.accent-background.with-alpha(0.18)
                            : Theme.foreground.with-alpha(0.07);
                        tagtxt := Text { text: t.tag; font-size: 11px; font-weight: 500; color: Tokens.ext; x: (parent.width - self.width)/2; vertical-alignment: center; height: parent.height; }
                        tagta := TouchArea {
                            enabled: !root.ow-popup-archive-dialog;
                            mouse-cursor: pointer;
                            clicked => {
                                root.ow-popup-args = root.ow-popup-args == "" ? t.tag : root.ow-popup-args + " " + t.tag;
                                root.ow-popup-changed();
                                // Scroll the field to the freshly appended tag:
                                // on a long command it lands out of sight and the
                                // click would otherwise look like it did nothing.
                                owp-args.focus-end();
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    Tip.text = t.hint;
                                    Tip.x = self.absolute-position.x;
                                    Tip.y = self.absolute-position.y - 26px;
                                } else if (Tip.text == t.hint) {
                                    Tip.text = "";
                                }
                            }
                        }
                    }
                }
                // Command preview. Monospace and wrapped over two lines rather
                // than elided: elision cut the END of the line, which is exactly
                // the arguments being typed. Argument boundaries are quoted by
                // the bridge, so a path containing spaces no longer reads as two
                // arguments.
                Text { text: Strings.ow-preview; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                Text {
                    text: root.ow-popup-preview;
                    font-family: "monospace";
                    font-size: 11px;
                    color: Theme.foreground.with-alpha(0.85);
                    wrap: word-wrap;
                    height: 26px;   // two lines at 11px; beyond that, elide
                    overflow: elide;
                }
                // How many processes this will start — the rule that decides it
                // (a tag in the arguments) was otherwise invisible.
                Text {
                    text: root.ow-popup-runs;
                    font-size: 10px;
                    color: Theme.foreground.with-alpha(0.55);
                    overflow: elide;
                }
                // "Custom default app": extensions opened with this
                // program on double-click, instead
                // of the OS default. Hoverable label → explanatory tooltip.
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Rectangle {
                        width: owdef-txt.preferred-width;
                        owdef-txt := Text {
                            text: Strings.ow-default-ext;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.55);
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        owdef-ta := TouchArea {
                            // Signals that this label carries an explanation;
                            // nothing else marked it as hoverable.
                            mouse-cursor: help;
                            changed has-hover => {
                                if (self.has-hover) {
                                    Tip.text = Strings.ow-default-ext-hint;
                                    Tip.x = self.absolute-position.x;
                                    Tip.y = self.absolute-position.y - 26px;
                                } else if (Tip.text == Strings.ow-default-ext-hint) {
                                    Tip.text = "";
                                }
                            }
                        }
                    }
                    HintEdit { hint: Strings.ow-default-ext-placeholder; text <=> root.ow-popup-default-ext; horizontal-stretch: 1; }
                }
                // "Where to show this command" box: groups the TWO
                // visibility settings for the per-extension "Open with" flyout and
                // the views' context menu.
                Rectangle {
                    background: Theme.alternate-background.with-alpha(0.5);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text {
                            text: Strings.ow-show-in-section;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.foreground.with-alpha(0.6);
                            letter-spacing: 0.5px;
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            // Wrapped like its twin above: a bare Text gets
                            // squeezed by the field once the label grows, and
                            // this is the narrowest row of the popup in German.
                            Rectangle {
                                width: owused-txt.preferred-width;
                                owused-txt := Text {
                                    text: Strings.ow-used-ext;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                owused-ta := TouchArea {
                                    mouse-cursor: help;
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            Tip.text = Strings.ow-used-ext-hint;
                                            Tip.x = self.absolute-position.x;
                                            Tip.y = self.absolute-position.y - 26px;
                                        } else if (Tip.text == Strings.ow-used-ext-hint) {
                                            Tip.text = "";
                                        }
                                    }
                                }
                            }
                            HintEdit { hint: Strings.ow-used-ext-placeholder; text <=> root.ow-popup-used-ext; horizontal-stretch: 1; }
                        }
                        // Label on ITS OWN line: shared with the 3 checkboxes on
                        // a single row, it didn't leave enough room for the
                        // last label ("Background…", "Ansichtshintergrund")
                        // which overflowed in longer languages and/or at 150% scale.
                        Text {
                            text: Strings.ow-ctx-menu;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.55);
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            CheckBox { text: Strings.ow-ctx-files; checked <=> root.ow-popup-ctx-file; }
                            CheckBox { text: Strings.ow-ctx-dirs; checked <=> root.ow-popup-ctx-dir; }
                            CheckBox { text: Strings.ow-ctx-background; checked <=> root.ow-popup-ctx-bg; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        // Extension filter of the FILE entry — folders and the
                        // view background have none. Shown only with that box
                        // ticked: a filter that visibly filters nothing is
                        // noise, and the popup's scarce resource is height.
                        // Indented by 18px indicator + 12px checkbox spacing so
                        // the label starts under the word "Files" it qualifies.
                        if root.ow-popup-ctx-file : HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            // Gutter + spacing = 30px, the checkbox indicator
                            // (18) plus its internal spacing (12), so the label
                            // still starts under the word "Files". The elbow
                            // arrow sits under the box it descends from, making
                            // the subordination visible rather than implied.
                            Rectangle {
                                width: 22px;
                                Image {
                                    source: @image-url("../../assets/icons/corner-down-right.svg");
                                    width: 12px;
                                    height: 12px;
                                    x: 6px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.foreground.with-alpha(0.35);
                                }
                            }
                            Rectangle {
                                width: owctx-txt.preferred-width;
                                owctx-txt := Text {
                                    text: Strings.ow-ctx-ext;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                owctx-ta := TouchArea {
                                    mouse-cursor: help;
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            Tip.text = Strings.ow-ctx-ext-hint;
                                            Tip.x = self.absolute-position.x;
                                            Tip.y = self.absolute-position.y - 26px;
                                        } else if (Tip.text == Strings.ow-ctx-ext-hint) {
                                            Tip.text = "";
                                        }
                                    }
                                }
                            }
                            // Hint "*" rather than "png, jpg": emptying the
                            // field then shows what to type to mean "every
                            // file", and tells this field apart from the two
                            // other extension fields above.
                            HintEdit { hint: "*"; text <=> root.ow-popup-ctx-ext; horizontal-stretch: 1; }
                        }
                    }
                }
                // "Run as administrator" (UAC elevation) — Windows
                // ONLY and excluding OS/Store apps (an association can't be elevated).
                // Unchecked by default and placed at the bottom, since it configures the
                // launch behavior rather than the command's visibility.
                if root.platform-windows && !root.ow-popup-is-store && !root.ow-popup-archive-dialog : HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    CheckBox {
                        text: Strings.ow-run-as-admin;
                        checked <=> root.ow-popup-elevated;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            }
            // Footer pinned OUTSIDE the scroll body: Cancel/Save stay visible no
            // matter how tall the form grows or how short the window is. The
            // hairline marks the edge when the form scrolls under it.
            Rectangle { height: 1px; background: Theme.border; }
            owp-footer := HorizontalBox {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 18px;
                // A custom command is always saved:
                // `ow-popup-add` stays true and no one-off mode is offered.
                Rectangle { horizontal-stretch: 1; }
                Button { text: Strings.btn-cancel; clicked => { root.ow-popup-open = false; } }
                Button {
                    text: Strings.fav-save;
                    primary: true;
                    enabled: root.ow-popup-valid;
                    clicked => { root.ow-popup-commit(); root.ow-popup-open = false; }
                }
            }
            }
        }

        // Dwell before a note bubble appears, and the wait that hides it
        // again. Same polling shape as `FlyoutCloseTimer`: the note is shown
        // only once the pointer has rested on the same row for a whole tick,
        // so crossing a list on the way somewhere else never flashes one.
        // The timer stops itself as soon as nothing is pending and nothing is
        // shown, rather than ticking for the life of the window.
        Timer {
            interval: 220ms;
            running: Note.pending != "" || Note.text != "";
            triggered => {
                if (Note.pending != "" && Note.pending == Note.last-seen) {
                    Note.text = Note.pending;
                    Note.x = Note.pending-x;
                    Note.shown-top = Note.row-top;
                    Note.shown-bottom = Note.row-bottom;
                } else {
                    Note.text = "";
                }
                Note.last-seen = Note.pending;
            }
        }

        // ===== The note attached to an entry, rendered just under the global
        // tooltip: a tooltip is the more transient of the two, so it wins.
        //
        // The bubble takes the width of the note it carries, capped at
        // 280px — the width the shell cascade already uses, and narrow enough
        // that the bubble never blankets the row it annotates. A short note
        // therefore gets a short bubble instead of a wide, mostly empty one.
        //
        // `preferred-width` is the text's OWN measure, what a single line
        // would need; it does not depend on the box the text sits in, so
        // reading it to size that box closes no circle. Beyond the cap the
        // text wraps and the height follows.
        if Note.text != "" : note-bubble := Rectangle {
            property <length> box-w: min(280px, gnote.preferred-width + 24px);
            x: clamp(Note.x, 4px, max(4px, parent.width - self.width - 4px));
            // Under the row by default; above it when the window ends too soon.
            // Clamping instead would drop the bubble onto the very row it
            // describes, hiding what the user is pointing at.
            y: (Note.shown-bottom + 4px + self.height <= parent.height - 4px)
                ? Note.shown-bottom + 4px
                : max(4px, Note.shown-top - 4px - self.height);
            width: self.box-w;
            height: gnote.preferred-height + 20px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            gnote := Text {
                x: 12px;
                y: 10px;
                width: note-bubble.box-w - 24px;
                text: Note.text;
                font-size: 12px;
                color: Theme.foreground;
                wrap: word-wrap;
                horizontal-alignment: left;
            }
        }

        // Archive prompts share the application's modal and keyboard rules.
        if root.archive-open : ModalBackdrop { }
        if root.archive-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 32px);
            height: min(max(archive-form.preferred-height, archive-form.min-height)
                + max(archive-footer.preferred-height, archive-footer.min-height),
                parent.height - 32px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                ScrollView {
                    vertical-stretch: 1;
                    archive-form := VerticalBox {
                        padding: 18px;
                        spacing: 10px;
                        Text {
                            text: root.archive-password-only ? Strings.archive-password-title : Strings.archive-compress-to;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.foreground;
                            wrap: word-wrap;
                        }
                        Text { text: root.archive-subject; color: Theme.foreground.with-alpha(0.65); font-size: 11px; wrap: word-wrap; }
                        if !root.archive-password-only : VerticalLayout {
                            spacing: 8px;
                            Text { text: Strings.archive-name; color: Theme.foreground; }
                            archive-name-edit := EditLineEdit { text <=> root.archive-name; }
                            Timer {
                                interval: 1ms;
                                running: root.archive-focus-armed && !root.exit-warning-open;
                                triggered => {
                                    archive-name-edit.focus();
                                    archive-name-edit.set-selection-offsets(0, 99999);
                                    root.archive-focus-armed = false;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: Strings.archive-format; color: Theme.foreground; vertical-alignment: center; }
                                ComboBox { model: [".zip", ".7z", ".tar"]; current-index <=> root.archive-format; horizontal-stretch: 1; }
                            }
                            if root.archive-format == 2 : HorizontalLayout {
                                spacing: 12px;
                                Text { text: Strings.archive-tar-compression; color: Theme.foreground; vertical-alignment: center; }
                                ComboBox {
                                    model: [Strings.archive-none, "gzip", "XZ", "BZip2"];
                                    current-index <=> root.archive-tar-compression;
                                    horizontal-stretch: 1;
                                }
                            }
                            if root.archive-format != 2 || root.archive-tar-compression != 0 : HorizontalLayout {
                                spacing: 12px;
                                Text { text: Strings.archive-level; color: Theme.foreground; vertical-alignment: center; }
                                ComboBox { model: ["0", "1", "3", "5", "7", "9"]; current-index <=> root.archive-level; horizontal-stretch: 1; }
                            }
                            if root.archive-format != 2 || root.archive-tar-compression != 0 : Text { text: Strings.archive-level-hint; color: Theme.foreground.with-alpha(0.65); font-size: 11px; wrap: word-wrap; }
                            CheckBox {
                                text: Strings.archive-password-toggle;
                                checked <=> root.archive-use-password;
                                enabled: root.archive-format != 2;
                            }
                            if root.archive-format == 2 : Text {
                                text: Strings.archive-tar-hint;
                                color: Theme.foreground.with-alpha(0.65);
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                        if root.archive-password-only || (root.archive-use-password && root.archive-format != 2) : VerticalLayout {
                            spacing: 8px;
                            Text { text: Strings.archive-password; color: Theme.foreground; }
                            archive-password-edit := LineEdit {
                                text <=> root.archive-password;
                                input-type: password;
                                accepted => { root.archive-submit(); }
                            }
                            Timer {
                                interval: 1ms;
                                running: root.archive-password-only && root.archive-focus-armed && !root.exit-warning-open;
                                triggered => { archive-password-edit.focus(); root.archive-focus-armed = false; }
                            }
                            if !root.archive-password-only : VerticalLayout {
                                spacing: 8px;
                                Text { text: Strings.archive-confirm-password; color: Theme.foreground; }
                                LineEdit { text <=> root.archive-confirm-password; input-type: password; accepted => { root.archive-submit(); } }
                            }
                        }
                        if root.archive-password-only : Text {
                            text: Strings.archive-password-hint;
                            color: Theme.foreground.with-alpha(0.65);
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if root.archive-error != "" : Text {
                            text: root.archive-error;
                            color: Tokens.danger;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
                archive-footer := HorizontalBox {
                    padding: 18px;
                    Button { text: Strings.btn-cancel; clicked => { root.archive-cancel(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.archive-password-only ? Strings.archive-extract : Strings.archive-create;
                        primary: true;
                        enabled: root.archive-password-only ? root.archive-password != "" : (root.archive-name != "" && (!root.archive-use-password || root.archive-password != ""));
                        clicked => { root.archive-submit(); }
                    }
                }
            }
        }

        if root.exit-warning-open : ModalBackdrop { }
        if root.exit-warning-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(640px, parent.width - 36px);
            height: 210px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow.with-alpha(0.35);
            TouchArea { scroll-event(ev) => { return accept; } }
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: Strings.exit-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
                Text {
                    text: root.exit-stopping ? Strings.exit-stopping : Strings.exit-body;
                    color: Theme.foreground.with-alpha(0.8);
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    WsButton {
                        label: Strings.exit-stay;
                        primary: root.exit-choice == 0 || root.exit-stopping;
                        clicked => { root.exit-stay(); }
                    }
                    if !root.exit-stopping : WsButton {
                        label: root.exit-confirm ? Strings.exit-confirm : Strings.exit-cancel;
                        danger: true;
                        background: root.exit-confirm ? Tokens.danger.with-alpha(0.20) : transparent;
                        border-color: root.exit-choice == 1 ? Theme.accent-background : Tokens.danger.with-alpha(0.4);
                        clicked => { root.exit-cancel-operations(); }
                    }
                }
            }
        }

        // ===== GLOBAL tooltip — rendered VERY LAST → above
        // everything (panels, popups). Position set by the hovered button (global Tip).
        if Tip.text != "" : tooltip-bubble := Rectangle {
            x: clamp(Tip.x, 4px, max(4px, parent.width - self.width - 4px));
            y: clamp(Tip.y, 4px, max(4px, parent.height - self.height - 4px));
            width: min(gtip.preferred-width + 14px, 520px, max(1px, parent.width - 8px));
            height: max(24px, gtip.preferred-height + 10px);
            background: Theme.tooltip-background;
            border-radius: 4px;
            drop-shadow-blur: 6px;
            drop-shadow-color: Theme.shadow.with-alpha(0.4);
            gtip := Text {
                x: 7px;
                y: (tooltip-bubble.height - self.height) / 2;
                width: max(1px, tooltip-bubble.width - 14px);
                height: self.preferred-height;
                text: Tip.text;
                font-size: 11px;
                color: Theme.tooltip-foreground;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

    }
}
