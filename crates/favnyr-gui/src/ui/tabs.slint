// Tab bar items, the scroll buttons of the horizontal strip and the vertical
// tab bar.

import { TabInfo } from "types.slint";
import { Dismiss, Tip } from "globals.slint";
import { Theme, Tokens } from "theme.slint";

// Mini chevron scroll button for the tab bar. Same idiom as the "+"
// button (24x26, no border, hover = alternate-background), greyed out at the
// end (opacity 0.35). Press = tokens of the ACTIVE tab (accent). Tooltip via the global Tip.
export component TabScrollButton inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip-text;
    in property <bool> enabled: true;
    width: 24px;
    height: 26px;
    border-radius: 5px;
    opacity: root.enabled ? 1.0 : 0.35;
    background: !root.enabled
        ? transparent
        : (tsb-touch.pressed
            ? Theme.accent-background.with-alpha(0.22)
            : (tsb-touch.has-hover ? Theme.alternate-background : transparent));
    border-width: 1px;
    border-color: (root.enabled && tsb-touch.pressed)
        ? Theme.accent-background.with-alpha(0.55)
        : transparent;
    Image {
        source: root.icon;
        width: 12px;
        height: 12px;
        colorize: Theme.foreground.with-alpha((tsb-touch.has-hover && root.enabled) ? 1.0 : 0.75);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    tsb-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Dismiss.serial += 1; root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip-text != "") {
                Tip.text = root.tooltip-text;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + root.height + 4px;
            } else if (Tip.text == root.tooltip-text) {
                Tip.text = "";
            }
        }
    }
}

export component TabGesture inherits Rectangle {
    in property <string> tip-path;
    out property <bool> hovered: touch.has-hover;
    callback clicked(int);
    callback close-clicked();
    callback right-clicked(length, length);
    callback drag-progress(length, length, length);
    callback drag-completed(length, length, length);

    property <length> ds-x;
    property <length> ds-y;
    out property <bool> dragging: false;
    property <bool> gesture-moved: false;
    property <bool> gesture-cancelled: false;
    property <int> down-modifiers;
    in property <bool> tab-drag-active: false;
    changed tab-drag-active => {
        if (!root.tab-drag-active && root.dragging) {
            root.gesture-cancelled = true;
            root.dragging = false;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                Dismiss.serial += 1;
                root.ds-x = self.absolute-position.x + self.mouse-x;
                root.ds-y = self.absolute-position.y + self.mouse-y;
                root.dragging = false;
                root.gesture-moved = false;
                root.gesture-cancelled = false;
                root.down-modifiers = (event.modifiers.control ? 1 : 0) + (event.modifiers.shift ? 2 : 0);
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                if (root.dragging) {
                    root.drag-completed(self.absolute-position.x + self.mouse-x - root.ds-x,
                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    root.dragging = false;
                } else if (!root.gesture-moved && !root.gesture-cancelled) {
                    root.clicked(root.down-modifiers);
                }
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                root.close-clicked();
            }
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            if (self.pressed && !root.dragging && !root.gesture-cancelled
                && (abs(self.absolute-position.x + self.mouse-x - root.ds-x) > 6px
                    || abs(self.absolute-position.y + self.mouse-y - root.ds-y) > 6px)) {
                root.gesture-moved = true;
                root.dragging = root.down-modifiers == 0;
            }
            if (self.pressed && root.dragging) {
                Tip.text = "";
                root.drag-progress(self.absolute-position.x + self.mouse-x - root.ds-x,
                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        changed has-hover => {
            if (self.has-hover && root.tip-path != "" && !root.dragging) {
                Tip.text = root.tip-path;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + root.height + 4px;
            } else if (Tip.text == root.tip-path) {
                Tip.text = "";
            }
        }
    }
}

export component TabItem inherits Rectangle {
    callback clicked(int);
    callback close-clicked();
    callback right-clicked(length, length);
    callback drag-progress(length, length, length);
    callback drag-completed(length, length, length);
    in property <string> title;
    in property <int> folder-slot;
    property <color> tone: root.folder-slot > 0 ? Tokens.folder-color(root.folder-slot) : Theme.accent-background;
    in property <bool> active: false;
    in property <bool> selection-marked: false;
    in property <string> tip-path;
    in property <bool> vertical: false;
    in property <length> cross-len: 120px;
    in property <bool> indicator-right: true;
    in property <length> tab-width: 120px;
    in property <bool> tab-drag-active: false;
    height: root.vertical ? root.tab-width : 26px;
    width: root.vertical ? root.cross-len : root.tab-width;
    border-radius: 5px;
    opacity: gesture.dragging ? 0.5 : 1;
    background: root.active ? root.tone.with-alpha(0.22)
        : root.selection-marked ? Theme.accent-background.with-alpha(0.14)
        : root.folder-slot > 0 ? root.tone.with-alpha(gesture.hovered ? 0.14 : 0.07)
        : gesture.hovered ? Theme.foreground.with-alpha(0.06) : transparent;
    border-width: 1px;
    border-color: root.active ? root.tone.with-alpha(0.55)
        : root.selection-marked ? Theme.accent-background.with-alpha(0.75)
        : root.folder-slot > 0 ? root.tone.with-alpha(gesture.hovered ? 0.40 : 0.25)
        : Theme.foreground.with-alpha(gesture.hovered ? 0.30 : 0.18);
    gesture := TabGesture {
        tip-path: root.tip-path;
        tab-drag-active: root.tab-drag-active;
        clicked(m) => { root.clicked(m); }
        close-clicked => { root.close-clicked(); }
        right-clicked(x, y) => { root.right-clicked(x, y); }
        drag-progress(d, x, y) => { root.drag-progress(d, x, y); }
        drag-completed(d, x, y) => { root.drag-completed(d, x, y); }
    }

    // In vertical orientation, a 2px accent bar marks the active tab
    // on the inner edge, content side.
    if root.vertical && root.active : Rectangle {
        x: root.indicator-right ? parent.width - 2px : 0;
        y: 3px;
        width: 2px;
        height: parent.height - 6px;
        border-radius: 1px;
        background: root.tone;
    }

    // The underline distinguishes selection from the active tab's outline.
    // Ordinary navigation keeps its original appearance. In the horizontal
    // strip it runs above the title rather than below it: the bottom edge
    // carries a group's attachment rail there, and two near-parallel lines of
    // unrelated meaning would be read as one. A vertical bar stacks its
    // entries, so its rail runs in the side gutter and leaves the edge free.
    if root.selection-marked : Rectangle {
        x: 10px;
        y: root.vertical ? parent.height - 3px : 2px;
        width: max(0px, parent.width - 36px);
        height: 1px;
        background: Theme.accent-background;
    }

    // Title and close-button zone, above the root touch area.
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;
        Text {
            text: root.title;
            font-size: 11px;
            color: root.folder-slot > 0 ? root.tone : Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // Space reserved for the close button — the real button is a sibling
        // (absolutely positioned) so it properly captures clicks.
        Rectangle { width: 18px; }
    }

    // Close button: sibling of touch, declared AFTER so it's topmost.
    Rectangle {
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        // Hover: subtle red — consistent with the "x" in the Settings panel.
        background: close-touch.has-hover ? Tokens.danger.with-alpha(0.27) : transparent;
        Image {
            source: @image-url("../../assets/icons/close.svg");
            width: 11px;
            height: 11px;
            colorize: close-touch.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-touch := TouchArea {
            clicked => { Dismiss.serial += 1; root.close-clicked(); }
        }
    }
}

// End cap of a group's attachment rail. It grows out of the rail
// perpendicularly, so both ends of a group are stated by one geometry whichever
// axis the bar runs along.
component GroupRailFoot inherits Rectangle {
    in property <bool> vertical;
    in property <length> along;    // position along the bar's axis
    in property <length> across;   // position across it, at the rail
    x: root.vertical ? root.across : root.along;
    y: root.vertical ? root.along : root.across;
    width: root.vertical ? 6px : 2px;
    height: root.vertical ? 2px : 6px;
}

// One visible entry, shared by the horizontal and both vertical bars.
export component TabBarEntry inherits Rectangle {
    in property <TabInfo> entry;
    in property <bool> vertical;
    in property <length> cross-len: 120px;
    in property <bool> indicator-right: true;
    in property <int> active-index;
    in property <bool> show-tooltip;
    in property <bool> tab-drag-active;
    callback clicked(int, int);
    callback closed(int);
    callback context(int, length, length);
    callback drag-progress(int, string, length, length);
    callback drag-completed(int, length, length);
    callback group-toggle(string);
    callback group-clicked(string, int);
    callback group-context(string, length, length);
    width: root.vertical ? root.cross-len : root.entry.width;
    height: root.vertical ? root.entry.width : 26px;
    property <color> tone: root.entry.group-slot > 0
        ? Tokens.folder-color(root.entry.group-slot) : Theme.foreground;
    // Ink for text drawn on an opaque block of `tone`. The palette pairs each
    // slot with a foreground proven legible on it; an unslotted group falls
    // back to the theme's own background, the foreground's natural counterpart.
    property <color> ink: root.entry.group-slot > 0
        ? Tokens.folder-ink(root.entry.group-slot) : Theme.background;
    // Boundary gaps are reserved inside the entry's extent, so the content box
    // is shorter than the slot the bar's layout gives it.
    property <length> lead: root.entry.pad-lead;
    property <length> main-len: root.entry.width - root.lead - root.entry.pad-trail;
    // The rail hugs the bar's outer edge, opposite the active-tab indicator, so
    // a bar docked on the right mirrors both instead of stacking two saturated
    // stripes a few pixels apart.
    property <bool> rail-lead: root.indicator-right;
    // Cross-axis position of the rail, shared with the feet that cap it.
    property <length> rail-across: root.vertical
        ? (root.rail-lead ? 2px : root.width - 8px) : root.height - 6px;
    // A group is set in from the ungrouped tabs around it, which frees the
    // gutter the rail runs in. The horizontal strip has no room to indent.
    property <length> indent: (root.vertical && root.entry.grouped) ? 8px : 0px;
    // Content box, inside the boundary gaps and the indent. A header and a
    // member share it, so neither can drift from the other when the bar is
    // docked on the opposite side.
    property <length> inset-x: root.vertical ? (root.rail-lead ? root.indent : 0px) : root.lead;
    property <length> inset-y: root.vertical ? root.lead : 0px;
    property <length> cross-box: root.width - root.indent;
    if !root.entry.is-group : TabItem {
        x: root.inset-x;
        y: root.inset-y;
        cross-len: root.cross-box;
        vertical: root.vertical;
        indicator-right: root.indicator-right;
        tab-width: root.main-len;
        title: root.entry.title;
        folder-slot: root.entry.folder-slot;
        tip-path: root.show-tooltip ? root.entry.path : "";
        active: root.entry.index == root.active-index;
        selection-marked: root.entry.selection-marked;
        tab-drag-active: root.tab-drag-active;
        clicked(m) => { root.clicked(root.entry.index, m); }
        close-clicked => { root.closed(root.entry.index); }
        right-clicked(x, y) => { root.context(root.entry.index, x, y); }
        drag-progress(d, x, y) => { root.drag-progress(root.entry.index, "", x, y); }
        drag-completed(d, x, y) => { root.drag-completed(root.entry.index, x, y); }
    }
    if root.entry.is-group : Rectangle {
        x: root.inset-x;
        y: root.inset-y;
        width: root.vertical ? root.cross-box : root.main-len;
        height: root.vertical ? root.main-len : root.height;
        border-radius: 5px;
        background: root.entry.selection-marked ? Theme.accent-background.with-alpha(0.14)
            : root.tone.with-alpha(header-touch.hovered ? 0.16 : 0.08);
        opacity: header-touch.dragging ? 0.5 : 1;
        // The targeted group is independent of folding and keyboard focus.
        border-width: root.entry.group-highlighted || root.entry.selection-marked ? 1px : 0px;
        border-color: Theme.accent-background;
        if root.entry.selection-marked : Rectangle {
            x: 26px;
            y: root.vertical ? parent.height - 3px : 2px;
            width: max(0px, parent.width - 36px);
            height: 1px;
            background: Theme.accent-background;
        }
        // Name and tab count. The chip is a freely positioned sibling, as the
        // close button is on a tab, so the leading padding reserves its room.
        HorizontalLayout {
            padding-left: 26px; padding-right: 8px; spacing: 5px;
            Text { text: root.entry.title; font-size: 11px; color: root.tone;
                vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.entry.count; font-size: 10px; color: root.tone.with-alpha(0.7);
                vertical-alignment: center; }
        }
        // The one opaque fill of the whole bar. Every tab state is a
        // translucent wash, so a solid block of colour means "group" on its
        // own, whichever slot the group carries and even when it carries none.
        Rectangle {
            x: 4px;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            border-radius: 4px;
            background: root.tone;
            // Expanded, the chevron points along the bar at the members that
            // follow the header on that axis; collapsed, it points across the
            // bar instead. The glyph therefore follows the bar's orientation,
            // as the members themselves do, which is why the two mappings below
            // are mirrored rather than shared.
            Image {
                source: root.vertical
                    ? (root.entry.collapsed
                        ? @image-url("../../assets/icons/chevron-right.svg")
                        : @image-url("../../assets/icons/chevron-down.svg"))
                    : (root.entry.collapsed
                        ? @image-url("../../assets/icons/chevron-down.svg")
                        : @image-url("../../assets/icons/chevron-right.svg"));
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 11px;
                height: 11px;
                colorize: root.ink;
            }
        }
        header-focus := FocusScope {
            accessible-role: button;
            accessible-label: root.entry.title;
            accessible-action-default => { root.group-toggle(root.entry.group-id); }
            key-pressed(event) => {
                // A cleared visual target must not keep handling group keys
                // through a focus scope retained by the stable repeater.
                if (!root.entry.group-highlighted) { return reject; }
                if (event.text == " " || event.text == Key.Return) {
                    root.group-toggle(root.entry.group-id); return accept;
                }
                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                    root.group-context(root.entry.group-id, root.absolute-position.x,
                        root.absolute-position.y + root.height); return accept;
                }
                return reject;
            }
        }
        header-touch := TabGesture {
            tip-path: root.show-tooltip ? root.entry.title : "";
            tab-drag-active: root.tab-drag-active;
            clicked(m) => {
                if (m == 0) {
                    header-focus.focus();
                    root.group-toggle(root.entry.group-id);
                } else {
                    root.group-clicked(root.entry.group-id, m);
                }
            }
            right-clicked(x, y) => { root.group-context(root.entry.group-id, x, y); }
            drag-progress(d, x, y) => { root.drag-progress(-1, root.entry.group-id, x, y); }
            drag-completed(d, x, y) => { root.drag-completed(-1, x, y); }
        }
    }

    // Attachment rail, declared last so it reads over the outlines it joins.
    // Each entry of a group draws only its own stretch and overhangs the pitch
    // that separates it from the next one, so consecutive stretches meet and
    // the line stays unbroken without any entry knowing the group's extent.
    // The overhang stops at the group's two ends, where a foot closes the rail.
    if root.entry.grouped : Rectangle {
        // Overhang into the pitch, dropped at whichever end a foot closes.
        property <length> ahead: root.entry.is-group ? 0px : 1px;
        property <length> behind: root.entry.rail-tail ? 0px : 1px;
        x: root.vertical
            ? (root.rail-lead ? 2px : root.width - 4px)
            : root.lead - self.ahead;
        y: root.vertical ? root.lead - self.ahead : root.height - 2px;
        width: root.vertical ? 2px : root.main-len + self.ahead + self.behind;
        height: root.vertical ? root.main-len + self.ahead + self.behind : 2px;
        background: root.tone.with-alpha(0.85);
    }
    // Feet turn the rail into a bracket: they say where the group starts and
    // where it ends, which two groups of neighbouring hues cannot otherwise
    // show. A collapsed group reduced to its header carries both.
    if root.entry.is-group : GroupRailFoot {
        vertical: root.vertical;
        across: root.rail-across;
        along: root.lead;
        background: root.tone.with-alpha(0.85);
    }
    if root.entry.rail-tail : GroupRailFoot {
        vertical: root.vertical;
        across: root.rail-across;
        along: root.lead + root.main-len - 2px;
        background: root.tone.with-alpha(0.85);
    }
}

// Both vertical bars remain instantiated so their scroll positions can be read
// without conditional element references. Only the active side has a width.
export component VTabBar inherits Rectangle {
    in property <[TabInfo]> tabs;
    in property <int> active-tab-idx;
    in property <bool> on-left;            // bar on the left → active indicator on the right
    in property <bool> overlay-open;
    in property <bool> tab-drag-active: false;   // forwarded to the tabs
    in property <string> new-tab-tooltip;
    in property <bool> show-tooltip: false;   // tab path tooltip (opt-in)
    // Tab drag: cursor presence within this bar and Y coordinate within
    // the content, computed by the PanelComponent without depending on the layout cache.
    in property <bool> reorder-here;
    in property <length> cursor-in-bar-y;  // VISIBLE Y cursor (auto-scroll at edges)
    // Insertion preview (claimed gap, content-relative position).
    in property <int> preview-idx: -1;
    in property <length> preview-pos;
    // Current scroll (content-y ≤ 0) — read by the PanelComponent to
    // convert the drag cursor to a content-relative position (PLAIN read).
    out property <length> vp-y: flick.content-y;
    callback group-toggle(string);
    callback group-clicked(string, int);
    callback group-context(string, length, length);
    callback tab-clicked(int, int);
    callback tab-closed(int);
    callback tab-context(int, length, length);
    callback tab-drag-progress(int, string, length, length);
    callback tab-drag-completed(int, length, length);
    callback tab-new();
    callback bar-clicked();                // click on empty area → activate the panel
    callback bar-context(length, length);  // right-click on empty area (absolute position)
    callback wheel(bool /*fwd*/);          // wheel → next/previous tab
    callback scrolled(length);             // content-y reported to the bridge
    callback scroll-target(int, bool, length, length) -> length;

    // Reveals tab `idx` (scroll-into-view) — same bridge target as the
    // horizontal chevrons (exact geometry, no arbitrary jump).
    public function reveal(idx: int) {
        flick.content-y = root.scroll-target(idx, true, flick.content-y, flick.height);
    }

    property <bool> can-scroll-up: flick.content-y < -0.5px;
    property <bool> can-scroll-down:
        flick.content-y > flick.height - flick.content-height + 0.5px;

    background: Theme.toolbar;
    border-radius: Tokens.radius-row;

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        // ----- Fixed header: new tab, stable target always visible. -----
        Rectangle {
            height: 24px;
            border-radius: 5px;
            background: vnew-touch.has-hover ? Theme.alternate-background : transparent;
            Image {
                source: @image-url("../../assets/icons/plus.svg");
                width: 13px;
                height: 13px;
                colorize: Theme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            vnew-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.bar-clicked(); root.tab-new(); }
                changed has-hover => {
                    if (self.has-hover && root.new-tab-tooltip != "") {
                        Tip.text = root.new-tab-tooltip;
                        // CONTENT side (doesn't hide the list while scanning).
                        Tip.x = root.on-left
                            ? self.absolute-position.x + root.width + 4px
                            : self.absolute-position.x - 120px;
                        Tip.y = self.absolute-position.y;
                    } else if (Tip.text == root.new-tab-tooltip) {
                        Tip.text = "";
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }

        // ----- Tab list (vertical scrolling) -----
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Wheel + clicks on empty area — BELOW the TabItems (declared before).
            vwheel := TouchArea {
                clicked => { root.bar-clicked(); }
                double-clicked => { root.bar-clicked(); root.tab-new(); }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.right) {
                        root.bar-context(
                            self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    }
                }
                scroll-event(ev) => {
                    if (root.overlay-open) { return accept; }
                    if (ev.delta-y < 0 || ev.delta-x < 0) { root.wheel(true); return accept; }
                    if (ev.delta-y > 0 || ev.delta-x > 0) { root.wheel(false); return accept; }
                    return reject;
                }
            }

            flick := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: max(self.height, vtabs-col.preferred-height);
                interactive: false;
                animate content-y { duration: 120ms; easing: ease-out; }
                changed content-y => { root.scrolled(self.content-y); }

                vtabs-col := VerticalLayout {
                    spacing: 2px;               // MUST == VTAB_SPACING (bridge)
                    alignment: start;
                    for tab in root.tabs : TabBarEntry {
                        entry: tab;
                        vertical: true;
                        cross-len: root.width - 8px;
                        indicator-right: root.on-left;
                        active-index: root.active-tab-idx;
                        show-tooltip: root.show-tooltip;
                        tab-drag-active: root.tab-drag-active;
                        clicked(i, m) => { root.tab-clicked(i, m); }
                        closed(i) => { root.tab-closed(i); }
                        context(i, x, y) => { root.tab-context(i, x, y); }
                        drag-progress(i, group, x, y) => { root.tab-drag-progress(i, group, x, y); }
                        drag-completed(i, x, y) => { root.tab-drag-completed(i, x, y); }
                        group-toggle(id) => { root.group-toggle(id); }
                        group-clicked(id, m) => { root.group-clicked(id, m); }
                        group-context(id, x, y) => { root.group-context(id, x, y); }
                    }
                    // Bottom clearance: the last tab (and its close button) escapes
                    // the fade (vertical equivalent of the `tab-cluster-w` spacer).
                    Rectangle { height: 8px; }
                }
                // Drop preview line — HORIZONTAL between two tabs, as an
                // out-of-layout overlay (Flickable content-relative position).
                if root.preview-idx >= 0 : Rectangle {
                    x: 2px;
                    y: root.preview-pos - 1px;
                    width: parent.width - 4px;
                    height: 2px;
                    background: Theme.accent-background;
                }
            }
            // Top/bottom overflow fades — WITHOUT a TouchArea (wheel and clicks
            // pass through), fading toward the bar's actual color.
            if root.can-scroll-up : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: 20px;
                background: @linear-gradient(180deg,
                    Theme.toolbar 0%, Theme.toolbar.with-alpha(0.0) 100%);
            }
            if root.can-scroll-down : Rectangle {
                x: 0; y: parent.height - self.height;
                width: parent.width;
                height: 20px;
                background: @linear-gradient(0deg,
                    Theme.toolbar 0%, Theme.toolbar.with-alpha(0.0) 100%);
            }
            // Auto-scroll during a reorder drag near the
            // edges. The panel recomputes its gap from the new content offset.
            Timer {
                interval: 16ms;
                running: root.reorder-here
                    && flick.content-height > flick.height + 0.5px;
                triggered => {
                    if (root.cursor-in-bar-y < 28px && root.can-scroll-up) {
                        flick.content-y = min(0px, flick.content-y + 12px);
                    } else if (root.cursor-in-bar-y > flick.height - 12px && root.can-scroll-down) {
                        flick.content-y = max(
                            flick.height - flick.content-height,
                            flick.content-y - 12px);
                    }
                }
            }

            // ----- Overlaid mini-scrollbar for free scrolling -----
            // Revealed on hover when the list overflows; 4px track on the right
            // edge (scrollbar convention). Grabbable anywhere on the track:
            // the thumb's center follows the mouse.
            sb := Rectangle {
                x: parent.width - 5px;
                y: 0;
                width: 4px;
                height: parent.height;
                property <bool> show: flick.content-height > flick.height + 0.5px
                    && (vwheel.has-hover || sbt.has-hover || sbt.pressed);
                opacity: self.show ? 1.0 : 0.0;
                animate opacity { duration: 120ms; easing: ease-out; }
                property <length> thumb-h: max(24px,
                    flick.height * flick.height / max(1px, flick.content-height));
                property <length> thumb-y: (flick.height - self.thumb-h)
                    * (-flick.content-y)
                    / max(1px, flick.content-height - flick.height);
                Rectangle {
                    x: 0;
                    y: sb.thumb-y;
                    width: parent.width;
                    height: sb.thumb-h;
                    border-radius: 2px;
                    background: Theme.foreground.with-alpha(sbt.pressed ? 0.55 : 0.35);
                }
                // Widened hit area (10px) around the 4px track.
                sbt := TouchArea {
                    x: -3px;
                    width: 10px;
                    enabled: flick.content-height > flick.height + 0.5px;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down
                                && ev.button == PointerEventButton.left) {
                            flick.content-y = -clamp(
                                (self.mouse-y - sb.thumb-h / 2) / max(1px, flick.height - sb.thumb-h),
                                0, 1) * (flick.content-height - flick.height);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            flick.content-y = -clamp(
                                (self.mouse-y - sb.thumb-h / 2) / max(1px, flick.height - sb.thumb-h),
                                0, 1) * (flick.content-height - flick.height);
                        }
                    }
                }
            }
        }
    }

    // Resize grip on the inner edge.
    // 7px band straddling the content-side edge. The PanelComponent receives
    // the mouse's absolute position and recomputes the width (shared clamp).
    callback grip-moved(length /*abs-x*/);
    callback grip-done();
    grip := TouchArea {
        x: root.on-left ? root.width - 3px : -4px;
        y: 0;
        width: 7px;
        height: root.height;
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                root.grip-moved(self.absolute-position.x + self.mouse-x);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up
                    && ev.button == PointerEventButton.left) {
                root.grip-done();
            }
        }
    }
    // Affordance: accent thread on the inner edge on grip hover/drag.
    if grip.has-hover || grip.pressed : Rectangle {
        x: root.on-left ? root.width - 2px : 0;
        y: 0;
        width: 2px;
        height: root.height;
        background: Theme.accent-background.with-alpha(0.7);
    }
}
